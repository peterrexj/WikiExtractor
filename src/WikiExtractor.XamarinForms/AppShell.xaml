    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid
                x:Name="FlyoutItemLayout"
                ColumnSpacing="{x:OnPlatform UWP=0}"
                HeightRequest="{x:OnPlatform Android=50, iOS=30, UWP=50}"
                RowSpacing="{x:OnPlatform UWP=0}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.05*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    x:Name="FlyoutItemImage"
                    HeightRequest="{x:OnPlatform Android=24,
                                                 iOS=22,
                                                 UWP=16}"
                    HorizontalOptions="{x:OnPlatform Default=Center,
                                                     UWP=Start}"
                    Source="{Binding FlyoutIcon}"
                    VerticalOptions="Center"
                    WidthRequest="{x:OnPlatform Android=24,
                                                iOS=22,
                                                UWP=16}">
                    <Image.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <OnPlatform.Platforms>
                                <On Platform="UWP" Value="12,0,12,0" />
                            </OnPlatform.Platforms>
                        </OnPlatform>
                    </Image.Margin>
                </Image>
                <Label
                    x:Name="FlyoutItemLabel"
                    Grid.Column="1"
                    FontAttributes="{x:OnPlatform iOS=Bold}"
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                           Tablet=16},
                                          iOS={OnIdiom Phone=12,
                                                       Tablet=16},
                                          UWP={OnIdiom Phone=12,
                                                       Default=16},
                                          macOS=16,
                                          WPF=16}"
                    HorizontalOptions="{x:OnPlatform UWP=Start}"
                    HorizontalTextAlignment="{x:OnPlatform UWP=Start}"
                    Text="{Binding Title}"
                    TextColor="{DynamicResource AppShellFlyoutItemLabelFontColor}"
                    VerticalTextAlignment="Center">
                    <Label.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <OnPlatform.Platforms>
                                <On Platform="Android" Value="10, 0, 1, 0" />
                            </OnPlatform.Platforms>
                        </OnPlatform>
                    </Label.Margin>
                </Label>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{x:OnPlatform UWP=Transparent, iOS=White}" />
                                    <Setter TargetName="FlyoutItemLabel" Property="Label.TextColor" Value="{DynamicResource AppShellTitleFontColor}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AppShellFlyoutItemSelectedBackgroundColor}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutFooter>
        <Grid>
            <sfGradient:SfGradientView>
                <sfGradient:SfGradientView.BackgroundBrush>
                    <sfGradient:SfLinearGradientBrush>
                        <sfGradient:SfLinearGradientBrush.GradientStops>
                            <sfGradient:SfGradientStop Offset="0.3" Color="{DynamicResource AppShellFooterGradientStart}" />
                            <sfGradient:SfGradientStop Offset="0.7" Color="{DynamicResource AppShellFooterGradientEnd}" />
                            <sfGradient:SfGradientStop Offset="0.9" Color="{DynamicResource AppShellFooterGradientStart}" />
                        </sfGradient:SfLinearGradientBrush.GradientStops>
                    </sfGradient:SfLinearGradientBrush>
                </sfGradient:SfGradientView.BackgroundBrush>
            </sfGradient:SfGradientView>
            <Label
                Margin="5"
                FontAttributes="Italic,Bold"
                FontFamily="{DynamicResource DefaultFontFamily}"
                FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                       Tablet=16},
                                      iOS={OnIdiom Phone=12,
                                                   Tablet=16},
                                      UWP=16,
                                      macOS=10,
                                      WPF=10}"
                HorizontalOptions="Center"
                Text="Powered By Wikipedia"
                TextColor="{DynamicResource AppShellFlyoutItemLabelFontColor}" />
        </Grid>
    </Shell.FlyoutFooter>

    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="{DynamicResource AppShellBackgroundColor}" />
                <Setter Property="Shell.ForegroundColor" Value="{DynamicResource AppShellForegroundIconColor}" />
                <Setter Property="Shell.TitleColor" Value="{DynamicResource AppShellTitleFontColor}" />
                <!--<Setter Property="Shell.DisabledColor" Value="GreenYellow" />
                <Setter Property="Shell.UnselectedColor" Value="Transparent" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="Transparent" />
                <Setter Property="Shell.TabBarForegroundColor" Value="HotPink" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="Transparent" />
                <Setter Property="Shell.TabBarTitleColor" Value="Purple" />-->

            </Style>
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="TabBar" />
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="FlyoutItem" />

            <!--
                Default Styles for all Flyout Items
                https://docs.microsoft.com/xamarin/xamarin-forms/app-fundamentals/shell/flyout#flyoutitem-and-menuitem-style-classes
            -->
