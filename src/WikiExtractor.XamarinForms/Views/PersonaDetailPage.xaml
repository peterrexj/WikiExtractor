<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GeneralInformation.Views.PersonaDetailPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:admob="clr-namespace:MarcTron.Plugin.Controls;assembly=Plugin.MtAdmob"
    xmlns:carousel="clr-namespace:Syncfusion.SfCarousel.XForms;assembly=Syncfusion.SfCarousel.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:local="clr-namespace:GeneralInformation"
    xmlns:localControls="clr-namespace:WikiExtractor.XamarinForms.Controls"
    xmlns:magic="clr-namespace:MagicGradients;assembly=MagicGradients"
    xmlns:sfBorder="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:sfButtons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:sfEffectsView="clr-namespace:Syncfusion.XForms.EffectsView;assembly=Syncfusion.Core.XForms"
    xmlns:sfPopup="clr-namespace:Syncfusion.XForms.PopupLayout;assembly=Syncfusion.SfPopupLayout.XForms"
    xmlns:syncfusionList="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
    ios:Page.UseSafeArea="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <localControls:ItemDetailListTemplateSelector x:Key="ItemDetailListTemplateSelector" />
            <localControls:Header2ListItemTemplate x:Key="Header2ListItemTemplate" />
            <localControls:Header3ListItemTemplate x:Key="Header3ListItemTemplate" />
            <localControls:ParagraphContentListItemTemplate x:Key="ParagraphContentListItemTemplate" />
            <localControls:ImageListItemTemplate x:Key="ImageListItemTemplate" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Shell.TitleView>
        <FlexLayout>
            <Grid>
                <!--  Margin="6,5,6,2"  -->
                <sfBorder:SfBorder
                    BorderColor="{Binding DefaultStyle.SubPageTopHeaderBoxBorderColor, Converter={StaticResource stringToColorConverter}}"
                    BorderWidth="1"
                    CornerRadius="3"
                    HeightRequest="70">
                    <Grid>
                        <magic:GradientView GradientSource="{Binding DefaultStyle.SubPageTopHeaderBoxBorderBgSource}" VerticalOptions="FillAndExpand" />
                        <StackLayout>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=20*, Tablet=5*}, iOS={OnIdiom Phone=15*, Tablet=5*}, UWP=20*, macOS=5*, WPF=auto}" />
                                    <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=85*, Tablet=95*}, iOS={OnIdiom Phone=85*, Tablet=95*}, UWP=85*, macOS=*, WPF=*}" />
                                </Grid.ColumnDefinitions>
                                <local:ExtendedImage
                                    x:Name="imgPrimary"
                                    Grid.Column="0"
                                    Margin="2,2,2,2"
                                    Aspect="AspectFit"
                                    CustomSource="{Binding PicturePrimaryPath}"
                                    HorizontalOptions="Center"
                                    LocalFileName="{Binding PicturePrimaryLocalFileName}"
                                    VerticalOptions="Center" />

                                <StackLayout Grid.Column="1">
                                    <Label
                                        Padding="0,0,0,0"
                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                        HeightRequest="60"
                                        HorizontalTextAlignment="Start"
                                        LineBreakMode="WordWrap"
                                        TextColor="{Binding DefaultStyle.SubPageTopHeaderFontColor, Converter={StaticResource stringToColorConverter}}"
                                        VerticalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text=" " />
                                                <Span
                                                    FontAttributes="Bold"
                                                    FontFamily="{Binding DefaultStyle.DefaultFontFamilyBold}"
                                                    FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                           Tablet=28},
                                                                          iOS={OnIdiom Phone=18,
                                                                                       Tablet=26},
                                                                          UWP={OnIdiom Phone=20,
                                                                                       Tablet=28,
                                                                                       Desktop=28},
                                                                          macOS=28,
                                                                          WPF=28}"
                                                    Text="{Binding Persona.Name}" />
                                                <Span
                                                    FontAttributes="Bold"
                                                    FontFamily="{Binding DefaultStyle.DefaultFontFamilyBold}"
                                                    FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                           Tablet=16},
                                                                          iOS={OnIdiom Phone=12,
                                                                                       Tablet=16},
                                                                          UWP={OnIdiom Phone=12,
                                                                                       Tablet=16,
                                                                                       Desktop=16},
                                                                          macOS=16,
                                                                          WPF=16}"
                                                    Text="{Binding Persona.NameSubstitueFormatted}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                </StackLayout>
                                <StackLayout Grid.Column="1">
                                    <Label
                                        Margin="{OnPlatform Android='0,-3,8,0',
                                                            iOS='0,0,8,0'}"
                                        HorizontalTextAlignment="End"
                                        TextDecorations="Underline">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                    FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                           Tablet=14},
                                                                          iOS={OnIdiom Phone=12,
                                                                                       Tablet=14},
                                                                          UWP={OnIdiom Phone=14,
                                                                                       Tablet=14,
                                                                                       Desktop=14},
                                                                          macOS=14,
                                                                          WPF=14}"
                                                    Text="Wiki Source"
                                                    TextColor="{Binding DefaultStyle.SubPageTopHeaderWikiFontColor, Converter={StaticResource stringToColorConverter}}">
                                                    <Span.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TapHyperLinkToWikiPage}" CommandParameter="{Binding Persona.WikiPath}" />
                                                    </Span.GestureRecognizers>
                                                </Span>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Grid>
                </sfBorder:SfBorder>
            </Grid>
        </FlexLayout>
    </Shell.TitleView>
    <ContentPage.Content>
        <Grid>
            <sfPopup:SfPopupLayout
                x:Name="popupImageDisplay"
                Padding="{OnPlatform Android={OnIdiom Phone='10,25,10,20',
                                                      Tablet='25'},
                                     iOS={OnIdiom Phone='10,50,10,30',
                                                  Tablet='25,50,25,30'},
                                     UWP={OnIdiom Phone='10,25,10,20',
                                                  Tablet='25',
                                                  Desktop='25'},
                                     macOS='25',
                                     WPF='25'}"
                StaysOpen="True">
                <sfPopup:SfPopupLayout.PopupView>
                    <sfPopup:PopupView
                        AcceptButtonText="Close"
                        AnimationMode="Zoom"
                        AppearanceMode="OneButton"
                        ShowCloseButton="True">
                        <sfPopup:PopupView.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <magic:GradientView GradientSource="{Binding DefaultStyle.PopupHeaderBgSource}" VerticalOptions="FillAndExpand" />
                                    <Label
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=16,
                                                                               Tablet=24},
                                                              iOS={OnIdiom Phone=16,
                                                                           Tablet=24},
                                                              UWP={OnIdiom Phone=16,
                                                                           Tablet=24,
                                                                           Desktop=24},
                                                              macOS=24,
                                                              WPF=24}"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Persona.Name}"
                                        TextColor="{Binding DefaultStyle.SubPageTopHeaderFontColor, Converter={StaticResource stringToColorConverter}}"
                                        VerticalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </sfPopup:PopupView.HeaderTemplate>
                        <sfPopup:PopupView.FooterTemplate>
                            <DataTemplate>
                                <Grid>
                                    <magic:GradientView GradientSource="{Binding DefaultStyle.PopupFooterBgSource}" VerticalOptions="FillAndExpand" />
                                    <Button
                                        x:Name="btnCloseOnPopup"
                                        BackgroundColor="Transparent"
                                        Clicked="btnCloseOnPopup_Clicked"
                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=16,
                                                                               Tablet=24},
                                                              iOS={OnIdiom Phone=16,
                                                                           Tablet=24},
                                                              UWP={OnIdiom Phone=16,
                                                                           Tablet=24,
                                                                           Desktop=24},
                                                              macOS=24,
                                                              WPF=24}"
                                        Text="Close"
                                        TextColor="{Binding DefaultStyle.SubPageTopHeaderFontColor, Converter={StaticResource stringToColorConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </sfPopup:PopupView.FooterTemplate>
                        <sfPopup:PopupView.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <magic:GradientView GradientSource="{Binding DefaultStyle.PopupContentBgSource}" VerticalOptions="FillAndExpand" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="100" />
                                            <RowDefinition Height="50" />
                                        </Grid.RowDefinitions>
                                        <local:ExtendedImage
                                            Grid.Row="0"
                                            Margin="5"
                                            Aspect="AspectFit"
                                            PictureSource="{Binding PopupImage}" />
                                        <Label
                                            Grid.Row="1"
                                            BackgroundColor="Transparent"
                                            FontAttributes="Bold"
                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                            FontSize="{OnPlatform Android={OnIdiom Phone=16,
                                                                                   Tablet=24},
                                                                  iOS={OnIdiom Phone=16,
                                                                               Tablet=24},
                                                                  UWP={OnIdiom Phone=16,
                                                                               Tablet=24,
                                                                               Desktop=24},
                                                                  macOS=24,
                                                                  WPF=24}"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding PopupImage.PictureCaption}"
                                            TextColor="{Binding DefaultStyle.SubPageTopHeaderFontColor, Converter={StaticResource stringToColorConverter}}"
                                            VerticalTextAlignment="Center" />
                                        <StackLayout x:Name="stackBannerAdsOnPopup" Grid.Row="2">
                                            <admob:MTAdView
                                                AdsId="{Binding AdsBannerId}"
                                                HeightRequest="{OnPlatform Android={OnIdiom Phone=50,
                                                                                            Tablet=50},
                                                                           iOS={OnIdiom Phone=50,
                                                                                        Tablet=50}}"
                                                IsVisible="{OnPlatform Android=true,
                                                                       iOS=true,
                                                                       UWP=false,
                                                                       macOS=false,
                                                                       WPF=false}" />
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </sfPopup:PopupView.ContentTemplate>
                    </sfPopup:PopupView>
                </sfPopup:SfPopupLayout.PopupView>
            </sfPopup:SfPopupLayout>

            <magic:GradientView GradientSource="{Binding DefaultStyle.MgPageBgSource}" VerticalOptions="FillAndExpand" />

            <StackLayout>
                <StackLayout>
                    <tabView:SfTabView
                        x:Name="tabView"
                        TabHeaderBackgroundColor="Transparent"
                        VisibleHeaderCount="3">
                        <tabView:SfTabView.SelectionIndicatorSettings>
                            <tabView:SelectionIndicatorSettings
                                Position="Bottom"
                                StrokeThickness="10"
                                Color="{Binding DefaultStyle.TabStrokeColor, Converter={StaticResource stringToColorConverter}}" />
                        </tabView:SfTabView.SelectionIndicatorSettings>
                        <tabView:SfTabItem x:Name="tabUsefulInfo">
                            <tabView:SfTabItem.HeaderContent>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="90*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <magic:GradientView GradientSource="{Binding DefaultStyle.TabHeadBgSource}" VerticalOptions="FillAndExpand" />
                                    <Button
                                        Grid.Row="0"
                                        BackgroundColor="Transparent"
                                        Clicked="First_TabItem_Clicked"
                                        FontAttributes="Bold"
                                        FontFamily="{Binding DefaultStyle.DefaultFontFamilyBold}"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                               Tablet=14},
                                                              iOS={OnIdiom Phone=12,
                                                                           Tablet=14},
                                                              UWP={OnIdiom Phone=12,
                                                                           Tablet=14,
                                                                           Desktop=14},
                                                              macOS=14,
                                                              WPF=14}"
                                        Text="{Binding TextOnFirstTabInformationOnDetailPage}"
                                        TextColor="{Binding DefaultStyle.TabHeadTextColor, Converter={StaticResource stringToColorConverter}}" />
                                    <Button Grid.Row="1" BackgroundColor="Transparent" />
                                </Grid>
                            </tabView:SfTabItem.HeaderContent>
                            <tabView:SfTabItem.Content>
                                <StackLayout>
                                    <Grid
                                        Margin="0,0,15,0"
                                        HeightRequest="{OnPlatform Android={OnIdiom Phone=28,
                                                                                    Tablet=50},
                                                                   iOS={OnIdiom Phone=28,
                                                                                Tablet=50},
                                                                   UWP={OnIdiom Phone=28,
                                                                                Tablet=50,
                                                                                Desktop=50}}"
                                        HorizontalOptions="End">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsFree}" />
                                        <Label
                                            Grid.Column="1"
                                            Margin="0,0,10,0"
                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                            FontSize="14"
                                            HorizontalTextAlignment="Center"
                                            Text="Mark as Viewed"
                                            TextColor="{Binding DefaultStyle.DefaultFontColor, Converter={StaticResource stringToColorConverter}}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Start" />

                                        <sfButtons:SfSwitch
                                            x:Name="swtReadItem"
                                            Grid.Column="2"
                                            HorizontalOptions="End"
                                            IsOn="{Binding Persona.ItemReadStatus}"
                                            Orientation="Horizontal"
                                            StateChanged="swtReadItem_StateChanged"
                                            VisualType="Custom">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">

                                                    <VisualState x:Name="On">
                                                        <VisualState.Setters>
                                                            <Setter Property="SwitchSettings">
                                                                <Setter.Value>
                                                                    <sfButtons:DefaultSwitchSettings
                                                                        x:TypeArguments="sfButtons:OnState"
                                                                        BusyIndicatorColor="{Binding DefaultStyle.SwitchBusyIndicatorColorON, Converter={StaticResource stringToColorConverter}}"
                                                                        ThumbBorderColor="{Binding DefaultStyle.SwitchThumbBorderColorON, Converter={StaticResource stringToColorConverter}}"
                                                                        ThumbColor="{Binding DefaultStyle.SwitchThumbColorON, Converter={StaticResource stringToColorConverter}}"
                                                                        TrackBorderColor="{Binding DefaultStyle.SwitchTrackBorderColorON, Converter={StaticResource stringToColorConverter}}"
                                                                        TrackColor="{Binding DefaultStyle.SwitchTrackColorON, Converter={StaticResource stringToColorConverter}}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </VisualState.Setters>
                                                    </VisualState>

                                                    <VisualState x:Name="Off">
                                                        <VisualState.Setters>
                                                            <Setter Property="SwitchSettings">
                                                                <Setter.Value>
                                                                    <sfButtons:DefaultSwitchSettings
                                                                        x:TypeArguments="sfButtons:OffState"
                                                                        BusyIndicatorColor="{Binding DefaultStyle.SwitchBusyIndicatorColorOFF, Converter={StaticResource stringToColorConverter}}"
                                                                        ThumbBorderColor="{Binding DefaultStyle.SwitchThumbBorderColorOFF, Converter={StaticResource stringToColorConverter}}"
                                                                        ThumbColor="{Binding DefaultStyle.SwitchThumbColorOFF, Converter={StaticResource stringToColorConverter}}"
                                                                        TrackBorderColor="{Binding DefaultStyle.SwitchTrackBorderColorOFF, Converter={StaticResource stringToColorConverter}}"
                                                                        TrackColor="{Binding DefaultStyle.SwitchTrackColorOFF, Converter={StaticResource stringToColorConverter}}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </VisualState.Setters>
                                                    </VisualState>

                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </sfButtons:SfSwitch>
                                    </Grid>
                                    <syncfusionList:SfListView
                                        x:Name="lstSaints"
                                        AllowSwiping="True"
                                        AutoFitMode="DynamicHeight"
                                        BackgroundColor="Transparent"
                                        ItemsSource="{Binding Persona.Metadatas}"
                                        SelectionMode="None">
                                        <syncfusionList:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Frame
                                                    Margin="{OnPlatform Android={OnIdiom Phone='5,2,5,2',
                                                                                         Tablet='8,2,8,2'},
                                                                        iOS={OnIdiom Phone=2,
                                                                                     Tablet=5},
                                                                        UWP={OnIdiom Desktop='8,2,8,2',
                                                                                     Tablet='8,2,8,2',
                                                                                     Phone='5,2,5,2'}}"
                                                    Padding="{OnPlatform Android={OnIdiom Phone=1,
                                                                                          Tablet=4},
                                                                         iOS={OnIdiom Phone=1,
                                                                                      Tablet=4},
                                                                         UWP={OnIdiom Desktop=4,
                                                                                      Tablet=5,
                                                                                      Phone=1}}"
                                                    BackgroundColor="Transparent"
                                                    HasShadow="{OnPlatform Android=true,
                                                                           iOS=false,
                                                                           UWP=true,
                                                                           WPF=true}">
                                                    <Grid>
                                                        <magic:GradientView GradientSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.SubPageFactsBoxBorderBgSource}" VerticalOptions="FillAndExpand" />

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.30*, Tablet=0.12*}, iOS={OnIdiom Phone=0.30*, Tablet=0.15*}, UWP={OnIdiom Default=0.12*, Phone=0.30*}, macOS=0.12*, WPF=auto}" />
                                                                <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.70*, Tablet=0.88*}, iOS={OnIdiom Phone=0.70*, Tablet=0.85*}, UWP={OnIdiom Default=0.88*, Phone=0.70*}, macOS=*, WPF=*}" />
                                                            </Grid.ColumnDefinitions>

                                                            <Label
                                                                Grid.Column="0"
                                                                Padding="{OnPlatform Android='5,0,0,0',
                                                                                     iOS={OnIdiom Phone='5,0,0,0',
                                                                                                  Tablet='15,0,0,0'},
                                                                                     UWP='5,0,0,0'}"
                                                                FontAttributes="Bold"
                                                                FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamilyBold}"
                                                                FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                       Tablet=15},
                                                                                      iOS={OnIdiom Phone=12,
                                                                                                   Tablet=18},
                                                                                      UWP={OnIdiom Phone=12,
                                                                                                   Tablet=18,
                                                                                                   Desktop=20},
                                                                                      macOS=20,
                                                                                      WPF=20}"
                                                                LineBreakMode="WordWrap"
                                                                Text="{Binding Key}"
                                                                TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.SubPageFactsFontColor, Converter={StaticResource stringToColorConverter}}"
                                                                VerticalTextAlignment="Center" />
                                                            <Label
                                                                Grid.Column="1"
                                                                Padding="2,2,5,2"
                                                                CharacterSpacing="{OnPlatform Android={OnIdiom Phone=0.3,
                                                                                                               Tablet=0.2},
                                                                                              iOS={OnIdiom Phone=0.3,
                                                                                                           Tablet=0.2},
                                                                                              UWP={OnIdiom Phone=0.3,
                                                                                                           Tablet=0.4,
                                                                                                           Desktop=0.4},
                                                                                              macOS=0.4,
                                                                                              WPF=0.4}"
                                                                FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamily}"
                                                                FontSize="{OnPlatform Android={OnIdiom Phone=14,
                                                                                                       Tablet=17},
                                                                                      iOS={OnIdiom Phone=13,
                                                                                                   Tablet=20},
                                                                                      UWP={OnIdiom Phone=14,
                                                                                                   Tablet=17,
                                                                                                   Desktop=17},
                                                                                      macOS=17,
                                                                                      WPF=17}"
                                                                HorizontalTextAlignment="{OnPlatform Android={OnIdiom Phone=End,
                                                                                                                      Tablet=Start},
                                                                                                     iOS={OnIdiom Phone=End,
                                                                                                                  Tablet=Start},
                                                                                                     UWP={OnIdiom Phone=End,
                                                                                                                  Tablet=Start,
                                                                                                                  Desktop=Start},
                                                                                                     macOS=Start,
                                                                                                     WPF=Start}"
                                                                LineBreakMode="WordWrap"
                                                                LineHeight="{OnPlatform Android={OnIdiom Phone=1.1,
                                                                                                         Tablet=1.0},
                                                                                        iOS={OnIdiom Phone=1,
                                                                                                     Tablet=1.2},
                                                                                        UWP={OnIdiom Phone=1,
                                                                                                     Tablet=1.2,
                                                                                                     Desktop=1.2},
                                                                                        macOS=1.2,
                                                                                        WPF=1.2}"
                                                                Text="{Binding Description}"
                                                                TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.SubPageFactsFontColor, Converter={StaticResource stringToColorConverter}}"
                                                                VerticalTextAlignment="Center" />

                                                        </Grid>
                                                    </Grid>
                                                </Frame>
                                            </DataTemplate>
                                        </syncfusionList:SfListView.ItemTemplate>
                                    </syncfusionList:SfListView>
                                </StackLayout>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                        <tabView:SfTabItem x:Name="tabDetailContent" Title="Details">
                            <tabView:SfTabItem.HeaderContent>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="90*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <magic:GradientView GradientSource="{Binding DefaultStyle.TabHeadBgSource}" VerticalOptions="FillAndExpand" />
                                    <Button
                                        Grid.Row="0"
                                        BackgroundColor="Transparent"
                                        Clicked="Second_TabItem_Clicked"
                                        FontAttributes="Bold"
                                        FontFamily="{Binding DefaultStyle.DefaultFontFamilyBold}"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                               Tablet=14},
                                                              iOS={OnIdiom Phone=12,
                                                                           Tablet=14},
                                                              UWP={OnIdiom Phone=12,
                                                                           Tablet=14,
                                                                           Desktop=14},
                                                              macOS=14,
                                                              WPF=14}"
                                        Text="Details"
                                        TextColor="{Binding DefaultStyle.TabHeadTextColor, Converter={StaticResource stringToColorConverter}}" />
                                    <Button Grid.Row="1" BackgroundColor="Transparent" />
                                </Grid>
                            </tabView:SfTabItem.HeaderContent>
                            <tabView:SfTabItem.Content>
                                <syncfusionList:SfListView
                                    Padding="10,2,8,0"
                                    AutoFitMode="DynamicHeight"
                                    ItemTemplate="{StaticResource ItemDetailListTemplateSelector}"
                                    ItemsSource="{Binding ItemDetailItems}"
                                    SelectionMode="None" />
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                        <tabView:SfTabItem x:Name="tabPictures">
                            <tabView:SfTabItem.HeaderContent>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="90*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <magic:GradientView GradientSource="{Binding DefaultStyle.TabHeadBgSource}" VerticalOptions="FillAndExpand" />
                                    <Button
                                        Grid.Row="0"
                                        BackgroundColor="Transparent"
                                        Clicked="Third_TabItem_Clicked"
                                        FontAttributes="Bold"
                                        FontFamily="{Binding DefaultStyle.DefaultFontFamilyBold}"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                               Tablet=14},
                                                              iOS={OnIdiom Phone=12,
                                                                           Tablet=14},
                                                              UWP={OnIdiom Phone=12,
                                                                           Tablet=14,
                                                                           Desktop=14},
                                                              macOS=14,
                                                              WPF=14}"
                                        Text="{Binding PictureTitle}"
                                        TextColor="{Binding DefaultStyle.TabHeadTextColor, Converter={StaticResource stringToColorConverter}}" />
                                    <Button Grid.Row="1" BackgroundColor="Transparent" />
                                </Grid>
                            </tabView:SfTabItem.HeaderContent>
                            <tabView:SfTabItem.Content>
                                <syncfusionList:SfListView
                                    x:Name="lstImages"
                                    AutoFitMode="Height"
                                    ItemsSource="{Binding Persona.Pictures}"
                                    SelectionMode="None">
                                    <syncfusionList:SfListView.LayoutManager>
                                        <syncfusionList:GridLayout SpanCount="{OnPlatform Android={OnIdiom Phone=2, Tablet=4}, iOS={OnIdiom Phone=2, Tablet=4}, UWP=4, macOS=4, WPF=4}" />
                                    </syncfusionList:SfListView.LayoutManager>
                                    <syncfusionList:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <sfEffectsView:SfEffectsView
                                                x:Name="lstImageEffectsLayer"
                                                Margin="10,0,0,10"
                                                AnimationCompleted="lstImageEffectsLayer_AnimationCompleted"
                                                AutomationId="{Binding Id}"
                                                CornerRadius="5"
                                                RippleAnimationDuration="300"
                                                TouchDownEffects="Ripple">
                                                <StackLayout>
                                                    <sfBorder:SfBorder
                                                        BorderColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.ListItemBoxBorderColor, Converter={StaticResource stringToColorConverter}}"
                                                        BorderWidth="1"
                                                        VerticalOptions="Center">
                                                        <Grid>
                                                            <magic:GradientView GradientSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.ListItemBoxBgSource}" VerticalOptions="FillAndExpand" />
                                                            <StackLayout>
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="{OnPlatform Android={OnIdiom Phone=100, Tablet=150}, iOS={OnIdiom Phone=100, Tablet=150}, UWP=150, macOS=150, WPF=150}" />
                                                                        <RowDefinition Height="40" />
                                                                    </Grid.RowDefinitions>
                                                                    <local:ExtendedImage
                                                                        Grid.Row="0"
                                                                        Margin="0,3,0,0"
                                                                        Aspect="AspectFit"
                                                                        PictureSource="{Binding}" />
                                                                    <Label
                                                                        Grid.Row="1"
                                                                        Margin="5,0,0,5"
                                                                        FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamilyBold}"
                                                                        FontSize="{OnPlatform Android={OnIdiom Phone=10,
                                                                                                               Tablet=14},
                                                                                              iOS={OnIdiom Phone=10,
                                                                                                           Tablet=14},
                                                                                              UWP=14,
                                                                                              macOS=14,
                                                                                              WPF=14}"
                                                                        HorizontalTextAlignment="Center"
                                                                        LineBreakMode="CharacterWrap"
                                                                        Text="{Binding PictureCaption}"
                                                                        TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontColor, Converter={StaticResource stringToColorConverter}}" />
                                                                </Grid>
                                                            </StackLayout>
                                                        </Grid>
                                                    </sfBorder:SfBorder>
                                                </StackLayout>
                                            </sfEffectsView:SfEffectsView>
                                        </DataTemplate>
                                    </syncfusionList:SfListView.ItemTemplate>
                                </syncfusionList:SfListView>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                    </tabView:SfTabView>
                </StackLayout>

                <StackLayout x:Name="stackBannerAds">
                    <!--<admob:MTAdView
                        AdsId="{Binding AdsBannerId}"
                        HeightRequest="{OnPlatform Android={OnIdiom Phone=50,
                                                                    Tablet=50},
