                                                                Tablet=50}}"
                        IsVisible="{OnPlatform Android=true,
                                               iOS=true,
                                               UWP=false,
                                               macOS=false,
                                               WPF=false}" />-->
                </StackLayout>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>


