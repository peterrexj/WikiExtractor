<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Maui.Saints.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:WikiExtractor.Maui.App.Converters;assembly=WikiExtractor.Maui.App"
    xmlns:local="clr-namespace:Maui.Saints">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Converters  -->
            <converters:StringToColorConverter x:Key="stringToColorConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BusyToOpacityConverter x:Key="BusyToOpacity" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
