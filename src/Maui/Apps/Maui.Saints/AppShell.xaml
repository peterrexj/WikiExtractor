<?xml version="1.0" encoding="UTF-8" ?>
<views:AppShellBase
    x:Class="Maui.Saints.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maui.Saints"
    xmlns:views="clr-namespace:WikiExtractor.Maui.App.Views;assembly=WikiExtractor.Maui.App"
    BackgroundColor="{DynamicResource WikiAppAppShellBgColor}"
    FlyoutBackgroundColor="{DynamicResource WikiAppAppShellBgColor}"
    FlyoutWidth="300"
    ForegroundColor="{DynamicResource WikiAppAppShellFgColor}"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="True"
    TitleColor="{DynamicResource WikiAppAppShellFgColor}">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid
                x:Name="FlyoutItemLayout"
                ColumnSpacing="0"
                HeightRequest="50"
                RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.05*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    x:Name="FlyoutItemImage"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="{Binding FlyoutIcon}"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Label
                    x:Name="FlyoutItemLabel"
                    Grid.Column="1"
                    Margin="10,0,1,0"
                    FontAttributes="Bold"
                    FontSize="14"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Text="{Binding Title}"
                    TextColor="{DynamicResource WikiAppAppShellFgColor}"
                    VerticalTextAlignment="Center" />
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter TargetName="FlyoutItemLabel" Property="Label.TextColor" Value="{DynamicResource WikiAppAppShellFgColor}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource WikiAppPrimaryAccentColor}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutFooter>
        <Grid BackgroundColor="{DynamicResource WikiAppTopPanelBackgroundColor}">
            <Label
                Margin="5"
                FontAttributes="Italic,Bold"
                FontSize="14"
                HorizontalOptions="Center"
                Text="Powered By Wikipedia"
                TextColor="White" />
        </Grid>
    </Shell.FlyoutFooter>

    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="{DynamicResource WikiAppAppShellBgColor}" />
                <Setter Property="Shell.ForegroundColor" Value="{DynamicResource WikiAppAppShellFgColor}" />
                <Setter Property="Shell.TitleColor" Value="{DynamicResource WikiAppAppShellFgColor}" />
            </Style>
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="TabBar" />
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="FlyoutItem" />
        </ResourceDictionary>
    </Shell.Resources>

</views:AppShellBase>
