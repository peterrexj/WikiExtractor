<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Maui.Wiki.ViewModels"
             xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="Maui.Wiki.Views.SettingsPage"
             Title="Settings">

    <ContentPage.BindingContext>
        <viewmodels:SettingsViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="20">
            <Label Text="Settings" FontSize="24" FontAttributes="Bold" />
            
            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource WikiAppBorderColor}" />
            
            <VerticalStackLayout Spacing="10">
                <Label Text="Application Theme" FontSize="18" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Themes}"
                        SelectedItem="{Binding SelectedTheme}"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{DynamicResource WikiAppPickerStyle}" />
            </VerticalStackLayout>
            
            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource WikiAppBorderColor}" />
            
            <VerticalStackLayout Spacing="10">
                <Label Text="List Display Options" FontSize="18" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                    <Label Grid.Column="0"
                           Text="Hide Viewed Items"
                           FontSize="16"
                           VerticalOptions="Center" />
                    <sfButtons:SfSwitch Grid.Column="1"
                                        x:Name="hideViewedSwitch"
                                        IsOn="{Binding HideViewedItems}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        StateChanged="HideViewedSwitch_StateChanged" />
                </Grid>
            </VerticalStackLayout>
            
            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource WikiAppBorderColor}" />
            
            <VerticalStackLayout Spacing="10">
                <Label Text="Sort Options" FontSize="18" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Sort By"
                           FontSize="16"
                           VerticalOptions="Center" />
                    <sfButtons:SfSegmentedControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                  x:Name="sfSegmentSortOrder"
                                                  Margin="0,5,0,0"
                                                  BackgroundColor="Transparent"
                                                  ItemsSource="{Binding SortByCollection}"
                                                  SegmentHeight="40"
                                                  SelectedIndex="{Binding SortBySelectedIndex}"
                                                  SelectionChanged="SfSegmentSortOrder_SelectionChanged"
                                                  VisibleSegmentsCount="6"
                                                  IsEnabled="{Binding IsNotBusy}" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
        
        <ActivityIndicator Grid.Row="1" 
                           IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Style="{DynamicResource WikiAppActivityIndicatorStyle}" />
    </Grid>
</ContentPage>