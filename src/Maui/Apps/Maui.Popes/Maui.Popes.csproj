<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS targeting with Xcode 16.3 compatibility -->
		<TargetFrameworks>net9.0-android36.0;net9.0-ios18.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Maui.Wiki</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		
		<!-- Build properties to resolve PE image issues -->
		<AndroidUseAapt2>true</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
		<AndroidLinkMode>None</AndroidLinkMode>
		<AndroidLinkSkip />
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>
		<PublishTrimmed>true</PublishTrimmed>
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidDexTool>d8</AndroidDexTool>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- Use specific runtime identifiers for each platform -->
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">iossimulator-arm64</RuntimeIdentifier>
		<!-- iOS build properties -->
		<CodesignKey Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">-</CodesignKey>
		<CodesignProvision Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'"></CodesignProvision>
		<CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'"></CodesignEntitlements>
		<AndroidStoreUncompressedFileExtensions>.dll</AndroidStoreUncompressedFileExtensions>
		<MtouchLink>None</MtouchLink>

		<!-- Display name -->
		<ApplicationTitle>Wiki of Church</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.peterrexj.popesofchurch</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<!-- Force compatibility with Xcode 16.3 -->
		<UseXcode16_3ForIOS>true</UseXcode16_3ForIOS>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<AndroidTargetApiLevel>36</AndroidTargetApiLevel>
		<AndroidTargetFrameworkVersion>v15.0</AndroidTargetFrameworkVersion>
		<AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
		<AndroidSdkDirectory>/Users/josephpe/Library/Android/sdk</AndroidSdkDirectory>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	
		<DefaultLanguage>en-au</DefaultLanguage>
		<AndroidSigningKeyStore>catholicsaints.keystore</AndroidSigningKeyStore>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		
		<!-- SQLite Databases - Linked from Resources folder -->
		<MauiAsset Include="..\..\..\..\Resources\Databases\WikiStorePopes.db" Link="Resources\Raw\WikiStore.db" LogicalName="WikiStore.db" />
		
		<!-- Ensure database files are included in iOS bundle -->
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Core" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		
		<!-- Syncfusion MAUI packages - .NET 8 compatible versions -->
		<PackageReference Include="Syncfusion.Maui.Core" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Maui.Buttons" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Maui.ListView" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Maui.Inputs" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Maui.Carousel" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Maui.Charts" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Maui.Popup" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Maui.ProgressBar" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Maui.TabView" Version="28.2.7" />
		
		<!-- AppCenter packages (MAUI compatible) -->
		<PackageReference Include="Microsoft.AppCenter.Analytics" Version="5.0.3" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" />
		<PackageReference Include="Microsoft.AppCenter.Crashes" Version="5.0.3" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" />
		
		<!-- Google AdMob packages for PjAds.Maui -->
		<PackageReference Include="Xamarin.GooglePlayServices.Ads" Version="123.2.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
		<PackageReference Include="Xamarin.Google.iOS.MobileAds" Version="8.13.0.3" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
	</ItemGroup>

	<ItemGroup>
		 <ProjectReference Include="..\..\Library\WikiExtractor.Maui.App\WikiExtractor.Maui.App.csproj" />
	</ItemGroup>

</Project>
