<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
			net9.0-android36.0
		</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">
			net9.0-android36.0;net9.0-ios18.0
		</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Maui.Wiki</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		
		<AndroidUseAapt2>true</AndroidUseAapt2>
		<AndroidLinkSkip />
		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>
		<AndroidDexTool>d8</AndroidDexTool>
		<AndroidPackageFormat Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormat>
		<AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>

		<!-- Display name -->
		<ApplicationTitle>Popes</ApplicationTitle>
		
		<!-- App Identifier -->
		<ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">com.pj.popesofchurch</ApplicationId>
		<ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">com.pj.popesofchurch</ApplicationId>
		
		<!-- Versions - update per platform independently before each store release -->
		<ApplicationDisplayVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">19.0</ApplicationDisplayVersion>
		<ApplicationDisplayVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">1.0</ApplicationDisplayVersion>
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">19</ApplicationVersion>
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<UseXcode16_3ForIOS>true</UseXcode16_3ForIOS>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	
		<DefaultLanguage>en-au</DefaultLanguage>
	</PropertyGroup>

	<!-- Debug Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net9.0-android36.0'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
		<AndroidLinkMode>None</AndroidLinkMode>
		<AndroidEnableProguard>false</AndroidEnableProguard>
		<AndroidEnableR8FullMode>false</AndroidEnableR8FullMode>
		<EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidEnablePreloadAssembliesDefault>true</AndroidEnablePreloadAssembliesDefault>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<!-- iOS Debug (simulator) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net9.0-ios18.0'">
		<RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
		<CodesignKey>-</CodesignKey>
		<CodesignProvision></CodesignProvision>
		<CodesignEntitlements></CodesignEntitlements>
		<MtouchLink>None</MtouchLink>
	</PropertyGroup>

	<!-- iOS Release (App Store) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net9.0-ios18.0'">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<CodesignKey>Apple Distribution: Peter Joseph (5PNCUV7LZ5)</CodesignKey>
		<CodesignProvision>Automatic:Distribution</CodesignProvision>
		<MtouchLink>None</MtouchLink>
		<ArchiveOnBuild>true</ArchiveOnBuild>
	</PropertyGroup>

	<!-- Release Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net9.0-android36.0'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
		<AndroidSupportedAbis>arm64-v8a;x86_64</AndroidSupportedAbis>
		<AndroidLinkMode>None</AndroidLinkMode>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidEnableProguard>true</AndroidEnableProguard>
		<AndroidEnableR8FullMode>false</AndroidEnableR8FullMode>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<RunAOTCompilation>false</RunAOTCompilation>
		<PublishTrimmed>false</PublishTrimmed>
		<AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>..\..\..\..\Resources\droidCerts\catholicsaints.keystore</AndroidSigningKeyStore>
		<AndroidSigningStorePass>CatholicSaintsPassword@01</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>keyalias.alias</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>CatholicSaintsPassword@01</AndroidSigningKeyPass>
	</PropertyGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
		<PackageReference Include="Xamarin.GooglePlayServices.Ads" Version="123.2.0" />

		<PackageReference Include="Xamarin.AndroidX.Core" Version="1.16.0.3" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.6" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat.AppCompatResources" Version="1.7.1.1" />

		<PackageReference Include="Xamarin.AndroidX.Activity" Version="1.10.1.2" />
		<PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.2.1.17" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.9.2.1" />

		<ProguardConfiguration Include="proguard.cfg" />
	</ItemGroup>
	
	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-ios'))">
		<PackageReference Include="Xamarin.Google.iOS.MobileAds" Version="8.13.0.3" />
	</ItemGroup>
	
	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#222831" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Images\appicon_1024.png" Color="#222831" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		
		<!-- SQLite Databases - Linked from Resources folder -->
		<MauiAsset Include="..\..\..\..\Resources\Databases\WikiStorePopes.db" Link="Resources\Raw\WikiStorePopes.db" LogicalName="WikiStorePopes.db" />
		
		<!-- Ensure database files are included in iOS bundle -->
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Core" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		
		<!-- Syncfusion MAUI packages -->
		<PackageReference Include="Syncfusion.Maui.Core" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Buttons" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.ListView" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Inputs" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Carousel" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Charts" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Popup" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.ProgressBar" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.TabView" Version="33.2.6" />
		
		<!-- AppCenter packages (MAUI compatible) -->
		<PackageReference Include="Microsoft.AppCenter.Analytics" Version="5.0.3" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" />
		<PackageReference Include="Microsoft.AppCenter.Crashes" Version="5.0.3" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" />

		<!-- Firebase Crashlytics - Android only (iOS GoogleUtilities version conflict with MobileAds) -->
		<PackageReference Include="Plugin.Firebase.Crashlytics" Version="3.1.1" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />

		<!-- <PackageReference Include="Plugin.InAppBilling" Version="8.0.5" /> -->
	</ItemGroup>
	
	<ItemGroup>
		 <ProjectReference Include="..\..\Library\WikiExtractor.Maui.App\WikiExtractor.Maui.App.csproj" />
	</ItemGroup>

</Project>
