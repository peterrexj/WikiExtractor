<?xml version="1.0" encoding="utf-8" ?>
<DataTemplate
    x:Class="WikiExtractor.Maui.App.Controls.Header3ListItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontAwesome="clr-namespace:FontAwesome"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons">
    
    <!-- Enhanced Header3 template with consistent styling -->
    <Border
        Margin="{OnIdiom Phone='5,2,5,2', Tablet='8,3,8,3', Desktop='8,3,8,3', Default='5,2,5,2'}"
        Padding="{OnIdiom Phone='10,6', Tablet='14,8', Desktop='14,8', Default='10,6'}"
        HorizontalOptions="FillAndExpand"
        VerticalOptions="Fill"
        StrokeShape="RoundRectangle 6"
        StrokeThickness="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{StaticResource WikiAppHeader3BackgroundStart}" Offset="0.0" />
                <GradientStop Color="{StaticResource WikiAppHeader3BackgroundMid}" Offset="0.5" />
                <GradientStop Color="{StaticResource WikiAppHeader3BackgroundEnd}" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <!-- Header3 text with improved layout -->
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontFamily="{StaticResource DefaultFontFamily}"
                FontSize="{OnIdiom Phone=16, Tablet=20, Desktop=22, Default=16}"
                HorizontalOptions="FillAndExpand"
                LineBreakMode="WordWrap"
                Text="{Binding Content}"
                TextColor="{StaticResource WikiAppHeaderTextColor}"
                VerticalOptions="Center"
                VerticalTextAlignment="Center" />
            
            <!-- Play/Stop button with enhanced styling and state management -->
            <StackLayout
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalOptions="End"
                VerticalOptions="Center"
                IsVisible="{Binding IsPlayButtonRequired}"
                Spacing="6">
                
                <!-- Play Button - Visible when not playing -->
                <Border
                    BackgroundColor="{StaticResource WikiAppAudioPlayButtonColor}"
                    StrokeShape="RoundRectangle 18"
                    StrokeThickness="0"
                    Padding="6"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBoolConverter}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlayAudio}"
                            CommandParameter="{Binding ContentLinkId}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="▶"
                        FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18, Default=14}"
                        TextColor="{StaticResource WikiAppAudioButtonTextColor}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontAttributes="Bold" />
                </Border>
                
                <!-- Stop Button - Visible when playing -->
                <Border
                    BackgroundColor="{StaticResource WikiAppAudioStopButtonColor}"
                    StrokeShape="RoundRectangle 18"
                    StrokeThickness="0"
                    Padding="6"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsPlaying}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StopAudio}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="⏹"
                        FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18, Default=14}"
                        TextColor="{StaticResource WikiAppAudioButtonTextColor}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontAttributes="Bold" />
                </Border>
            </StackLayout>
        </Grid>
    </Border>
</DataTemplate>