<?xml version="1.0" encoding="utf-8" ?>
<DataTemplate
    x:Class="WikiExtractor.Maui.App.Controls.Header3ListItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontAwesome="clr-namespace:FontAwesome"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:viewModels="clr-namespace:WikiExtractor.Maui.App.ViewModels;assembly=WikiExtractor.Maui.App"
    x:DataType="viewModels:ItemDetailListViewModel">

    <!--  Header3 — sub-section heading, indented from Header2  -->
    <Grid
        Margin="{OnIdiom Phone='28,4,14,2', Tablet='36,6,18,2', Default='28,4,14,2'}"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Muted accent left bar  -->
        <BoxView
            Grid.Column="0"
            BackgroundColor="{DynamicResource WikiAppListItemKeyTextColor}"
            CornerRadius="1.5"
            HorizontalOptions="Fill"
            Opacity="0.6"
            VerticalOptions="Fill" />

        <!--  Header3 text  -->
        <Label
            Grid.Column="1"
            Margin="8,0,0,0"
            FontAttributes="Bold"
            FontFamily="{DynamicResource DefaultFontFamily}"
            FontSize="{OnIdiom Phone=15, Tablet=19, Default=15}"
            HorizontalOptions="Fill"
            LineBreakMode="WordWrap"
            Text="{Binding Content}"
            TextColor="{DynamicResource WikiAppHeader3TextColor}"
            VerticalOptions="Center" />

        <!--  Play/Stop audio — subtle icon-only, no background  -->
        <Label
            Grid.Column="2"
            Margin="8,0,4,0"
            FontFamily="FontAwesome"
            FontSize="{OnIdiom Phone=13, Tablet=16, Default=13}"
            HorizontalOptions="End"
            IsVisible="{Binding IsPlayButtonRequired}"
            Opacity="0.45"
            Text="&#xf04b;"
            TextColor="{DynamicResource WikiAppHeader3TextColor}"
            VerticalOptions="Center">
            <Label.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" TargetType="Label" Value="True">
                    <Setter Property="Text" Value="&#xf04d;" />
                    <Setter Property="TextColor" Value="{DynamicResource WikiAppPrimaryAccentColor}" />
                    <Setter Property="Opacity" Value="1.0" />
                    <Setter Property="FontSize" Value="{OnIdiom Phone=11, Tablet=14, Default=11}" />
                </DataTrigger>
            </Label.Triggers>
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleAudio}" CommandParameter="{Binding ContentLinkId}" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</DataTemplate>