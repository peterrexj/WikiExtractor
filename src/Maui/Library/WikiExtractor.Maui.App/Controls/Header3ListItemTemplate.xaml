<?xml version="1.0" encoding="utf-8" ?>
<DataTemplate
    x:Class="WikiExtractor.Maui.App.Controls.Header3ListItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontAwesome="clr-namespace:FontAwesome"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:viewModels="clr-namespace:WikiExtractor.Maui.App.ViewModels;assembly=WikiExtractor.Maui.App"
    x:DataType="viewModels:ItemDetailListViewModel">

    <!--  Enhanced Header3 template with consistent styling  -->
    <Border
        Margin="{OnIdiom Phone='5,2,5,2',
                         Tablet='8,3,8,3',
                         Desktop='8,3,8,3',
                         Default='5,2,5,2'}"
        Padding="{OnIdiom Phone='10,6',
                          Tablet='14,8',
                          Desktop='14,8',
                          Default='10,6'}"
        HorizontalOptions="Fill"
        StrokeShape="RoundRectangle 6"
        StrokeThickness="0"
        VerticalOptions="Fill">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Offset="0.0" Color="{DynamicResource WikiAppHeader3BackgroundStart}" />
                <GradientStop Offset="0.5" Color="{DynamicResource WikiAppHeader3BackgroundMid}" />
                <GradientStop Offset="1.0" Color="{DynamicResource WikiAppHeader3BackgroundEnd}" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid HorizontalOptions="Fill" VerticalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Header3 text with improved layout  -->
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontFamily="{DynamicResource DefaultFontFamily}"
                FontSize="{OnIdiom Phone=16,
                                   Tablet=20,
                                   Desktop=22,
                                   Default=16}"
                HorizontalOptions="Fill"
                LineBreakMode="WordWrap"
                Text="{Binding Content}"
                VerticalOptions="Center"
                VerticalTextAlignment="Center" />

            <!--  Play/Stop button with enhanced styling and state management  -->
            <StackLayout
                Grid.Column="1"
                HorizontalOptions="End"
                IsVisible="{Binding IsPlayButtonRequired}"
                Orientation="Horizontal"
                Spacing="6"
                VerticalOptions="Center">

                <!--  Play Button - Visible when not playing  -->
                <Border
                    Padding="6"
                    BackgroundColor="{DynamicResource WikiAppAudioPlayButtonColor}"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBoolConverter}}"
                    MinimumWidthRequest="40"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlayAudio}" CommandParameter="{Binding ContentLinkId}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontAttributes="Bold"
                        FontSize="{OnIdiom Phone=14,
                                           Tablet=16,
                                           Desktop=18,
                                           Default=14}"
                        HorizontalOptions="Center"
                        Text="▶"
                        VerticalOptions="Center" />
                </Border>

                <!--  Stop Button - Visible when playing  -->
                <Border
                    Padding="6"
                    BackgroundColor="{DynamicResource WikiAppAudioStopButtonColor}"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsPlaying}"
                    MinimumWidthRequest="40"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StopAudio}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontAttributes="Bold"
                        FontSize="{OnIdiom Phone=14,
                                           Tablet=16,
                                           Desktop=18,
                                           Default=14}"
                        HorizontalOptions="Center"
                        Text="⏹"
                        VerticalOptions="Center" />
                </Border>
            </StackLayout>
        </Grid>
    </Border>
</DataTemplate>