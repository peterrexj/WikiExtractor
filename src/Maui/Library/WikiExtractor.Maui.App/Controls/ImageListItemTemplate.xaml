<?xml version="1.0" encoding="utf-8" ?>
<DataTemplate
    x:Class="WikiExtractor.Maui.App.Controls.ImageListItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WikiExtractor.Maui.App.Exts">

    <Grid
        Margin="{OnIdiom Phone='14,6,14,12', Tablet='18,8,18,16', Default='14,6,14,12'}"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            AutomationId="{Binding ImageDimension}"
            BackgroundColor="Transparent"
            HeightRequest="{Binding ImageHeight}"
            HorizontalOptions="Fill"
            SizeChanged="Border_SizeChanged"
            Stroke="{DynamicResource WikiAppListItemKeyTextColor}"
            StrokeThickness="0.5"
            VerticalOptions="Fill">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <local:ExtendedImage
                x:Name="img"
                Aspect="AspectFit"
                CustomSource="{Binding ImageLocalPath}"
                HorizontalOptions="Fill"
                LocalFileName="{Binding ImageFileName}"
                VerticalOptions="Fill" />
        </Border>

        <Label
            Grid.Row="1"
            Margin="0,6,0,0"
            FontFamily="{DynamicResource DefaultFontFamily}"
            FontSize="{OnIdiom Phone=12, Tablet=14, Default=12}"
            HorizontalOptions="Fill"
            HorizontalTextAlignment="Center"
            LineBreakMode="WordWrap"
            Text="{Binding ImageCaption}"
            TextColor="{DynamicResource WikiAppImageCaptionTextColor}"
            VerticalOptions="Center" />
    </Grid>
</DataTemplate>
