<?xml version="1.0" encoding="utf-8" ?>
<DataTemplate
    x:Class="WikiExtractor.Maui.App.Controls.ParagraphContentListItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:WikiExtractor.Maui.App.ViewModels;assembly=WikiExtractor.Maui.App"
    x:DataType="viewModels:ItemDetailListViewModel">

    <!--  Enhanced Paragraph template with proper spacing and background  -->
    <!--<Border
        Margin="{OnIdiom Phone='5,3,5,3',
                         Tablet='8,5,8,5',
                         Desktop='8,5,8,5',
                         Default='5,3,5,3'}"
        Padding="{OnIdiom Phone='12,8',
                          Tablet='16,12',
                          Desktop='16,12',
                          Default='12,8'}"
        BackgroundColor="{DynamicResource WikiAppContentBackgroundColor}"
        HorizontalOptions="Fill"
        Stroke="{DynamicResource WikiAppGrayColor}"
        StrokeShape="RoundRectangle 4"
        StrokeThickness="0.5"
        VerticalOptions="Fill">-->

    <Label
        Margin="{OnIdiom Phone='5,3,5,3',
                         Tablet='8,5,8,5',
                         Desktop='8,5,8,5',
                         Default='5,3,5,3'}"
        Padding="{OnIdiom Phone='5,0,5,0',
                          Tablet='16,12',
                          Desktop='16,12',
                          Default='12,8'}"
        CharacterSpacing="{OnIdiom Phone=0.3,
                                   Tablet=0.4,
                                   Desktop=0.4,
                                   Default=0.3}"
        FontFamily="{DynamicResource DefaultFontFamily}"
        FontSize="{OnIdiom Phone=14,
                           Tablet=17,
                           Desktop=17,
                           Default=14}"
        HorizontalOptions="Fill"
        HorizontalTextAlignment="Start"
        LineBreakMode="WordWrap"
        LineHeight="{OnIdiom Phone=1.3,
                             Tablet=1.4,
                             Desktop=1.4,
                             Default=1.3}"
        Text="{Binding Content}"
        VerticalOptions="Fill"
        VerticalTextAlignment="Start" />
    <!--</Border>-->
</DataTemplate>