<?xml version="1.0" encoding="utf-8" ?>
<DataTemplate
    x:Class="WikiExtractor.Maui.App.Controls.ParagraphContentListItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:WikiExtractor.Maui.App.ViewModels;assembly=WikiExtractor.Maui.App"
    x:DataType="viewModels:ItemDetailListViewModel">

    <Label
        Margin="{OnIdiom Phone='28,0,14,16', Tablet='36,0,18,20', Default='28,0,14,16'}"
        CharacterSpacing="{OnIdiom Phone=0.2, Tablet=0.3, Default=0.2}"
        FontFamily="{DynamicResource DefaultFontFamily}"
        FontSize="{DynamicResource WikiAppParagraphFontSize}"
        HorizontalOptions="Fill"
        HorizontalTextAlignment="Start"
        LineBreakMode="WordWrap"
        LineHeight="{OnIdiom Phone=1.55, Tablet=1.6, Default=1.55}"
        Text="{Binding Content}"
        TextColor="{DynamicResource WikiAppParagraphTextColor}"
        VerticalOptions="Fill"
        VerticalTextAlignment="Start" />
</DataTemplate>