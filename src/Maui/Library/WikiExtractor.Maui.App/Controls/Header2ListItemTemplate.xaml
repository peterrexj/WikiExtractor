<?xml version="1.0" encoding="utf-8" ?>
<DataTemplate
    x:Class="WikiExtractor.Maui.App.Controls.Header2ListItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    
    xmlns:viewModels="clr-namespace:WikiExtractor.Maui.App.ViewModels;assembly=WikiExtractor.Maui.App"
    x:DataType="viewModels:ItemDetailListViewModel">

    <!--  Header2 — section heading with accent left bar  -->
    <Grid
        Margin="{OnIdiom Phone='14,8,14,2', Tablet='18,10,18,4', Default='14,8,14,2'}"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Accent left bar  -->
        <BoxView
            Grid.Column="0"
            BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
            CornerRadius="2"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!--  Header text  -->
        <Label
            Grid.Column="1"
            Margin="10,0,0,0"
            FontAttributes="Bold"
            FontFamily="{DynamicResource DefaultFontFamily}"
            FontSize="{OnIdiom Phone=17, Tablet=24, Default=24}"
            HorizontalOptions="Fill"
            LineBreakMode="WordWrap"
            Text="{Binding Content}"
            TextColor="{DynamicResource WikiAppListItemHeaderTextColor}"
            VerticalOptions="Center" />

        <!--  Play/Stop audio — subtle icon-only, no background  -->
        <Label
            x:Name="audioBtn"
            Grid.Column="2"
            Margin="10,0,4,0"
            FontFamily="FluentIcons"
            FontSize="{OnIdiom Phone=15, Tablet=21, Default=21}"
            HorizontalOptions="End"
            IsVisible="{Binding IsPlayButtonRequired}"
            Opacity="0.45"
            Text="&#xF605;"
            TextColor="{DynamicResource WikiAppListItemHeaderTextColor}"
            VerticalOptions="Center">
            <Label.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" TargetType="Label" Value="True">
                    <Setter Property="Text" Value="&#xF5D8;" />
                    <Setter Property="TextColor" Value="{DynamicResource WikiAppPrimaryAccentColor}" />
                    <Setter Property="Opacity" Value="1.0" />
                    <Setter Property="FontSize" Value="{OnIdiom Phone=13, Tablet=19, Default=19}" />
                </DataTrigger>
            </Label.Triggers>
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleAudio}" CommandParameter="{Binding ContentLinkId}" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</DataTemplate>