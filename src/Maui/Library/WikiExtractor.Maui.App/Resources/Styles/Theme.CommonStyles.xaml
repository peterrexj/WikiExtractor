<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:converters="clr-namespace:WikiExtractor.Maui.App.Converters">

    <!--  Converters  -->
    <converters:StringToColorConverter x:Key="StringToColorConverter" />
    <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

    <!--  Font Families  -->
    <x:String x:Key="DefaultFontFamily">Calibri</x:String>
    <x:String x:Key="DefaultFontFamilyBold">Calibri</x:String>

    <!--  Color Mappings for Quiz Results Page - using proper resource references  -->
    <x:String x:Key="PageBackgroundColorKey">WikiAppDefaultBackgroundColor</x:String>
    <x:String x:Key="PopupContentBackColorKey">WikiAppPopupContentBackColor</x:String>
    <x:String x:Key="PopupHeaderFooterBackColorKey">WikiAppPopupHeaderFooterBackColor</x:String>
    <x:String x:Key="ChartBorderColorKey">WikiAppChartBorderColor</x:String>
    <x:String x:Key="ChartBgColorKey">WikiAppPopupContentBackColor</x:String>
    <x:String x:Key="SubPageTopHeaderFontColorKey">WikiAppDefaultFontColor</x:String>
    <x:String x:Key="ListItemBoxBorderColorKey">WikiAppListItemBoxBorderColor</x:String>
    <x:String x:Key="QuizAnswerDefaultFontBackColorKey">WikiAppQuizAnswerDefaultFontBackColor</x:String>

    <!--  Global style for Label  -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for Span  -->
    <Style TargetType="Span">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for Button  -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for Entry  -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for SfNumericEntry  -->
    <Style TargetType="editors:SfNumericEntry">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for SfAutocomplete  -->
    <Style TargetType="editors:SfAutocomplete">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="DropDownItemFontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for FontImageSource  -->
    <Style TargetType="FontImageSource">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <Style TargetType="buttons:SfButton">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <!-- Styles for WikiApp -->
    <Style x:Key="TopBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,5,0,2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderControlGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderControlBackgroundGradientBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 3" />
        <!-- <Setter Property="HeightRequest" Value="{OnIdiom Phone=60, Tablet=90, Desktop=90, Default=60}" /> -->
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    
    <!--  Border top highlight box styles  -->
    <Style x:Key="BorderTopHighlightBox" TargetType="Border">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderTopGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderTopBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="VerticalOptions" Value="FillAndExpand" />
    </Style>

    <Style x:Key="BorderTopSingleHighlightBox" TargetType="Border">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderTopGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderTopBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  Border controls box styles  -->
    <Style x:Key="BorderControlHighlightBox" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 3,3,3,3" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderControlGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderControlBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="12,5,12,2" />
    </Style>

    <!--  Border insights box styles  -->
    <Style x:Key="BorderInsightsHighlightBox" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 3,3,3,3" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource BorderInsightsGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderInsightsBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="12,10,12,10" />
    </Style>

    <!--  Expander styles  -->
    <Style x:Key="CommonExpanderStyle" TargetType="expander:SfExpander">
        <Setter Property="HeaderIconColor" Value="{DynamicResource WikiAppExpanderHeaderTextColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState Name="Expanded">
                            <VisualState.Setters>
                                <Setter Property="HeaderBackground" Value="{DynamicResource WikiAppExpanderExpandedGradientBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Collapsed">
                            <VisualState.Setters>
                                <Setter Property="HeaderBackground" Value="{DynamicResource WikiAppExpanderCollapsedGradientBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Expander header label  -->
    <Style x:Key="ExpanderHeaderLabelStyle" TargetType="Label">
        <Setter Property="Margin" Value="15,0,0,0" />
        <!--<Setter Property="HeightRequest" Value="30" />-->
        <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=30, Tablet=60, Desktop=40, TV=60, Watch=15, Default=30}" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppExpanderHeaderTextColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=12, Tablet=24, Desktop=24, TV=24, Watch=8, Default=12}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
    </Style>


    <!--  Tab View  -->
    <Style TargetType="tabView:SfTabView">
        <Setter Property="HeaderHorizontalTextAlignment" Value="Center" />
        <Setter Property="IndicatorCornerRadius" Value="1" />
        <Setter Property="IndicatorStrokeThickness" Value="5" />
        <Setter Property="IndicatorPlacement" Value="Bottom" />
        <Setter Property="IndicatorWidthMode" Value="Stretch" />
        <Setter Property="IndicatorBackground" Value="{DynamicResource WikiAppTabIndicatorStrokeColor}" />
        <Setter Property="TabBarBackground" Value="{DynamicResource WikiAppTabBarBackgroundGradientBrush}" />
    </Style>


    <!--  Tab Item  -->
    <Style TargetType="tabView:SfTabItem">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=10, Tablet=15, Desktop=15, TV=15, Watch=8, Default=10}" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup>
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource WikiAppTabTextColorNormal}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource WikiAppTabTextColorSelected}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--  Input Text styles  -->
    <Style x:Key="CommonTextInputLayoutStyle" TargetType="core:SfTextInputLayout">
        <Setter Property="ContainerBackground" Value="Transparent" />
        <Setter Property="IsHintAlwaysFloated" Value="True" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="ContainerType" Value="None" />
        <Setter Property="FocusedStrokeThickness" Value="3" />
        <Setter Property="UnfocusedStrokeThickness" Value="0" />
        <!--<Setter Property="OutlineCornerRadius" Value="8" />-->
        <!--<Setter Property="Margin" Value="5" />-->
        <Setter Property="Stroke" Value="{DynamicResource WikiAppInputTextWhenFocusedColor}" />
        <Setter Property="HintLabelStyle">
            <Setter.Value>
                <core:LabelStyle
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{OnIdiom Phone=16,
                                       Tablet=21,
                                       Desktop=21,
                                       TV=21,
                                       Watch=14,
                                       Default=16}"
                    TextColor="{DynamicResource WikiAppInputTextFgColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="ErrorLabelStyle">
            <Setter.Value>
                <core:LabelStyle FontAttributes="Italic" FontFamily="{DynamicResource DefaultFontFamily}" />
            </Setter.Value>
        </Setter>
        <Setter Property="HelperLabelStyle">
            <Setter.Value>
                <core:LabelStyle FontFamily="{DynamicResource DefaultFontFamily}" TextColor="{DynamicResource WikiAppInputTextFgColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{DynamicResource WikiAppInputTextWhenUnFocusedColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Focused">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{DynamicResource WikiAppInputTextWhenFocusedColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Error">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{DynamicResource WikiAppInputErrorTextFgColor}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Segment styles  -->
    <Style x:Key="SegmentDefaultStyle" TargetType="buttons:SfSegmentedControl">
        <!--  SelectedSegmentTextColor="{Binding DefaultStyle.SegSelectedTextFgColor, Converter={StaticResource StringToColorConverter}}"  -->
        <!--  SelectionTextColor="{Binding DefaultStyle.SegSelectedTextFgColor, Converter={StaticResource StringToColorConverter}}"  -->
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Stroke" Value="{DynamicResource WikiAppSegBorderColor}" />
        <Setter Property="Background" Value="{DynamicResource WikiAppSegBgColor}" />
        <Setter Property="SegmentHeight" Value="{OnIdiom Phone=40, Tablet=70, Desktop=70, TV=70, Default=40}" />
        <Setter Property="buttons:SfSegmentedControl.TextStyle">
            <Setter.Value>
                <buttons:SegmentTextStyle
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{OnIdiom Phone=12,
                                       Tablet=17,
                                       Desktop=17,
                                       TV=17,
                                       Watch=10,
                                       Default=12}"
                    TextColor="{DynamicResource WikiAppSegTextFgColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="buttons:SfSegmentedControl.SelectionIndicatorSettings">
            <Setter.Value>
                <buttons:SelectionIndicatorSettings Background="{DynamicResource WikiAppSegSelectedBgColor}" SelectionIndicatorPlacement="Fill" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style for transaction expense income list item border  -->
    <Style x:Key="TransactionListItemBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,5,12,2" />
        <Setter Property="Background" Value="{DynamicResource WikiAppLstBgBrush}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Stroke" Value="{DynamicResource WikiAppLstBorderBrush}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8,8,8,8" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  Style for ListView item border  -->
    <Style x:Key="ListItemBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Stroke" Value="{DynamicResource WikiAppLstBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource WikiAppLstBgBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  Style for Chart border  -->
    <Style x:Key="WikiAppChartBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,5,12,2" />
        <Setter Property="Background" Value="{DynamicResource WikiAppChartInnerBorderGradientBrush}" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=250, Tablet=350, Desktop=350, TV=350, Default=250}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Stroke" Value="{DynamicResource WikiAppChartOuterBorderGradientBrush}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  Chart Insights data marker style  -->
    <Style x:Key="InsightsChartDataLabelStyle" TargetType="chart:ChartDataLabelStyle">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=10, Tablet=15, Desktop=15, TV=15, Watch=8, Default=10}" />
        <Setter Property="LabelFormat" Value="c" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppChartDataMarkerTextColor}" />
    </Style>
    <Style x:Key="MauiButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MaximumHeightRequest" Value="50" />
        <Setter Property="Background" Value="{DynamicResource WikiAppButtonBgColor}" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppButtonFgColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=19, Desktop=19, TV=19, Watch=12, Default=14}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>
    <Style x:Key="ExportButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="10,4,10,4" />
        <!--<Setter Property="MaximumHeightRequest" Value="60" />-->
        <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=50, Tablet=80, Desktop=80, TV=80, Watch=30, Default=50}" />
        <Setter Property="Background" Value="{DynamicResource WikiAppExportButtonBgColor}" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppExportButtonFgColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=18, Tablet=23, Desktop=23, TV=23, Watch=16, Default=18}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>
    <Style x:Key="ButtonStyle" TargetType="buttons:SfButton">
        <Setter Property="Background" Value="{DynamicResource WikiAppButtonBgColor}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MaximumHeightRequest" Value="50" />
        <!--<Setter Property="HeightRequest" Value="50" />-->
    </Style>
    <Style x:Key="ButtonLabelStyle" TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppButtonFgColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=19, Desktop=19, TV=19, Watch=12, Default=14}" />
    </Style>
    <Style x:Key="ListIconButtonStyle" TargetType="buttons:SfButton">
        <Setter Property="Background" Value="{DynamicResource WikiAppButtonBgColor}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Margin" Value="3,0,0,0" />
        <Setter Property="ShowIcon" Value="True" />
    </Style>
    <Style x:Key="ImageSmallRoundButton" TargetType="buttons:SfButton">
        <!-- <Setter Property="Background" Value="{DynamicResource WikiAppButtonBgColor}" /> -->
        <Setter Property="Background" Value="Yellow" />
        <Setter Property="CornerRadius" Value="30" />
        <Setter Property="HeightRequest" Value="30"></Setter>
        <Setter Property="WidthRequest" Value="30"></Setter>
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="HorizontalOptions" Value="Center"></Setter>
        <Setter Property="VerticalOptions" Value="Center"></Setter>
    </Style>

    <!--  Style for SfAutocomplete  -->
    <Style x:Key="SfAutocompleteStyle" TargetType="editors:SfAutocomplete">
        <Setter Property="Margin" Value="5,3,5,0" />
        <Setter Property="SelectionTextHighlightColor" Value="{DynamicResource WikiAppAutoCompleteSelectionTextHighlightColor}" />
        <Setter Property="SelectedDropDownItemBackground" Value="{DynamicResource WikiAppAutoCompleteSelectedDropDownItemBackground}" />
        <Setter Property="ClearButtonIconColor" Value="{DynamicResource WikiAppAutoCompleteClearButtonColor}" />
        <Setter Property="DropDownBackground" Value="{DynamicResource WikiAppAutoCompleteDropdownBackgroundColor}" />
        <Setter Property="DropDownItemFontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="DropDownItemTextColor" Value="{DynamicResource WikiAppAutoCompleteDropdownTextColor}" />
        <Setter Property="DropDownStroke" Value="{DynamicResource WikiAppAutoCompleteDropdownBorderColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="HighlightedTextColor" Value="{DynamicResource WikiAppAutoCompleteHighlightedTextColor}" />
        <Setter Property="HighlightedTextFontAttributes" Value="Bold" />
        <Setter Property="IsClearButtonVisible" Value="True" />
        <Setter Property="MinimumPrefixCharacters" Value="2" />
        <Setter Property="NoResultsFoundText" Value="No Results Found" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource WikiAppAutoCompleteWaterColor}" />
        <Setter Property="Placeholder" Value="Enter here to search" />
        <Setter Property="ShowBorder" Value="False" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppAutoCompleteTextColor}" />
        <Setter Property="TextHighlightMode" Value="MultipleOccurrence" />
        <Setter Property="TextSearchMode" Value="Contains" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=19, Desktop=19, TV=19, Watch=12, Default=14}" />
        <Setter Property="DropDownItemFontSize" Value="{OnIdiom Phone=14, Tablet=19, Desktop=19, TV=19, Watch=12, Default=14}" />
        <Setter Property="NoResultsFoundTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Label
                        Margin="70,10,0,0"
                        FontAttributes="Italic"
                        FontFamily="{DynamicResource DefaultFontFamily}"
                        FontSize="{OnIdiom Phone=16,
                                           Tablet=21,
                                           Desktop=21,
                                           TV=21,
                                           Watch=14,
                                           Default=16}"
                        Text="Not Found"
                        TextColor="{DynamicResource WikiAppAutoCompleteNoResultsFoundTextColor}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style for SfComboBox  -->
    <Style x:Key="SfComboBoxStyle" TargetType="editors:SfComboBox">
        <Setter Property="DropDownBackground" Value="{DynamicResource WikiAppComboDropDownBackgroundColor}" />
        <Setter Property="DropDownItemFontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="DropDownItemTextColor" Value="{DynamicResource WikiAppComboDropDownTextColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=19, Desktop=19, TV=19, Watch=12, Default=14}" />
        <Setter Property="DropDownItemFontSize" Value="{OnIdiom Phone=14, Tablet=19, Desktop=19, TV=19, Watch=12, Default=14}" />
        <Setter Property="HighlightedTextColor" Value="{DynamicResource WikiAppComboHighlightedTextColor}" />
        <Setter Property="IsClearButtonVisible" Value="False" />
        <Setter Property="IsFilteringEnabled" Value="False" />
        <Setter Property="SelectedDropDownItemBackground" Value="{DynamicResource WikiAppComboSelectedDropDownItemColor}" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppComboTextColor}" />
        <Setter Property="TextHighlightMode" Value="MultipleOccurrence" />
        <Setter Property="TextSearchMode" Value="Contains" />
    </Style>

    <!--  Span Three Box on top  -->
    <Style x:Key="SpanThreeBoxCurrencyStyle" TargetType="Span">
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=26, Desktop=26, TV=26, Watch=26, Default=15}" />
    </Style>
    <Style x:Key="SpanThreeBoxAmountStyle" TargetType="Span">
        <Setter Property="CharacterSpacing" Value="{OnIdiom Phone=-1, Tablet=0.5, Desktop=1, TV=1, Default=-1}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=18, Tablet=32, Desktop=32, TV=32, Watch=14, Default=18}" />
    </Style>
    <Style x:Key="SpanThreeBoxTextStyle" TargetType="Span">
        <Setter Property="CharacterSpacing" Value="{OnIdiom Phone=-0.2, Tablet=0, Desktop=1, TV=1, Default=-0.2}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=12, Tablet=20, Desktop=16, TV=16, Watch=10, Default=12}" />
    </Style>

    <!--  Quiz Styles  -->
    <Style x:Key="QuizAnswerButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="10,10,10,0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppQuizAnswerDefaultFontBackColor}" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
    </Style>

    <Style x:Key="QuizNextButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource WikiAppQuizNextButtonBackColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Text" Value="Next" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppDefaultFontColor}" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="VerticalOptions" Value="FillAndExpand" />
    </Style>

    <Style x:Key="QuizPopupBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="20" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WikiAppPopupContentBackColor}" />
        <Setter Property="Stroke" Value="{DynamicResource WikiAppChartBorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

    <Style x:Key="QuizPopupHeaderStyle" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource WikiAppPopupHeaderFooterBackColor}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="QuizQuestionFrameStyle" TargetType="Frame">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WikiAppQuizQuestionBackColor}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- PersonaDetailPage Specific Styles -->
    
    <!-- Style for PersonaDetailPage main background -->
    <Style x:Key="PersonaDetailPageBackgroundStyle" TargetType="Grid">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource WikiAppPersonaDetailPageBgGradientStart}" Offset="0.0" />
                    <GradientStop Color="{DynamicResource WikiAppPersonaDetailPageBgGradientEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for PersonaDetailPage profile image border -->
    <Style x:Key="PersonaDetailProfileImageBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource BorderControlGradientBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource WikiAppPersonaDetailProfileImageBg}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=44, Tablet=60, Desktop=60, Default=44}" />
        <Setter Property="WidthRequest" Value="{OnIdiom Phone=44, Tablet=60, Desktop=60, Default=44}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{OnIdiom Phone=22, Tablet=30, Desktop=30, Default=22}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for PersonaDetailPage title labels -->
    <Style x:Key="PersonaDetailTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=16, Tablet=22, Desktop=24, Default=16}" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppDefaultFontColor}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Style for PersonaDetailPage subtitle labels -->
    <Style x:Key="PersonaDetailSubtitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontAttributes" Value="Italic" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=11, Tablet=14, Desktop=16, Default=11}" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppDefaultFontColor}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Style for PersonaDetailPage wiki source button -->
    <Style x:Key="PersonaDetailWikiSourceButtonStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WikiAppButtonBgColor}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderControlGradientBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="{OnIdiom Phone='6,3', Tablet='10,5', Desktop='10,5', Default='6,3'}" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for PersonaDetailPage wiki source label -->
    <Style x:Key="PersonaDetailWikiSourceLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=9, Tablet=11, Desktop=12, Default=9}" />
        <Setter Property="Text" Value="Wiki Source" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppButtonFgColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Style for PersonaDetailPage mark as viewed border -->
    <Style x:Key="PersonaDetailMarkAsViewedBorderStyle" TargetType="Border">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderTopGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderTopBackgroundGradientBrush}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="Margin" Value="{OnIdiom Phone='10,8,10,5', Tablet='15,12,15,8', Desktop='15,12,15,8', Default='10,8,10,5'}" />
        <Setter Property="Padding" Value="{OnIdiom Phone='15,12', Tablet='20,16', Desktop='20,16', Default='15,12'}" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=80, Tablet=100, Desktop=100, Default=80}" />
    </Style>

    <!-- Style for PersonaDetailPage mark as viewed label -->
    <Style x:Key="PersonaDetailMarkAsViewedLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=16, Tablet=20, Desktop=22, Default=16}" />
        <Setter Property="Text" Value="📖 Mark as Viewed" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppDefaultFontColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Style for PersonaDetailPage status label -->
    <Style x:Key="PersonaDetailStatusLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=18, Desktop=20, Default=14}" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppDefaultFontColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="Margin" Value="{OnIdiom Phone='0,0,15,0', Tablet='0,0,20,0', Desktop='0,0,20,0', Default='0,0,15,0'}" />
    </Style>

    <!-- Style for PersonaDetailPage metadata item border -->
    <Style x:Key="PersonaDetailMetadataItemBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="5,2,5,2" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
    </Style>

    <!-- Style for PersonaDetailPage metadata item grid -->
    <Style x:Key="PersonaDetailMetadataItemGridStyle" TargetType="Grid">
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource WikiAppPersonaDetailMetadataItemBgGradientStart}" Offset="0.0" />
                    <GradientStop Color="{DynamicResource WikiAppPersonaDetailMetadataItemBgGradientEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for PersonaDetailPage metadata key label -->
    <Style x:Key="PersonaDetailMetadataKeyLabelStyle" TargetType="Label">
        <Setter Property="Padding" Value="{OnIdiom Phone='5,0,0,0', Tablet='15,0,0,0', Desktop='15,0,0,0', Default='5,0,0,0'}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=12, Tablet=18, Desktop=20, Default=12}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppPersonaDetailMetadataKeyTextColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- Style for PersonaDetailPage metadata value label -->
    <Style x:Key="PersonaDetailMetadataValueLabelStyle" TargetType="Label">
        <Setter Property="Padding" Value="2,2,5,2" />
        <Setter Property="CharacterSpacing" Value="{OnIdiom Phone=0.3, Tablet=0.4, Desktop=0.4, Default=0.3}" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=17, Desktop=17, Default=14}" />
        <Setter Property="HorizontalTextAlignment" Value="{OnIdiom Phone=End, Tablet=Start, Desktop=Start, Default=End}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="LineHeight" Value="{OnIdiom Phone=1.1, Tablet=1.2, Desktop=1.2, Default=1.1}" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppPersonaDetailMetadataValueTextColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
    </Style>

    <!-- Style for PersonaDetailPage bottom content border -->
    <Style x:Key="PersonaDetailBottomContentBorderStyle" TargetType="Border">
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WikiAppPersonaDetailBottomContentBg}" />
        <Setter Property="Margin" Value="10,5,10,10" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Stroke" Value="{DynamicResource WikiAppPersonaDetailBottomContentBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- Style for PersonaDetailPage bottom content label -->
    <Style x:Key="PersonaDetailBottomContentLabelStyle" TargetType="Label">
        <Setter Property="Text" Value="Additional Content Area - Always Visible" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppPersonaDetailBottomContentTextColor}" />
    </Style>

    <!-- Style for PersonaDetailPage picture item border -->
    <Style x:Key="PersonaDetailPictureItemBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="10,0,0,10" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource WikiAppPersonaDetailPictureItemBorder}" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for PersonaDetailPage picture item grid -->
    <Style x:Key="PersonaDetailPictureItemGridStyle" TargetType="Grid">
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="VerticalOptions" Value="FillAndExpand" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource WikiAppPersonaDetailPictureItemBgGradientStart}" Offset="0.0" />
                    <GradientStop Color="{DynamicResource WikiAppPersonaDetailPictureItemBgGradientEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for PersonaDetailPage picture caption label -->
    <Style x:Key="PersonaDetailPictureCaptionLabelStyle" TargetType="Label">
        <Setter Property="Margin" Value="5,0,5,5" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=10, Tablet=14, Desktop=14, Default=10}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="CharacterWrap" />
        <Setter Property="TextColor" Value="{DynamicResource WikiAppPersonaDetailPictureCaptionTextColor}" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- PersonaDetailPage Gradient Brushes are now defined in each theme file to avoid DynamicResource issues -->

</ResourceDictionary>