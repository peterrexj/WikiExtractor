<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.QuizPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    xmlns:local="clr-namespace:WikiExtractor.Maui.App.Exts"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:sfEffectsView="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    Shell.NavBarIsVisible="True">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <Border
                BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                HeightRequest="34"
                Padding="0"
                StrokeShape="RoundRectangle 10"
                Stroke="Transparent"
                VerticalOptions="Center"
                WidthRequest="34">
                <Label
                    FontFamily="FluentIcons"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="&#xF63D;"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
            </Border>
            <Label
                CharacterSpacing="1.5"
                FontAttributes="Bold"
                FontFamily="{DynamicResource DefaultFontFamily}"
                FontSize="Title"
                Text="QUIZ"
                TextColor="{DynamicResource WikiAppTitleTextColor}"
                VerticalTextAlignment="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ContentPage.Content>
        <Grid Background="{DynamicResource WikiAppQuizPageBackgroundGradientBrush}"
              IgnoreSafeArea="{OnPlatform iOS=True, Default=False}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="0">

                    <!--  Progress pill  -->
                    <Grid
                        Margin="14,14,14,0"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">
                        <FlexLayout
                            Grid.Column="0"
                            BindableLayout.ItemsSource="{Binding Questions}"
                            Direction="Row"
                            JustifyContent="SpaceBetween"
                            VerticalOptions="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <BoxView
                                        BackgroundColor="{Binding SegmentColor}"
                                        CornerRadius="3"
                                        HeightRequest="6"
                                        FlexLayout.Grow="1" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="12"
                            Opacity="0.7"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding CurrentIndex}" TextColor="{DynamicResource WikiAppPrimaryAccentColor}" FontAttributes="Bold" FontFamily="{DynamicResource DefaultFontFamily}" />
                                    <Span Text=" / " TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" FontFamily="{DynamicResource DefaultFontFamily}" />
                                    <Span Text="{Binding TotalQuestions}" TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" FontFamily="{DynamicResource DefaultFontFamily}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <!--  Timer bar  -->
                    <Grid
                        Margin="14,8,14,0"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <ProgressBar
                            Grid.Column="0"
                            HeightRequest="6"
                            Progress="{Binding TimerProgress}"
                            ProgressColor="{Binding TimerColor}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="12"
                            Text="{Binding TimerText}"
                            TextColor="{Binding TimerColor}"
                            VerticalOptions="Center"
                            WidthRequest="22"
                            HorizontalTextAlignment="End" />
                    </Grid>

                    <!--  Question card  -->
                    <Border
                        Margin="{OnIdiom Phone='14,10,14,0', Tablet='18,12,18,0', Default='14,10,14,0'}"
                        BackgroundColor="{DynamicResource WikiAppQuizCardBackgroundColor}"
                        Stroke="{DynamicResource WikiAppQuizCardBackgroundColor}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow
                                Brush="{DynamicResource WikiAppCardShadowColor}"
                                Offset="0,3"
                                Radius="10"
                                Opacity="0.4" />
                        </Border.Shadow>

                        <Grid
                            Padding="{OnIdiom Phone='12,12', Tablet='16,16', Default='12,12'}"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <!--  Portrait + name  -->
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="6"
                                VerticalOptions="Start"
                                WidthRequest="{OnIdiom Phone=100, Tablet=130, Default=100}">

                                <Border
                                    BackgroundColor="{DynamicResource WikiAppPersonaDetailProfileImageBg}"
                                    HeightRequest="{OnIdiom Phone=110, Tablet=140, Default=110}"
                                    Stroke="{DynamicResource WikiAppPrimaryAccentColor}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1.5"
                                    WidthRequest="{OnIdiom Phone=100, Tablet=130, Default=100}">
                                    <Grid>
                                        <local:ExtendedImage
                                            x:Name="imgList"
                                            Aspect="AspectFill"
                                            CustomSource="{Binding CurrentQuestion.MasterPicPath}"
                                            HeightRequest="{OnIdiom Phone=110, Tablet=140, Default=110}"
                                            ImageHeight="{Binding CurrentQuestion.MasterPicHeight}"
                                            ImageWidth="{Binding CurrentQuestion.MasterPicWidth}"
                                            PageCancellationTokenSource="{Binding PageCancellationTokenSource}"
                                            WidthRequest="{OnIdiom Phone=100, Tablet=130, Default=100}" />
                                        <sfCore:SfBusyIndicator
                                            HorizontalOptions="Center"
                                            IndicatorColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                            IsRunning="{Binding Source={x:Reference imgList}, Path=IsLoading}"
                                            IsVisible="{Binding Source={x:Reference imgList}, Path=IsLoading}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <Label
                                    Style="{StaticResource WikiAppQuizSmallCaptionLabelStyle}"
                                    Text="{Binding CurrentQuestion.MasterName}" />
                            </VerticalStackLayout>

                            <!--  Question text  -->
                            <Label
                                Grid.Column="1"
                                Style="{DynamicResource WikiAppQuizQuestionLabelStyle}"
                                Text="{Binding CurrentQuestion.Question}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!--  Answers  -->
                    <sfEffectsView:SfEffectsView
                        Margin="{OnIdiom Phone='14,10,14,0', Tablet='18,12,18,0', Default='14,10,14,0'}"
                        RippleAnimationDuration="250"
                        TouchDownEffects="Ripple"
                        TouchUpCommand="{Binding AnswerSelectedCommand}">
                        <sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                            <x:Int32>1</x:Int32>
                        </sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                        <Border
                            BackgroundColor="{Binding Answer1BackColor}"
                            Stroke="{DynamicResource WikiAppQuizCardBackgroundColor}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Label
                                x:Name="lblAnswer1Option"
                                Style="{DynamicResource WikiAppQuizAnswerLabelStyle}"
                                Text="{Binding Answer1}" />
                        </Border>
                    </sfEffectsView:SfEffectsView>

                    <sfEffectsView:SfEffectsView
                        Margin="{OnIdiom Phone='14,10,14,0', Tablet='18,12,18,0', Default='14,10,14,0'}"
                        RippleAnimationDuration="250"
                        TouchDownEffects="Ripple"
                        TouchUpCommand="{Binding AnswerSelectedCommand}">
                        <sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                            <x:Int32>2</x:Int32>
                        </sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                        <Border
                            BackgroundColor="{Binding Answer2BackColor}"
                            Stroke="{DynamicResource WikiAppQuizCardBackgroundColor}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Label
                                x:Name="lblAnswer2Option"
                                Style="{DynamicResource WikiAppQuizAnswerLabelStyle}"
                                Text="{Binding Answer2}" />
                        </Border>
                    </sfEffectsView:SfEffectsView>

                    <sfEffectsView:SfEffectsView
                        Margin="{OnIdiom Phone='14,10,14,0', Tablet='18,12,18,0', Default='14,10,14,0'}"
                        RippleAnimationDuration="250"
                        TouchDownEffects="Ripple"
                        TouchUpCommand="{Binding AnswerSelectedCommand}">
                        <sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                            <x:Int32>3</x:Int32>
                        </sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                        <Border
                            BackgroundColor="{Binding Answer3BackColor}"
                            Stroke="{DynamicResource WikiAppQuizCardBackgroundColor}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Label
                                x:Name="lblAnswer3Option"
                                Style="{DynamicResource WikiAppQuizAnswerLabelStyle}"
                                Text="{Binding Answer3}" />
                        </Border>
                    </sfEffectsView:SfEffectsView>

                    <sfEffectsView:SfEffectsView
                        Margin="{OnIdiom Phone='14,10,14,0', Tablet='18,12,18,0', Default='14,10,14,0'}"
                        RippleAnimationDuration="250"
                        TouchDownEffects="Ripple"
                        TouchUpCommand="{Binding AnswerSelectedCommand}">
                        <sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                            <x:Int32>4</x:Int32>
                        </sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                        <Border
                            BackgroundColor="{Binding Answer4BackColor}"
                            Stroke="{DynamicResource WikiAppQuizCardBackgroundColor}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Label
                                x:Name="lblAnswer4Option"
                                Style="{DynamicResource WikiAppQuizAnswerLabelStyle}"
                                Text="{Binding Answer4}" />
                        </Border>
                    </sfEffectsView:SfEffectsView>

                </VerticalStackLayout>
            </ScrollView>

            <!--  Fixed Next button row  -->
            <Grid
                Grid.Row="1"
                Margin="{OnIdiom Phone='14,8,14,12', Tablet='18,10,18,16', Default='14,8,14,12'}"
                ColumnSpacing="10"
                HeightRequest="{OnIdiom Phone=52, Tablet=64, Default=52}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="{OnIdiom Phone=130, Tablet=160, Default=130}" />
                </Grid.ColumnDefinitions>

                <sfCore:SfBusyIndicator
                    x:Name="busyIndicator"
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    IndicatorColor="{DynamicResource WikiAppPrimaryAccentColor}"
                    IsRunning="{Binding IsPageBusy}"
                    VerticalOptions="Center" />

                <sfButtons:SfButton
                    Grid.Column="2"
                    Command="{Binding NextQuestionCommand}"
                    CommandParameter="{x:Reference busyIndicator}"
                    IsEnabled="{Binding IsNextEnabled}"
                    Style="{DynamicResource WikiAppQuizNextButtonStyle}" />
            </Grid>

            <!--  Banner Ad  -->
            <ads:BannerAdView
                Grid.Row="2"
                AdSize="Banner"
                AdUnitId="{Binding BannerAdsUnitId}"
                BackgroundColor="Transparent"
                BannerType="Regular"
                HeightRequest="50"
                HorizontalOptions="Center"
                IsVisible="{Binding AdsEnabled}"
                VerticalOptions="Center" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
