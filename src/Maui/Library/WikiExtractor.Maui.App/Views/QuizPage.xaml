<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.QuizPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    xmlns:local="clr-namespace:WikiExtractor.Maui.App.Exts"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:sfEffectsView="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:stepProgressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar">
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Main Content with Background  -->
            <Grid Grid.Row="0" Background="{DynamicResource WikiAppQuizPageBackgroundGradientBrush}">
                <StackLayout>
                    <!--  Progress Bar  -->
                    <StackLayout Margin="0,15,0,15">
                        <stepProgressBar:SfLinearProgressBar
                            Progress="{Binding ProgressValue}"
                            ProgressFill="{DynamicResource WikiAppQuizProgressColor}"
                            SegmentCount="10"
                            TrackFill="{DynamicResource WikiAppQuizProgressTrackColor}" />
                    </StackLayout>

                    <StackLayout>
                        <Border Style="{DynamicResource TopBorderStyle}">
                            <Grid
                                Padding="12"
                                Background="{DynamicResource WikiAppQuizTopPanelBackgroundGradientBrush}"
                                ColumnDefinitions="Auto, *"
                                ColumnSpacing="15">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="4"
                                    VerticalOptions="Start"
                                    WidthRequest="120">

                                    <Grid HeightRequest="130" WidthRequest="120">

                                        <local:ExtendedImage
                                            x:Name="imgList"
                                            Aspect="AspectFit"
                                            CustomSource="{Binding CurrentQuestion.MasterPicPath}"
                                            HeightRequest="130"
                                            ImageHeight="{Binding CurrentQuestion.MasterPicHeight}"
                                            ImageWidth="{Binding CurrentQuestion.MasterPicWidth}"
                                            LocalFileName="{Binding CurrentQuestion.MasterPicLocalFileName}"
                                            PageCancellationTokenSource="{Binding PageCancellationTokenSource}"
                                            WidthRequest="120" />

                                        <sfCore:SfBusyIndicator
                                            HorizontalOptions="Center"
                                            IndicatorColor="{DynamicResource WikiAppQuizAnswerDefaultFontBackColor}"
                                            IsRunning="{Binding Source={x:Reference imgList}, Path=IsLoading}"
                                            IsVisible="{Binding Source={x:Reference imgList}, Path=IsLoading}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                    <Label Style="{StaticResource WikiAppQuizSmallCaptionLabelStyle}" Text="{Binding CurrentQuestion.MasterName}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="{DynamicResource WikiAppQuizQuestionBackColor}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Label Style="{DynamicResource WikiAppQuizQuestionLabelStyle}" Text="{Binding CurrentQuestion.Question}" />
                                </Border>

                            </Grid>
                        </Border>
                    </StackLayout>

                    <!--  Answers Section  -->
                    <ScrollView>
                        <StackLayout>
                            <!--  Question Counter Label  -->
                            <Label Style="{DynamicResource WikiAppQuizQuestionCounterLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Question " />
                                        <Span Text="(" />
                                        <Span Text="{Binding CurrentIndex}" />
                                        <Span Text="/" />
                                        <Span Text="{Binding TotalQuestions}" />
                                        <Span Text=") :" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Answer Buttons with SfEffectsView  -->
                            <sfEffectsView:SfEffectsView Style="{DynamicResource WikiAppQuizAnswerEffectStyle}" TouchUpCommand="{Binding AnswerSelectedCommand}">
                                <sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                                    <x:Int32>1</x:Int32>
                                </sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                                <Border StrokeShape="RoundRectangle 5">
                                    <Label
                                        x:Name="lblAnswer1Option"
                                        Background="{Binding Answer1BackColor}"
                                        Style="{DynamicResource WikiAppQuizAnswerLabelStyle}"
                                        Text="{Binding Answer1}" />
                                </Border>
                            </sfEffectsView:SfEffectsView>

                            <sfEffectsView:SfEffectsView Style="{DynamicResource WikiAppQuizAnswerEffectStyle}" TouchUpCommand="{Binding AnswerSelectedCommand}">
                                <sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                                    <x:Int32>2</x:Int32>
                                </sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                                <Border StrokeShape="RoundRectangle 5">
                                    <Label
                                        x:Name="lblAnswer2Option"
                                        BackgroundColor="{Binding Answer2BackColor}"
                                        Style="{DynamicResource WikiAppQuizAnswerLabelStyle}"
                                        Text="{Binding Answer2}" />
                                </Border>
                            </sfEffectsView:SfEffectsView>

                            <sfEffectsView:SfEffectsView Style="{DynamicResource WikiAppQuizAnswerEffectStyle}" TouchUpCommand="{Binding AnswerSelectedCommand}">
                                <sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                                    <x:Int32>3</x:Int32>
                                </sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                                <Border StrokeShape="RoundRectangle 5">
                                    <Label
                                        x:Name="lblAnswer3Option"
                                        BackgroundColor="{Binding Answer3BackColor}"
                                        Style="{DynamicResource WikiAppQuizAnswerLabelStyle}"
                                        Text="{Binding Answer3}" />
                                </Border>
                            </sfEffectsView:SfEffectsView>

                            <sfEffectsView:SfEffectsView Style="{DynamicResource WikiAppQuizAnswerEffectStyle}" TouchUpCommand="{Binding AnswerSelectedCommand}">
                                <sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                                    <x:Int32>4</x:Int32>
                                </sfEffectsView:SfEffectsView.TouchUpCommandParameter>
                                <Border StrokeShape="RoundRectangle 5">
                                    <Label
                                        x:Name="lblAnswer4Option"
                                        BackgroundColor="{Binding Answer4BackColor}"
                                        Style="{DynamicResource WikiAppQuizAnswerLabelStyle}"
                                        Text="{Binding Answer4}" />
                                </Border>
                            </sfEffectsView:SfEffectsView>

                            <!--  Bottom Controls  -->
                            <Grid Margin="{OnPlatform Android={OnIdiom Phone='0,10,0,0', Tablet='0,15,0,0'}, iOS={OnIdiom Phone='0,10,0,0', Tablet='0,15,0,0'}, WinUI={OnIdiom Phone='0,10,0,0', Tablet='0,15,0,0', Desktop='0,15,0,0'}, MacCatalyst='0,15,0,0'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=100, Tablet=200}, iOS={OnIdiom Phone=100, Tablet=200}, WinUI=200, MacCatalyst=200}" />
                                    <ColumnDefinition Width="10" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{OnPlatform Android={OnIdiom Phone=50, Tablet=80}, iOS={OnIdiom Phone=50, Tablet=80}, WinUI=80, MacCatalyst=80}" />
                                </Grid.RowDefinitions>

                                <sfCore:SfBusyIndicator
                                    x:Name="busyIndicator"
                                    Grid.Column="1"
                                    HeightRequest="{OnPlatform Android={OnIdiom Phone=50,
                                                                                Tablet=80},
                                                               iOS={OnIdiom Phone=50,
                                                                            Tablet=80},
                                                               WinUI=80,
                                                               MacCatalyst=80}"
                                    IsRunning="{Binding IsPageBusy}"
                                    WidthRequest="{OnPlatform Android={OnIdiom Phone=50,
                                                                               Tablet=80},
                                                              iOS={OnIdiom Phone=50,
                                                                           Tablet=80},
                                                              WinUI=80,
                                                              MacCatalyst=80}" />

                                <!--  Next Button  -->
                                <sfButtons:SfButton
                                    Grid.Column="3"
                                    Command="{Binding NextQuestionCommand}"
                                    CommandParameter="{x:Reference busyIndicator}"
                                    Style="{DynamicResource WikiAppQuizNextButtonStyle}" />
                            </Grid>
                        </StackLayout>
                    </ScrollView>
                </StackLayout>
            </Grid>

            <!--  Banner Ads Section  -->
            <StackLayout
                Grid.Row="1"
                Margin="5,5,5,5"
                HeightRequest="50"
                HorizontalOptions="Center"
                VerticalOptions="Fill">

                <ads:BannerAdView
                    AdSize="Banner"
                    AdUnitId="{Binding BannerAdsUnitId}"
                    BannerType="Regular"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>