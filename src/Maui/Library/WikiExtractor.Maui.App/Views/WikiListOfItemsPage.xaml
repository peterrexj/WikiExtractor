<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.WikiListOfItemsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WikiExtractor.Maui.App"
    xmlns:exts="clr-namespace:WikiExtractor.Maui.App.Exts"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:sfAutoComplete="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sfBusy="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:sfEffects="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    x:Name="ListViewPage"
    Shell.NavBarIsVisible="True">
    <Shell.TitleView>
        <Label
            BackgroundColor="Transparent"
            FontAttributes="Bold"
            FontSize="Title"
            HorizontalTextAlignment="Start"
            Text="{Binding Title}"
            TextColor="{DynamicResource WikiAppWhiteColor}"
            VerticalTextAlignment="Center" />
    </Shell.TitleView>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="0" IsEnabled="{Binding IsPageEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Search and Controls Section -->
            <FlexLayout Grid.Row="0">
                <Grid>
                    <Border Style="{DynamicResource TopBorderStyle}">
                        <Grid Padding="8,6,8,6">
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=35, Tablet=45}, iOS={OnIdiom Phone=35, Tablet=45}, WinUI={OnIdiom Phone=35, Default=45}}" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=140, Tablet=220}, iOS={OnIdiom Phone=140, Tablet=220}, WinUI=220, MacCatalyst=220}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{OnPlatform Android={OnIdiom Phone=40, Tablet=45}, iOS={OnIdiom Phone=40, Tablet=45}, WinUI={OnIdiom Phone=40, Tablet=45, Desktop=45}, Default=45}" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- SfAutoComplete -->
                                    <sfAutoComplete:SfAutocomplete
                                        x:Name="autoComplete"
                                        Grid.Column="0"
                                        TextSearchMode="Contains"
                                        Margin="2,0,2,0"
                                        BackgroundColor="{DynamicResource WikiAppSearchBackgroundColor}"
                                        TextColor="{DynamicResource WikiAppSearchTextColor}"
                                        PlaceholderColor="{DynamicResource WikiAppSearchPlaceholderColor}"
                                        Placeholder="Enter here to search"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                               Tablet=18},
                                                              iOS={OnIdiom Phone=12,
                                                                           Tablet=18},
                                                              WinUI={OnIdiom Phone=12,
                                                                            Default=18}}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        ItemsSource="{Binding AutocompleteList}"
                                        DisplayMemberPath="Name"
                                        MaxDropDownHeight="200"
                                        SelectionChanged="AutoComplete_SelectionChanged"
                                        Unfocused="AutoComplete_Unfocused" />
                                    
                                    <!-- SfButton for Theme -->
                                    <sfButtons:SfButton
                                        x:Name="btnThemePick"
                                        Grid.Column="1"
                                        Clicked="BtnThemePick_Clicked"
                                        Style="{DynamicResource ImageSmallRoundButton}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <core:SfButton.Content>
                                            <DataTemplate>
                                                <Grid>
                                                    <Image Source="wiki_theme_icon.png"></Image>
                                                </Grid>
                                            </DataTemplate>
                                        </core:SfButton.Content>
                                    </sfButtons:SfButton>
                                    
                                    
                                    <!-- SfButton for Take Quiz -->
                                    <sfButtons:SfButton
                                        x:Name="takeQuizButton"
                                        Grid.Column="3"
                                        IsVisible="{Binding IsNotBusy}"
                                        BackgroundColor="{DynamicResource WikiAppGreenColor}"
                                        Command="{Binding TakeQuizCommand}"
                                        CommandParameter="{x:Reference takeQuizButton}"
                                        Text="Take Quiz"
                                        TextColor="{DynamicResource WikiAppWhiteColor}"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                               Tablet=18},
                                                              iOS={OnIdiom Phone=12,
                                                                           Tablet=18},
                                                              WinUI=18,
                                                              MacCatalyst=18}" />
                                </Grid>
                            </StackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </FlexLayout>

            <!-- List section with proper containment -->
            <ScrollView
                Grid.Row="1"
                VerticalOptions="FillAndExpand"
                HorizontalOptions="FillAndExpand"
                Padding="5"
                Margin="0,10,0,0">

                <syncfusion:SfListView
                    x:Name="listOfItems"
                    BackgroundColor="Transparent"
                    IsEnabled="{Binding IsNotBusy}"
                    ItemsSource="{Binding Personas}"
                    SelectionMode="None"
                    AutoFitMode="DynamicHeight"
                    VerticalOptions="FillAndExpand"
                    HorizontalOptions="FillAndExpand">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <sfEffects:SfEffectsView
                                    x:Name="lstItemEffectsView"
                                    Margin="0,0,0,5"
                                    RippleAnimationDuration="300"
                                    TouchDownEffects="Ripple"
                                    AnimationCompleted="LstItemEffectsView_AnimationCompleted"
                                    AutomationId="{Binding Id}">
                                    <StackLayout>
                                        <Border Style="{DynamicResource ListItemBorderStyle}">
                                            <Grid Padding="8,10,8,10">
                                        <StackLayout>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.35*, Tablet=0.10*}, iOS={OnIdiom Phone=0.35*, Tablet=0.15*}, WinUI=0.15*, MacCatalyst=0.15*}" />
                                                    <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.65*, Tablet=0.90*}, iOS={OnIdiom Phone=0.65*, Tablet=0.85*}, WinUI=0.85*, MacCatalyst=*}" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Image
                                                        x:Name="imgList"
                                                        Grid.Row="0"
                                                        Margin="5,5,0,0"
                                                        Aspect="AspectFit"
                                                        HeightRequest="130"
                                                        HorizontalOptions="FillAndExpand"
                                                        VerticalOptions="Start"
                                                        WidthRequest="120" />
                                                        <!-- Source="{Binding PicturePrimaryPath}" -->
                                                    
                                                    <ActivityIndicator
                                                        Grid.Row="0"
                                                        IsRunning="{Binding IsLoading}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                                <Grid Grid.Column="1">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <StackLayout Grid.Row="0" 
                                                                 Padding="8,0,0,10">
                                                        <StackLayout.VerticalOptions>
                                                            <OnPlatform x:TypeArguments="LayoutOptions">
                                                                <On Platform="MacCatalyst" Value="CenterAndExpand" />
                                                            </OnPlatform>
                                                        </StackLayout.VerticalOptions>
                                                        <FlexLayout AlignContent="Start">
                                                            <Label
                                                                Padding="0,0,3,0"
                                                                FontAttributes="Bold"
                                                                FontSize="{OnPlatform Android={OnIdiom Phone=18,
                                                                                                       Tablet=22},
                                                                                      iOS={OnIdiom Phone=18,
                                                                                                   Tablet=22},
                                                                                      WinUI=22,
                                                                                      MacCatalyst=22}"
                                                                LineBreakMode="TailTruncation"
                                                                Text="{Binding Name}"
                                                                TextColor="{DynamicResource WikiAppBlackColor}" />
                                                            <ActivityIndicator
                                                                Margin="0,-5,0,0"
                                                                HeightRequest="{OnPlatform Android={OnIdiom Phone=30,
                                                                                                            Tablet=40},
                                                                                           iOS={OnIdiom Phone=30,
                                                                                                        Tablet=40},
                                                                                           WinUI=40,
                                                                                           MacCatalyst=40}"
                                                                IsRunning="{Binding IsLoading}"
                                                                IsVisible="{OnPlatform Android=true,
                                                                                       iOS=true,
                                                                                       WinUI=false,
                                                                                       MacCatalyst=false}"
                                                                Color="{DynamicResource WikiAppBlueColor}" />
                                                        </FlexLayout>
                                                    </StackLayout>
                                                    <Label
                                                        Grid.Row="1"
                                                        Margin="{OnPlatform Default='0,0,0,0',
                                                                            iOS={OnIdiom Default='0,0,5,0',
                                                                                         Tablet='0,0,5,0'}}"
                                                        Padding="8,0,0,0"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                               Tablet=16},
                                                                              iOS={OnIdiom Phone=11,
                                                                                           Tablet=16},
                                                                              WinUI=16,
                                                                              MacCatalyst=13}"
                                                        IsVisible="{Binding HidePrimaryContentMetadata}"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="{OnPlatform Android={OnIdiom Phone=6,
                                                                                               Tablet=4},
                                                                              iOS={OnIdiom Phone=6,
                                                                                           Tablet=4},
                                                                              WinUI=4,
                                                                              MacCatalyst=4}"
                                                        Text="{Binding MainContent}"
                                                        TextColor="{DynamicResource WikiAppBlackColor}" />

                                                    <!-- Metadata List using ExtendedListView -->
                                                    <exts:ExtendedListView
                                                        Grid.Row="1"
                                                        Margin="{OnPlatform Default='0,0,0,0',
                                                                            iOS={OnIdiom Default='0,0,5,0',
                                                                                         Tablet='0,0,5,0'}}"
                                                        Padding="8,0,0,10"
                                                        BackgroundColor="Transparent"
                                                        AutoFitMode="DynamicHeight"
                                                        HeightRequest="{Binding ListHeight}"
                                                        IsEnabled="False"
                                                        IsVisible="{Binding ShowPrimaryContentMetadata}"
                                                        ItemsSource="{Binding PrimaryMetadataContent}"
                                                        SelectionMode="None">
                                                        <exts:ExtendedListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <ViewCell>
                                                                    <ViewCell.View>
                                                                        <Grid>
                                                                            <StackLayout Orientation="Vertical" Spacing="0">
                                                                                <!-- Use a FlexLayout to allow wrapping of the key-value pair -->
                                                                                <FlexLayout
                                                                                    Direction="Row"
                                                                                    Wrap="Wrap"
                                                                                    AlignItems="Start"
                                                                                    JustifyContent="Start">
                                                                                    
                                                                                    <!-- Key Label (Bold) -->
                                                                                    <Label
                                                                                        FontAttributes="Bold"
                                                                                        FontSize="{OnIdiom Phone=11, Tablet=18}"
                                                                                        Text="{Binding Key}"
                                                                                        TextColor="{DynamicResource WikiAppBlackColor}"
                                                                                        LineBreakMode="WordWrap" />
                                                                                    
                                                                                    <!-- Colon separator -->
                                                                                    <Label
                                                                                        FontSize="{OnIdiom Phone=12, Tablet=18}"
                                                                                        Text=": "
                                                                                        TextColor="{DynamicResource WikiAppBlackColor}" />
                                                                                    
                                                                                    <!-- Description Label (Wrappable) -->
                                                                                    <Label
                                                                                        FontSize="{OnIdiom Phone=13, Tablet=18}"
                                                                                        Text="{Binding Description}"
                                                                                        TextColor="{DynamicResource WikiAppBlackColor}"
                                                                                        LineBreakMode="WordWrap"
                                                                                        FlexLayout.Grow="1" />
                                                                                </FlexLayout>
                                                                            </StackLayout>
                                                                        </Grid>
                                                                    </ViewCell.View>
                                                                </ViewCell>
                                                            </DataTemplate>
                                                        </exts:ExtendedListView.ItemTemplate>
                                                    </exts:ExtendedListView>
                                                </Grid>
                                            </Grid>
                                        </StackLayout>
                                    </Grid>
                                        </Border>
                                    </StackLayout>
                                </sfEffects:SfEffectsView>
                            </ViewCell>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>
            </ScrollView>
        </Grid>
        
        <!-- Banner Ad for Wiki List Page -->
        <StackLayout
            x:Name="stkBannerAdWikiList"
            Grid.Row="1"
            HeightRequest="60"
            HorizontalOptions="FillAndExpand"
            Margin="5,5,5,5"
            VerticalOptions="Fill">
            
            <ads:BannerAdView
                x:Name="bannerAdWikiList"
                AdUnitId="{Binding BannerAdUnitId}"
                AdSize="Banner"
                BannerType="Regular"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand"
                AdLoaded="OnBannerAdLoaded"
                AdFailedToLoad="OnBannerAdFailedToLoad"
                AdClicked="OnBannerAdClicked" />
        </StackLayout>
        
        <!-- Data Loading Overlay for WikiListOfItemsPage -->
        <Grid
            x:Name="loadingOverlay"
            Grid.RowSpan="2"
            IsVisible="{Binding IsDataLoading}"
            BackgroundColor="#80000000"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            ZIndex="1000">
            
            <Border
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="#DC143C"
                Stroke="{DynamicResource WikiAppLoadingCardBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="30,25,30,25"
                MinimumWidthRequest="{OnIdiom Phone=280, Tablet=320, Desktop=320}"
                MaximumWidthRequest="{OnIdiom Phone=320, Tablet=400, Desktop=400}">
                
                <Border.Shadow>
                    <Shadow
                        Brush="{DynamicResource WikiAppLoadingCardShadow}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.3" />
                </Border.Shadow>
                
                <StackLayout Spacing="20" HorizontalOptions="Center">
                    <!-- Loading Message -->
                    <Label
                        Text="{Binding LoadingMessage}"
                        TextColor="{DynamicResource WikiAppLoadingTextColor}"
                        FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=18}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                    
                    <!-- Subtitle -->
                    <Label
                        Text="Please wait while we prepare your content..."
                        TextColor="{DynamicResource WikiAppLoadingSubtitleColor}"
                        FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=14}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />
                </StackLayout>
            </Border>
        </Grid>

        <!-- Navigation Loading Overlay for WikiListOfItemsPage -->
        <Grid
            x:Name="navigationLoadingOverlay"
            Grid.RowSpan="2"
            IsVisible="{Binding IsNavigating}"
            BackgroundColor="#80000000"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            ZIndex="1001">
            
            <Border
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="#DC143C"
                Stroke="{DynamicResource WikiAppLoadingCardBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="30,25,30,25"
                MinimumWidthRequest="{OnIdiom Phone=280, Tablet=320, Desktop=320}"
                MaximumWidthRequest="{OnIdiom Phone=320, Tablet=400, Desktop=400}">
                
                <Border.Shadow>
                    <Shadow
                        Brush="{DynamicResource WikiAppLoadingCardShadow}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.3" />
                </Border.Shadow>
                
                <StackLayout Spacing="20" HorizontalOptions="Center">
                    <!-- Navigation Message -->
                    <Label
                        Text="{Binding NavigationMessage}"
                        TextColor="{DynamicResource WikiAppLoadingTextColor}"
                        FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=18}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                    
                    <!-- Navigation Subtitle -->
                    <Label
                        Text="Navigating to details page..."
                        TextColor="{DynamicResource WikiAppLoadingSubtitleColor}"
                        FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=14}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />
                </StackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>