<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.WikiListOfItemsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:exts="clr-namespace:WikiExtractor.Maui.App.Exts"
    xmlns:local="clr-namespace:WikiExtractor.Maui.App"
    xmlns:localControls="clr-namespace:WikiExtractor.Maui.App.Controls"
    xmlns:sfAutoComplete="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sfBusy="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:sfEffects="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    x:Name="ListViewPage"
    Shell.NavBarIsVisible="True">
    <Shell.TitleView>
        <Label
            BackgroundColor="Transparent"
            FontAttributes="Bold"
            FontSize="Title"
            HorizontalTextAlignment="Start"
            Text="Popes"
            TextColor="{DynamicResource WikiAppTitleTextColor}"
            VerticalTextAlignment="Center" />
    </Shell.TitleView>
    <Grid Style="{DynamicResource WikiAppPageBackgroundGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Main Content Area  -->
        <Grid Grid.Row="0" IsEnabled="{Binding IsPageEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Search and Controls Section  -->
            <FlexLayout Grid.Row="0">
                <Grid>
                    <Border Style="{DynamicResource TopBorderStyle}">
                        <Grid Padding="8,6,8,6">
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=35, Tablet=45}, iOS={OnIdiom Phone=35, Tablet=45}, WinUI={OnIdiom Phone=35, Default=45}}" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=35, Tablet=45}, iOS={OnIdiom Phone=35, Tablet=45}, WinUI={OnIdiom Phone=35, Default=45}}" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=100, Tablet=220}, iOS={OnIdiom Phone=100, Tablet=220}, WinUI=220, MacCatalyst=220}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{OnPlatform Android={OnIdiom Phone=40, Tablet=45}, iOS={OnIdiom Phone=40, Tablet=45}, WinUI={OnIdiom Phone=40, Tablet=45, Desktop=45}, Default=45}" />
                                    </Grid.RowDefinitions>

                                    <!--  SfAutoComplete  -->
                                    <!--<sfAutoComplete:SfAutocomplete
                                        x:Name="autoComplete"
                                        Grid.Column="0"
                                        Margin="2,0,2,0"
                                        BackgroundColor="Transparent"
                                        Completed="autoComplete_Completed"
                                        DisplayMemberPath="Name"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                               Tablet=18},
                                                              iOS={OnIdiom Phone=12,
                                                                           Tablet=18},
                                                              WinUI={OnIdiom Phone=12,
                                                                             Default=18}}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        ItemsSource="{Binding AutocompleteList}"
                                        MaxDropDownHeight="200"
                                        Placeholder="Enter here to search"
                                        PlaceholderColor="{DynamicResource WikiAppSearchPlaceholderColor}"
                                        SelectionChanged="AutoComplete_SelectionChanged"
                                        Stroke="Transparent"
                                        TextColor="{DynamicResource WikiAppSearchTextColor}"
                                        TextSearchMode="Contains"
                                        Unfocused="AutoComplete_Unfocused" />-->

                                    <sfAutoComplete:SfAutocomplete
                                        x:Name="autoComplete"
                                        Grid.Column="0"
                                        Margin="2,0,2,0"
                                        BackgroundColor="Transparent"
                                        ClearButtonIconColor="{DynamicResource WikiAppAutoCompleteClearButtonColor}"
                                        DisplayMemberPath="Name"
                                        DropDownBackground="{DynamicResource WikiAppAutoCompleteDropdownBackgroundColor}"
                                        DropDownItemFontFamily="{DynamicResource DefaultFontFamily}"
                                        DropDownItemFontSize="{OnIdiom Phone=14,
                                                                       Tablet=19,
                                                                       Desktop=19,
                                                                       TV=19,
                                                                       Watch=12,
                                                                       Default=14}"
                                        DropDownItemTextColor="{DynamicResource WikiAppAutoCompleteDropdownTextColor}"
                                        DropDownStroke="Transparent"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                               Tablet=18},
                                                              iOS={OnIdiom Phone=12,
                                                                           Tablet=18},
                                                              WinUI={OnIdiom Phone=12,
                                                                             Default=18}}"
                                        HighlightedTextColor="{DynamicResource WikiAppAutoCompleteHighlightedTextColor}"
                                        HighlightedTextFontAttributes="Bold"
                                        IsClearButtonVisible="True"
                                        IsEnabled="{Binding IsNotBusy}"
                                        ItemsSource="{Binding AutocompleteList}"
                                        MaxDropDownHeight="200"
                                        MinimumPrefixCharacters="2"
                                        Placeholder="Enter here to search"
                                        PlaceholderColor="{DynamicResource WikiAppSearchPlaceholderColor}"
                                        SelectedDropDownItemBackground="{DynamicResource WikiAppAutoCompleteSelectedDropDownItemBackground}"
                                        SelectionChanged="autoComplete_SelectionChanged"
                                        SelectionMode="Single"
                                        SelectionTextHighlightColor="{DynamicResource WikiAppAutoCompleteSelectionTextHighlightColor}"
                                        ShowBorder="False"
                                        Stroke="Transparent"
                                        TextColor="{DynamicResource WikiAppSearchTextColor}"
                                        TextHighlightMode="MultipleOccurrence"
                                        TextSearchMode="Contains"
                                        Unfocused="autoComplete_Unfocused"
                                        ValueChanged="autoComplete_ValueChanged">

                                        <!--<sfAutoComplete:SfAutocomplete.NoResultsFoundTemplate>
                                            <DataTemplate>
                                                <Label
                                                    Margin="70,10,0,0"
                                                    FontAttributes="Italic"
                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                    FontSize="{OnIdiom Phone=16,
                                                                       Tablet=21,
                                                                       Desktop=21,
                                                                       TV=21,
                                                                       Watch=14,
                                                                       Default=16}"
                                                    Text="Not Found"
                                                    TextColor="{DynamicResource WikiAppAutoCompleteNoResultsFoundTextColor}" />
                                            </DataTemplate>
                                        </sfAutoComplete:SfAutocomplete.NoResultsFoundTemplate>-->

                                    </sfAutoComplete:SfAutocomplete>

                                    <!--  SfButton for Theme  -->
                                    <sfButtons:SfButton
                                        x:Name="btnThemePick"
                                        Grid.Column="1"
                                        Clicked="BtnThemePick_Clicked"
                                        HorizontalOptions="Center"
                                        Style="{DynamicResource ImageSmallRoundButton}"
                                        VerticalOptions="Center">
                                        <core:SfButton.Content>
                                            <DataTemplate>
                                                <Grid>
                                                    <Image Source="theme_icon.png" />
                                                </Grid>
                                            </DataTemplate>
                                        </core:SfButton.Content>
                                    </sfButtons:SfButton>

                                    <!--  SfButton for Settings  -->
                                    <sfButtons:SfButton
                                        x:Name="btnSettings"
                                        Grid.Column="3"
                                        Clicked="BtnSettings_Clicked"
                                        HorizontalOptions="Center"
                                        Style="{DynamicResource ImageSmallRoundButton}"
                                        VerticalOptions="Center">
                                        <core:SfButton.Content>
                                            <DataTemplate>
                                                <Grid>
                                                    <Label
                                                        FontFamily="FontAwesome"
                                                        FontSize="{OnIdiom Phone=18,
                                                                           Tablet=24,
                                                                           Desktop=24,
                                                                           Default=18}"
                                                        HorizontalOptions="Center"
                                                        Text="&#xf013;"
                                                        TextColor="{DynamicResource WikiAppIconColor}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </core:SfButton.Content>
                                    </sfButtons:SfButton>


                                    <!--  SfButton for Take Quiz  -->
                                    <sfButtons:SfButton
                                        x:Name="takeQuizButton"
                                        Grid.Column="5"
                                        Command="{Binding TakeQuizCommand}"
                                        CommandParameter="{x:Reference takeQuizButton}"
                                        IsVisible="{Binding IsNotBusy}"
                                        Style="{DynamicResource WikiAppQuizTakeButtonStyle}" />
                                </Grid>
                            </StackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </FlexLayout>

            <syncfusion:SfListView
                x:Name="listOfItems"
                Grid.Row="1"
                Margin="5,5,5,5"
                AutoFitMode="DynamicHeight"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                IsEnabled="{Binding IsNotBusy}"
                ItemsSource="{Binding Personas}"
                SelectionMode="None"
                VerticalOptions="Fill">
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <sfEffects:SfEffectsView
                            Margin="0,0,0,5"
                            AutomationId="{Binding Id}"
                            RippleAnimationDuration="300"
                            TouchDownEffects="Ripple"
                            TouchUp="itemOnList_TouchUp">
                            <Border Style="{DynamicResource ListItemBorderStyle}">
                                <Grid Padding="7,8,7,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.35*, Tablet=0.10*}, iOS={OnIdiom Phone=0.35*, Tablet=0.15*}, WinUI=0.15*, MacCatalyst=0.15*}" />
                                        <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.65*, Tablet=0.90*}, iOS={OnIdiom Phone=0.65*, Tablet=0.85*}, WinUI=0.85*, MacCatalyst=*}" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalOptions="Start">
                                        <Image
                                            x:Name="imgList"
                                            Margin="5,5,5,0"
                                            Aspect="AspectFit"
                                            HeightRequest="130"
                                            Source="{Binding PicturePrimaryPath}"
                                            WidthRequest="120" />
                                        <ActivityIndicator
                                            HorizontalOptions="Center"
                                            IsRunning="{Binding IsLoading}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="5,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackLayout Grid.Row="0">
                                            <StackLayout.VerticalOptions>
                                                <OnPlatform x:TypeArguments="LayoutOptions">
                                                    <On Platform="MacCatalyst" Value="CenterAndExpand" />
                                                </OnPlatform>
                                            </StackLayout.VerticalOptions>
                                            <FlexLayout AlignContent="Start">
                                                <Label
                                                    Padding="0,0,0,0"
                                                    FontAttributes="Bold"
                                                    FontSize="{OnPlatform Android={OnIdiom Phone=18,
                                                                                           Tablet=22},
                                                                          iOS={OnIdiom Phone=18,
                                                                                       Tablet=22},
                                                                          WinUI=22,
                                                                          MacCatalyst=22}"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Name}"
                                                    TextColor="{DynamicResource WikiAppListItemHeaderTextColor}" />
                                                <ActivityIndicator
                                                    Margin="0,-5,0,0"
                                                    HeightRequest="{OnPlatform Android={OnIdiom Phone=30,
                                                                                                Tablet=40},
                                                                               iOS={OnIdiom Phone=30,
                                                                                            Tablet=40},
                                                                               WinUI=40,
                                                                               MacCatalyst=40}"
                                                    IsRunning="{Binding IsLoading}"
                                                    IsVisible="{OnPlatform Android=true,
                                                                           iOS=true,
                                                                           WinUI=false,
                                                                           MacCatalyst=false}"
                                                    Color="{DynamicResource WikiAppListItemHeaderTextColor}" />
                                            </FlexLayout>
                                        </StackLayout>
                                        <Label
                                            Grid.Row="1"
                                            Margin="{OnPlatform Default='0,0,0,0',
                                                                iOS={OnIdiom Default='0,0,5,0',
                                                                             Tablet='0,0,5,0'}}"
                                            Padding="8,0,0,0"
                                            FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                   Tablet=16},
                                                                  iOS={OnIdiom Phone=11,
                                                                               Tablet=16},
                                                                  WinUI=16,
                                                                  MacCatalyst=13}"
                                            IsVisible="{Binding HidePrimaryContentMetadata}"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="{OnPlatform Android={OnIdiom Phone=6,
                                                                                   Tablet=4},
                                                                  iOS={OnIdiom Phone=6,
                                                                               Tablet=4},
                                                                  WinUI=4,
                                                                  MacCatalyst=4}"
                                            Text="{Binding MainContent}"
                                            TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" />

                                        <!--  Metadata List using ExtendedListView  -->
                                        <VerticalStackLayout
                                            Grid.Row="1"
                                            BindableLayout.ItemsSource="{Binding PrimaryMetadataContent}"
                                            IsVisible="{Binding ShowPrimaryContentMetadata}"
                                            Spacing="-5">

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Margin="0,0,0,2" LineBreakMode="WordWrap">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span
                                                                    FontAttributes="Bold"
                                                                    FontSize="13"
                                                                    Text="{Binding Key}"
                                                                    TextColor="{DynamicResource WikiAppListItemKeyTextColor}" />
                                                                <Span Text=": " TextColor="{DynamicResource WikiAppListItemKeyTextColor}" />
                                                                <Span
                                                                    FontSize="13"
                                                                    Text="{Binding Description}"
                                                                    TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </sfEffects:SfEffectsView>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>
        </Grid>

        <!--  Banner Ad for Wiki List Page  -->
        <!--<localControls:BannerAdControl Grid.Row="1" AdUnitId="{Binding BannerAdsUnitId}"/>-->
        <StackLayout
            Grid.Row="1"
            Margin="5,5,5,5"
            HeightRequest="50"
            HorizontalOptions="Center"
            VerticalOptions="Fill">

            <ads:BannerAdView
                AdSize="Banner"
                AdUnitId="{Binding BannerAdsUnitId}"
                BannerType="Regular"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />
        </StackLayout>

        <!--  Data Loading Facts Control for WikiListOfItemsPage  -->
        <localControls:LoadingFactsControl
            x:Name="loadingFactsControl"
            Grid.RowSpan="2"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            ZIndex="1000" />

        <!--  Navigation Loading Facts Control for WikiListOfItemsPage  -->
        <localControls:LoadingFactsControl
            x:Name="navigationLoadingFactsControl"
            Grid.RowSpan="2"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            ZIndex="1001" />

    </Grid>
</ContentPage>