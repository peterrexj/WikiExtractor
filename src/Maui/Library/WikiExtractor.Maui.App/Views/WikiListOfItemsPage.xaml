<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.WikiListOfItemsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:exts="clr-namespace:WikiExtractor.Maui.App.Exts"
    xmlns:local="clr-namespace:WikiExtractor.Maui.App"
    xmlns:localControls="clr-namespace:WikiExtractor.Maui.App.Controls"
    xmlns:svc="clr-namespace:WikiExtractor.Maui.App.Services"
    xmlns:sfAutoComplete="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converters="clr-namespace:WikiExtractor.Maui.App.Converters"
    xmlns:vm="clr-namespace:WikiExtractor.Maui.App.ViewModels"
    xmlns:wvm="clr-namespace:WikiExtractor.ViewModels"
    x:DataType="vm:PersonaListViewModel"
    x:Name="ListViewPage"
    BackgroundColor="{DynamicResource WikiAppDefaultBackgroundColor}"
    Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <converters:ImagePathToSourceConverter x:Key="ImagePathConverter" />
    </ContentPage.Resources>

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <Border
                BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                HeightRequest="34"
                Padding="3"
                StrokeShape="RoundRectangle 10"
                Stroke="Transparent"
                VerticalOptions="Center"
                WidthRequest="34">
                <Image
                    Aspect="AspectFit"
                    Source="{Binding Source={x:Static svc:SharedServices.AppInfo}, Path=HeaderIcon}"
                    HeightRequest="28"
                    WidthRequest="28"
                    VerticalOptions="Center"
                    HorizontalOptions="Center" />
            </Border>
            <Label
                x:Name="lblNavTitle"
                CharacterSpacing="1.5"
                FontAttributes="Bold"
                FontFamily="{DynamicResource DefaultFontFamily}"
                FontSize="Title"
                TextColor="{DynamicResource WikiAppTitleTextColor}"
                VerticalTextAlignment="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid Style="{DynamicResource WikiAppPageBackgroundGridStyle}"
          IgnoreSafeArea="{OnPlatform iOS=True, Default=False}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" IsEnabled="{Binding IsPageEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Toolbar: single-row card with search, quiz, theme, settings  -->
            <Border
                Grid.Row="0"
                Margin="6,8,6,4"
                Background="{DynamicResource WikiAppTopPanelGradientBrush}"
                Padding="10,8,10,8"
                Stroke="{DynamicResource WikiAppTopPanelBorderColor}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,3" Radius="8" Opacity="1" />
                </Border.Shadow>

                <Grid x:Name="toolbarGrid" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>

                    <!--  Search pill  -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource WikiAppAutoCompleteDropdownBackgroundColor}"
                        HeightRequest="44"
                        Padding="12,0,4,0"
                        Stroke="{DynamicResource WikiAppAutoCompleteDropdownBorderColor}"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                            <Label
                                Grid.Column="0"
                                FontFamily="FontAwesome"
                                FontSize="15"
                                Text="&#xf002;"
                                TextColor="{DynamicResource WikiAppAutoCompleteWaterColor}"
                                VerticalOptions="Center" />
                            <sfAutoComplete:SfAutocomplete
                                x:Name="autoComplete"
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                DisplayMemberPath="Name"
                                Focused="autoComplete_Focused"
                                IsClearButtonVisible="False"
                                IsEnabled="{Binding IsNotBusy}"
                                ItemsSource="{Binding AutocompleteList}"
                                Margin="0"
                                SelectionChanged="autoComplete_SelectionChanged"
                                Stroke="Transparent"
                                Style="{DynamicResource SfAutocompleteStyle}"
                                Unfocused="autoComplete_Unfocused"
                                ValueChanged="autoComplete_ValueChanged" />
                            <!--  Always-visible clear button  -->
                            <Label
                                x:Name="btnClearSearch"
                                Grid.Column="2"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                Text="&#xf057;"
                                TextColor="{DynamicResource WikiAppAutoCompleteWaterColor}"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Padding="6,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btnClearSearch_Tapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <!--  Quiz button  -->
                    <Grid
                        x:Name="quizButtonContainer"
                        Grid.Column="1">
                    <sfButtons:SfButton
                        x:Name="takeQuizButton"
                        Command="{Binding TakeQuizCommand}"
                        CommandParameter="{x:Reference takeQuizButton}"
                        IsVisible="{Binding IsNotBusy}"
                        HeightRequest="36"
                        FontSize="{OnPlatform Android={OnIdiom Phone=10, Tablet=16}, iOS={OnIdiom Phone=10, Tablet=16}, WinUI=16, MacCatalyst=16}"
                        VerticalOptions="Center"
                        Style="{DynamicResource WikiAppQuizTakeButtonStyle}" />
                    </Grid>

                    <!--  Theme button  -->
                    <Grid
                        x:Name="themeButtonContainer"
                        Grid.Column="2"
                        HeightRequest="32"
                        WidthRequest="32">
                        <Border
                            BackgroundColor="{DynamicResource WikiAppTopPanelBackgroundColor}"
                            HeightRequest="32"
                            WidthRequest="32"
                            Stroke="{DynamicResource WikiAppTopPanelBorderColor}"
                            StrokeShape="RoundRectangle 9"
                            StrokeThickness="1">
                            <sfButtons:SfButton
                                x:Name="btnThemePick"
                                Background="Transparent"
                                Clicked="BtnThemePick_Clicked"
                                CornerRadius="9"
                                IsEnabled="True"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                                <core:SfButton.Content>
                                    <DataTemplate>
                                        <Image
                                            HeightRequest="15"
                                            HorizontalOptions="Center"
                                            Source="theme_icon.png"
                                            VerticalOptions="Center"
                                            WidthRequest="15" />
                                    </DataTemplate>
                                </core:SfButton.Content>
                            </sfButtons:SfButton>
                        </Border>
                        <ActivityIndicator
                            x:Name="themeSpinner"
                            HeightRequest="14"
                            WidthRequest="14"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Color="{DynamicResource WikiAppPrimaryAccentColor}"
                            IsRunning="{Binding Source={x:Reference themeSpinner}, Path=IsVisible}"
                            IsVisible="False"
                            InputTransparent="True" />
                    </Grid>

                    <!--  Settings button  -->
                    <Border
                        x:Name="settingsButtonContainer"
                        Grid.Column="3"
                        BackgroundColor="{DynamicResource WikiAppTopPanelBackgroundColor}"
                        HeightRequest="32"
                        WidthRequest="32"
                        Stroke="{DynamicResource WikiAppTopPanelBorderColor}"
                        StrokeShape="RoundRectangle 9"
                        StrokeThickness="1">
                        <sfButtons:SfButton
                            x:Name="btnSettings"
                            Background="Transparent"
                            Clicked="BtnSettings_Clicked"
                            CornerRadius="9"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">
                            <core:SfButton.Content>
                                <DataTemplate>
                                    <Label
                                        FontFamily="FontAwesome"
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="&#xf013;"
                                        TextColor="{DynamicResource WikiAppIconColor}"
                                        VerticalOptions="Center" />
                                </DataTemplate>
                            </core:SfButton.Content>
                        </sfButtons:SfButton>
                    </Border>

                    <!--  Favourites filter button  -->
                    <Border
                        x:Name="btnFavouritesFilter"
                        Grid.Column="4"
                        HeightRequest="32"
                        WidthRequest="32"
                        Stroke="{DynamicResource WikiAppTopPanelBorderColor}"
                        StrokeShape="RoundRectangle 9"
                        StrokeThickness="1">
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding ShowFavouritesOnly}" TargetType="Border" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource WikiAppPrimaryAccentColor}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowFavouritesOnly}" TargetType="Border" Value="False">
                                <Setter Property="BackgroundColor" Value="{DynamicResource WikiAppTopPanelBackgroundColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BtnFavouritesFilter_Clicked" />
                        </Border.GestureRecognizers>
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="&#xf004;"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding ShowFavouritesOnly}" TargetType="Label" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowFavouritesOnly}" TargetType="Label" Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource WikiAppIconColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!--  Shuffle / Surprise Me button  -->
                    <Border
                        x:Name="btnShuffleItem"
                        Grid.Column="5"
                        BackgroundColor="{DynamicResource WikiAppTopPanelBackgroundColor}"
                        HeightRequest="32"
                        WidthRequest="32"
                        Stroke="{DynamicResource WikiAppTopPanelBorderColor}"
                        StrokeShape="RoundRectangle 9"
                        StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BtnShuffleItem_Clicked" />
                        </Border.GestureRecognizers>
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="&#xf074;"
                            TextColor="{DynamicResource WikiAppIconColor}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!--  Offline indicator row — sits between toolbar and list  -->
            <Border
                Grid.Row="1"
                Margin="{OnIdiom Phone='10,2,10,4', Tablet='14,2,14,6', Default='10,2,10,4'}"
                Padding="{OnIdiom Phone='12,7', Tablet='16,9', Default='12,7'}"
                BackgroundColor="#1AFF5252"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsOffline}"
                Stroke="#FF5252"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Label
                        Grid.Column="0"
                        FontFamily="FontAwesome"
                        FontSize="{OnIdiom Phone=14, Tablet=20, Default=20}"
                        Text="&#xf1eb;"
                        TextColor="#FF5252"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontFamily="{DynamicResource DefaultFontFamily}"
                        FontSize="{OnIdiom Phone=13, Tablet=19, Default=19}"
                        FontAttributes="Bold"
                        Text="No internet connection"
                        TextColor="#FF5252"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  List  -->
            <CollectionView
                x:Name="listOfItems"
                Grid.Row="2"
                BackgroundColor="Transparent"
                IsEnabled="{Binding IsNotBusy}"
                ItemsSource="{Binding FilteredPersonas}"
                ItemSizingStrategy="MeasureFirstItem"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <BoxView HeightRequest="4" Color="Transparent" />
                </CollectionView.Header>

                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Margin="24"
                        HorizontalOptions="Center"
                        Spacing="10"
                        VerticalOptions="Center">

                        <!--  Loading state  -->
                        <Image
                            IsVisible="{Binding IsDataLoading}"
                            Source="{Binding Source={x:Static svc:SharedServices.AppInfo}, Path=HeaderIcon}"
                            HeightRequest="72"
                            WidthRequest="72"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            Opacity="0.6" />
                        <Label
                            IsVisible="{Binding IsDataLoading}"
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="17"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Loading..."
                            TextColor="{DynamicResource WikiAppListItemHeaderTextColor}" />
                        <Label
                            IsVisible="{Binding IsDataLoading}"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="13"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Please wait a moment. Pull down to refresh if data does not appear."
                            TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" />

                        <!--  Filter returned no results  -->
                        <Label
                            IsVisible="{Binding HasSearchText}"
                            FontFamily="FontAwesome"
                            FontSize="48"
                            HorizontalOptions="Center"
                            Text="&#xf002;"
                            TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" />
                        <Label
                            IsVisible="{Binding HasSearchText}"
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="17"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="No results"
                            TextColor="{DynamicResource WikiAppListItemHeaderTextColor}" />
                        <Label
                            IsVisible="{Binding HasSearchText}"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="13"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Try a different filter"
                            TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="wvm:PersonaViewModel">
                        <!--  Outer card  -->
                        <Border
                            Margin="0,0,14,12"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Style="{DynamicResource ListItemBorderStyle}">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding Id}"
                                    Tapped="itemOnList_Tapped" />
                            </Border.GestureRecognizers>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=110, Tablet=130}, iOS={OnIdiom Phone=110, Tablet=130}, WinUI=130, MacCatalyst=130}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Inner image card — rounded on left to match outer card  -->
                                <Border
                                    Grid.Column="0"
                                    Padding="0"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 0"
                                    BackgroundColor="{DynamicResource WikiAppPersonaDetailProfileImageBg}">
                                    <Grid>
                                        <exts:ExtendedImage
                                            Aspect="AspectFill"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            CustomSource="{Binding PicturePrimaryPath}" />

                                        <!--  Read badge — shown when item has been read  -->
                                        <Border
                                            Margin="6"
                                            BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                            HeightRequest="22"
                                            HorizontalOptions="End"
                                            IsVisible="{Binding ItemReadStatus}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 11"
                                            StrokeThickness="0"
                                            VerticalOptions="Start"
                                            WidthRequest="22">
                                            <Border.Shadow>
                                                <Shadow Brush="#80000000" Offset="0,1" Radius="4" Opacity="0.6" />
                                            </Border.Shadow>
                                            <Label
                                                FontFamily="FontAwesome"
                                                FontSize="11"
                                                HorizontalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                InputTransparent="True"
                                                Text="&#xf00c;"
                                                TextColor="White"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>

                                        <!--  Favourite badge — shown when item is favourited  -->
                                        <Border
                                            Margin="6"
                                            BackgroundColor="#E53935"
                                            HeightRequest="22"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding IsFavourite}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 11"
                                            StrokeThickness="0"
                                            VerticalOptions="Start"
                                            WidthRequest="22">
                                            <Border.Shadow>
                                                <Shadow Brush="#80000000" Offset="0,1" Radius="4" Opacity="0.6" />
                                            </Border.Shadow>
                                            <Label
                                                FontFamily="FontAwesome"
                                                FontSize="10"
                                                HorizontalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                InputTransparent="True"
                                                Text="&#xf004;"
                                                TextColor="White"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>

                                        <!--  Heart tap target — fills image area to toggle favourite  -->
                                        <Border
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Fill"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            VerticalOptions="Fill">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    CommandParameter="{Binding Id}"
                                                    Tapped="heartOnListItem_Tapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!--  Content  -->
                                <Grid Grid.Column="1" Padding="14,12,14,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        Grid.Row="0"
                                        CharacterSpacing="0.3"
                                        FontAttributes="Bold"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=17, Tablet=24}, iOS={OnIdiom Phone=17, Tablet=24}, WinUI=24, MacCatalyst=24}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Name}"
                                        TextColor="{DynamicResource WikiAppListItemHeaderTextColor}" />

                                    <BoxView
                                        Grid.Row="1"
                                        Margin="0,6,0,6"
                                        BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                        HeightRequest="1.5"
                                        HorizontalOptions="Fill"
                                        Opacity="0.4" />

                                    <Label
                                        Grid.Row="2"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnPlatform Android={OnIdiom Phone=13, Tablet=19}, iOS={OnIdiom Phone=12, Tablet=19}, WinUI=19, MacCatalyst=19}"
                                        IsVisible="{Binding HidePrimaryContentMetadata}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding MainContent}"
                                        TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" />

                                    <VerticalStackLayout
                                        Grid.Row="2"
                                        BindableLayout.ItemsSource="{Binding PrimaryMetadataContent}"
                                        IsVisible="{Binding ShowPrimaryContentMetadata}"
                                        Spacing="3">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="wvm:MetadataViewModel">
                                                <Label LineBreakMode="WordWrap">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontAttributes="Bold"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{OnIdiom Phone=13, Tablet=19, Default=19}"
                                                                Text="{Binding Key}"
                                                                TextColor="{DynamicResource WikiAppListItemKeyTextColor}" />
                                                            <Span FontFamily="{DynamicResource DefaultFontFamily}" FontSize="{OnIdiom Phone=13, Tablet=19, Default=19}" Text=": " TextColor="{DynamicResource WikiAppListItemKeyTextColor}" />
                                                            <Span
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{OnIdiom Phone=13, Tablet=19, Default=19}"
                                                                Text="{Binding Description}"
                                                                TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!--  Banner Ad  -->
        <ads:BannerAdView
            Grid.Row="1"
            AdSize="Banner"
            AdUnitId="{Binding BannerAdsUnitId}"
            BannerType="Regular"
            HeightRequest="50"
            HorizontalOptions="Center"
            VerticalOptions="Center" />


        <!--  Streak toast banner  -->
        <Border
            x:Name="streakBanner"
            Grid.RowSpan="2"
            Margin="16,12,16,0"
            Padding="16,12"
            BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
            HorizontalOptions="Fill"
            InputTransparent="True"
            IsVisible="False"
            Stroke="{DynamicResource WikiAppPrimaryAccentColor}"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="1.5"
            VerticalOptions="Start"
            ZIndex="999">
            <Border.Shadow>
                <Shadow Brush="#50000000" Offset="0,4" Radius="12" Opacity="1" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                <Label
                    x:Name="streakBannerIcon"
                    Grid.Column="0"
                    FontFamily="FontAwesome"
                    FontSize="{OnIdiom Phone=22, Tablet=32, Default=32}"
                    Text="&#xf46d;"
                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                    VerticalOptions="Center" />
                <Label
                    x:Name="streakBannerText"
                    Grid.Column="1"
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{OnIdiom Phone=14, Tablet=20, Default=20}"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!--  Loading overlays — disabled, kept for re-enable if needed
        <localControls:LoadingFactsControl
            x:Name="loadingFactsControl"
            Grid.RowSpan="2"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            ZIndex="1000" />

        <localControls:LoadingFactsControl
            x:Name="navigationLoadingFactsControl"
            Grid.RowSpan="2"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            ZIndex="1001" />
        -->

    </Grid>
</ContentPage>
