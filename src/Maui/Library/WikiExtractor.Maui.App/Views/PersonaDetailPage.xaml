<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.PersonaDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:local="clr-namespace:WikiExtractor.Maui.App.Exts"
    xmlns:localControls="clr-namespace:WikiExtractor.Maui.App.Controls"
    xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
    xmlns:sfList="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!--  Create instances of the separate DataTemplate classes  -->
            <localControls:Header2ListItemTemplate x:Key="Header2ListItemTemplate" />
            <localControls:Header3ListItemTemplate x:Key="Header3ListItemTemplate" />
            <localControls:ParagraphContentListItemTemplate x:Key="ParagraphContentListItemTemplate" />
            <localControls:ImageListItemTemplate x:Key="ImageListItemTemplate" />

            <!--  Reference the DataTemplate instances in the selector  -->
            <localControls:ItemDetailListTemplateSelector
                x:Key="ItemDetailListTemplateSelector"
                Header2Template="{StaticResource Header2ListItemTemplate}"
                Header3Template="{StaticResource Header3ListItemTemplate}"
                ImageTemplate="{StaticResource ImageListItemTemplate}"
                ParagraphContentTemplate="{StaticResource ParagraphContentListItemTemplate}" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Shell.TitleView>
        <Grid
            Padding="{OnIdiom Phone='8,4',
                              Tablet='12,6',
                              Desktop='12,6',
                              Default='8,4'}"
            BackgroundColor="Transparent"
            HeightRequest="{OnIdiom Phone=60,
                                    Tablet=80,
                                    Desktop=80,
                                    Default=60}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <Grid HorizontalOptions="Fill" VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{OnIdiom Phone=52, Tablet=68, Desktop=68, Default=52}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Profile Image with enhanced styling  -->
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource WikiAppPersonaDetailProfileImageBg}"
                    HeightRequest="{OnIdiom Phone=44,
                                            Tablet=60,
                                            Desktop=60,
                                            Default=44}"
                    HorizontalOptions="Center"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeThickness="1.5"
                    VerticalOptions="Center"
                    WidthRequest="{OnIdiom Phone=44,
                                           Tablet=60,
                                           Desktop=60,
                                           Default=44}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{OnIdiom Phone=22, Tablet=30, Desktop=30, Default=22}" />
                    </Border.StrokeShape>
                    <Image
                        x:Name="imgPrimary"
                        Aspect="AspectFill"
                        HorizontalOptions="Fill"
                        Source="{Binding Persona.PicturePrimaryPath}"
                        VerticalOptions="Fill">
                        <Image.Clip>
                            <RoundRectangleGeometry CornerRadius="{OnIdiom Phone=22, Tablet=30, Desktop=30, Default=22}" Rect="0,0,44,44" />
                        </Image.Clip>
                    </Image>
                </Border>

                <!--  Name and Subtitle Section  -->
                <StackLayout
                    Grid.Column="1"
                    Margin="{OnIdiom Phone='10,0,8,0',
                                     Tablet='14,0,12,0',
                                     Desktop='14,0,12,0',
                                     Default='10,0,8,0'}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">

                    <Label
                        FontAttributes="Bold"
                        FontSize="{OnIdiom Phone=16,
                                           Tablet=22,
                                           Desktop=24,
                                           Default=16}"
                        HorizontalOptions="Fill"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Persona.Name}"
                        VerticalOptions="Center" />

                    <Label
                        FontAttributes="Italic"
                        FontSize="{OnIdiom Phone=11,
                                           Tablet=14,
                                           Desktop=16,
                                           Default=11}"
                        HorizontalOptions="Fill"
                        LineBreakMode="TailTruncation"
                        Opacity="0.8"
                        Text="{Binding Persona.NameSubstitueFormatted}"
                        VerticalOptions="Center" />
                </StackLayout>

                <!--  Wiki Source Link  -->
                <Border
                    Grid.Column="2"
                    Padding="{OnIdiom Phone='6,3',
                                      Tablet='10,5',
                                      Desktop='10,5',
                                      Default='6,3'}"
                    Background="{DynamicResource WikiAppButtonBgColor}"
                    HorizontalOptions="End"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TapHyperLinkToWikiPage}" CommandParameter="{Binding Persona.WikiPath}" />
                    </Border.GestureRecognizers>

                    <Label
                        FontSize="{OnIdiom Phone=9,
                                           Tablet=11,
                                           Desktop=12,
                                           Default=9}"
                        HorizontalOptions="Center"
                        Text="Wiki Source"
                        VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Content>
        <Grid Background="{DynamicResource WikiAppPersonaDetailPageBgGradient}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Proper Grid structure for tab layout  -->
            <Grid
                Grid.Row="0"
                HorizontalOptions="Fill"
                IsEnabled="{Binding IsPageEnabled}"
                VerticalOptions="Fill">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <tabView:SfTabView
                    x:Name="tabView"
                    Grid.Row="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <!--  Information Tab  -->
                    <tabView:SfTabItem x:Name="tabUsefulInfo" Header="{Binding TextOnFirstTabInformationOnDetailPage}">
                        <tabView:SfTabItem.Content>
                            <!--  Main container with proper row definitions  -->
                            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Margin="{OnIdiom Phone='10,8,10,5',
                                                     Tablet='15,12,15,8',
                                                     Desktop='15,12,15,8',
                                                     Default='10,8,10,5'}"
                                    Padding="{OnIdiom Phone='10,3',
                                                      Tablet='20,16',
                                                      Desktop='20,16',
                                                      Default='15,12'}"
                                    Background="{DynamicResource BorderTopBackgroundGradientBrush}"
                                    HorizontalOptions="Fill"
                                    Stroke="{DynamicResource BorderTopGradientBrush}"
                                    StrokeShape="RoundRectangle 12,12,12,12"
                                    StrokeThickness="1"
                                    VerticalOptions="Start">

                                    <Grid HorizontalOptions="Fill" VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--  Mark as Viewed Label with Icon  -->
                                        <StackLayout
                                            Grid.Column="0"
                                            HorizontalOptions="Start"
                                            Orientation="Horizontal"
                                            VerticalOptions="Center">

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{OnIdiom Phone=12,
                                                                   Tablet=20,
                                                                   Desktop=22,
                                                                   Default=16}"
                                                Text="📖 Mark as Viewed"
                                                VerticalOptions="Center" />
                                        </StackLayout>
                                        <!--  Status Label  -->
                                        <Label
                                            Grid.Column="2"
                                            Margin="{OnIdiom Phone='0,0,15,0',
                                                             Tablet='0,0,20,0',
                                                             Desktop='0,0,20,0',
                                                             Default='0,0,15,0'}"
                                            FontSize="{OnIdiom Phone=14,
                                                               Tablet=18,
                                                               Desktop=20,
                                                               Default=14}"
                                            HorizontalTextAlignment="End"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding Persona.ItemReadStatus}"
                                                    TargetType="Label"
                                                    Value="True">
                                                    <Setter Property="Text" Value="✅ Read" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding Persona.ItemReadStatus}"
                                                    TargetType="Label"
                                                    Value="False">
                                                    <Setter Property="Text" Value="📖 Unread" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <!--  Switch Control  -->
                                        <buttons:SfSwitch
                                            x:Name="swtReadItem"
                                            Grid.Column="3"
                                            HorizontalOptions="End"
                                            IsOn="{Binding Persona.ItemReadStatus}"
                                            StateChanged="swtReadItem_StateChanged"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <!--  List content container that fills remaining space  -->

                                <sfList:SfListView
                                    Grid.Row="1"
                                    AutoFitMode="DynamicHeight"
                                    ItemsSource="{Binding Persona.Metadatas}"
                                    SelectionMode="None"
                                    VerticalOptions="Fill">
                                    <sfList:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="5,2,5,2"
                                                Padding="1"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill">

                                                <Grid Padding="10" VerticalOptions="Fill">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{OnIdiom Phone=0.30*, Tablet=0.25*, Desktop=0.25*, Default=0.30*}" />
                                                        <ColumnDefinition Width="{OnIdiom Phone=0.70*, Tablet=0.75*, Desktop=0.75*, Default=0.70*}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        FontAttributes="Bold"
                                                        FontSize="{OnIdiom Phone=13,
                                                                           Tablet=18,
                                                                           Desktop=20,
                                                                           Default=12}"
                                                        HorizontalOptions="Start"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding Key}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        CharacterSpacing="{OnIdiom Phone=0.3,
                                                                                   Tablet=0.4,
                                                                                   Desktop=0.4,
                                                                                   Default=0.3}"
                                                        FontAttributes="Bold"
                                                        FontSize="{OnIdiom Phone=12,
                                                                           Tablet=18,
                                                                           Desktop=20,
                                                                           Default=12}"
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="{OnIdiom Phone=End,
                                                                                          Tablet=Start,
                                                                                          Desktop=Start,
                                                                                          Default=End}"
                                                        LineBreakMode="WordWrap"
                                                        LineHeight="{OnIdiom Phone=1.1,
                                                                             Tablet=1.2,
                                                                             Desktop=1.2,
                                                                             Default=1.1}"
                                                        Text="{Binding Description}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </sfList:SfListView.ItemTemplate>
                                </sfList:SfListView>
                            </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>

                    <!--  Details Tab  -->
                    <tabView:SfTabItem x:Name="tabDetailContent" Header="Details">
                        <tabView:SfTabItem.Content>
                            <!--  Enhanced Details tab with proper structure  -->
                            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <CollectionView
                                    HorizontalOptions="Fill"
                                    ItemSizingStrategy="MeasureAllItems"
                                    ItemTemplate="{StaticResource ItemDetailListTemplateSelector}"
                                    ItemsSource="{Binding ItemDetailItems}"
                                    SelectionMode="None"
                                    VerticalOptions="Fill">

                                    <!--  Enhanced item spacing  -->
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="5" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                </CollectionView>
                            </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>

                    <!--  Pictures Tab - Enhanced Modern Design  -->
                    <tabView:SfTabItem x:Name="tabPictures" Header="{Binding PictureTitle}">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <CollectionView
                                    x:Name="lstImages"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    ItemsSource="{Binding Persona.Pictures}"
                                    VerticalOptions="Fill">


                                    <!--  Enhanced Grid Layout with better spacing  -->

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout
                                            HorizontalItemSpacing="{OnIdiom Phone=8,
                                                                            Tablet=12,
                                                                            Desktop=15,
                                                                            Default=8}"
                                            Orientation="Vertical"
                                            Span="{OnIdiom Phone=2,
                                                           Tablet=3,
                                                           Desktop=4,
                                                           Default=2}"
                                            VerticalItemSpacing="{OnIdiom Phone=8,
                                                                          Tablet=12,
                                                                          Desktop=15,
                                                                          Default=8}" />
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="4"
                                                Background="{StaticResource WikiAppPersonaDetailPictureItemBgGradient}"
                                                Stroke="{DynamicResource WikiAppPersonaDetailPictureItemBorder}"
                                                StrokeShape="RoundRectangle 12,12,12,12"
                                                StrokeThickness="1">

                                                <Border.Shadow>
                                                    <Shadow
                                                        Brush="{DynamicResource WikiAppPersonaDetailPictureItemShadow}"
                                                        Opacity="0.3"
                                                        Radius="8"
                                                        Offset="0,2" />
                                                </Border.Shadow>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="lstImageEffectsLayer_Tapped" />
                                                </Border.GestureRecognizers>

                                                <Grid RowDefinitions="{OnIdiom Phone='120, Auto', Tablet='180, Auto', Desktop='220, Auto', Default='120, Auto'}">

                                                    <Grid Grid.Row="0" IsClippedToBounds="True">
                                                        <Image
                                                            Aspect="AspectFill"
                                                            HorizontalOptions="Fill"
                                                            Source="{Binding PicturePath}"
                                                            VerticalOptions="Fill" />

                                                        <BoxView
                                                            HeightRequest="40"
                                                            InputTransparent="True"
                                                            VerticalOptions="End">
                                                            <BoxView.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Offset="0.0" Color="Transparent" />
                                                                    <GradientStop Offset="1.0" Color="{StaticResource WikiAppPopupOverlayColor}" />
                                                                </LinearGradientBrush>
                                                            </BoxView.Background>
                                                        </BoxView>
                                                    </Grid>

                                                    <Label
                                                        Grid.Row="1"
                                                        Padding="{OnIdiom Phone='8,6',
                                                                          Tablet='12,8',
                                                                          Default='8,6'}"
                                                        FontSize="{OnIdiom Phone=11,
                                                                           Tablet=13,
                                                                           Default=11}"
                                                        HorizontalTextAlignment="Center"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="2"
                                                        Text="{Binding PictureCaption}"
                                                        VerticalTextAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
                </tabView:SfTabView>
            </Grid>

            <StackLayout
                Grid.Row="1"
                Margin="5,5,5,5"
                HeightRequest="50"
                HorizontalOptions="Center"
                VerticalOptions="Fill">

                <ads:BannerAdView
                    AdSize="Banner"
                    AdUnitId="{Binding BannerAdsUnitId}"
                    BannerType="Regular"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            </StackLayout>
            <!--  Loading Overlay  -->
            <Grid
                Grid.RowSpan="2"
                BackgroundColor="{DynamicResource WikiAppLoadingOverlayBgColor}"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsDataLoading}"
                VerticalOptions="Fill"
                ZIndex="1000">

                <Border
                    Padding="{OnIdiom Phone='30,25',
                                      Tablet='40,35',
                                      Desktop='40,35',
                                      Default='30,25'}"
                    Background="{DynamicResource WikiAppLoadingCardBg}"
                    HorizontalOptions="Center"
                    MinimumHeightRequest="{OnIdiom Phone=120,
                                                   Tablet=160,
                                                   Desktop=160,
                                                   Default=120}"
                    MinimumWidthRequest="{OnIdiom Phone=200,
                                                  Tablet=280,
                                                  Desktop=280,
                                                  Default=200}"
                    Stroke="{DynamicResource WikiAppLoadingCardBorder}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    VerticalOptions="Center">

                    <!--  Add subtle shadow effect  -->
                    <Border.Shadow>
                        <Shadow
                            Brush="{DynamicResource WikiAppLoadingCardShadow}"
                            Opacity="0.4"
                            Radius="12"
                            Offset="0,4" />
                    </Border.Shadow>

                    <StackLayout
                        HorizontalOptions="Center"
                        Spacing="{OnIdiom Phone=15,
                                          Tablet=20,
                                          Desktop=20,
                                          Default=15}"
                        VerticalOptions="Center">

                        <!--  Activity Indicator  -->
                        <ActivityIndicator
                            HeightRequest="{OnIdiom Phone=40,
                                                    Tablet=50,
                                                    Desktop=50,
                                                    Default=40}"
                            HorizontalOptions="Center"
                            IsRunning="{Binding IsDataLoading}"
                            VerticalOptions="Center"
                            WidthRequest="{OnIdiom Phone=40,
                                                   Tablet=50,
                                                   Desktop=50,
                                                   Default=40}"
                            Color="{DynamicResource WikiAppLoadingIndicatorColor}" />

                        <!--  Loading Message  -->
                        <Label
                            FontAttributes="Bold"
                            FontSize="{OnIdiom Phone=16,
                                               Tablet=20,
                                               Desktop=22,
                                               Default=16}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{Binding LoadingMessage}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />

                        <!--  Subtitle  -->
                        <Label
                            FontSize="{OnIdiom Phone=12,
                                               Tablet=14,
                                               Desktop=16,
                                               Default=12}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Opacity="0.8"
                            Text="Please wait while we prepare your content..."
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </StackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>