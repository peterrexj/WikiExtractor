<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="DetailViewPage"
    x:Class="WikiExtractor.Maui.App.Views.PersonaDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:local="clr-namespace:WikiExtractor.Maui.App.Exts"
    xmlns:localControls="clr-namespace:WikiExtractor.Maui.App.Controls"
    xmlns:sfList="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:WikiExtractor.Maui.App.Converters"
    BackgroundColor="{DynamicResource WikiAppDefaultBackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!--  Converters  -->
            <converters:ImagePathToSourceConverter x:Key="ImagePathConverter" />

            <!--  Create instances of the separate DataTemplate classes  -->
            <localControls:Header2ListItemTemplate x:Key="Header2ListItemTemplate" />
            <localControls:Header3ListItemTemplate x:Key="Header3ListItemTemplate" />
            <localControls:ParagraphContentListItemTemplate x:Key="ParagraphContentListItemTemplate" />
            <localControls:ImageListItemTemplate x:Key="ImageListItemTemplate" />

            <!--  Reference the DataTemplate instances in the selector  -->
            <localControls:ItemDetailListTemplateSelector
                x:Key="ItemDetailListTemplateSelector"
                Header2Template="{StaticResource Header2ListItemTemplate}"
                Header3Template="{StaticResource Header3ListItemTemplate}"
                ImageTemplate="{StaticResource ImageListItemTemplate}"
                ParagraphContentTemplate="{StaticResource ParagraphContentListItemTemplate}" />

            <!--  Tab item style with explicit text colors — Syncfusion VSM+DynamicResource is unreliable  -->
            <Style x:Key="TabItemStyle" TargetType="tabView:SfTabItem">
                <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
                <Setter Property="FontSize" Value="{OnIdiom Phone=13, Tablet=19, Default=19}" />
                <Setter Property="TextColor" Value="{DynamicResource WikiAppTabTextColorNormal}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--  TitleView is built and attached imperatively in code-behind via Shell.SetTitleView  -->

    <ContentPage.Content>
        <!--<Grid>-->
            <Grid Style="{DynamicResource WikiAppPageBackgroundGridStyle}"
                  IgnoreSafeArea="{OnPlatform iOS=True, Default=False}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Proper Grid structure for tab layout  -->
            <Grid
                Grid.Row="0"
                HorizontalOptions="Fill"
                IsEnabled="{Binding IsPageEnabled}"
                VerticalOptions="Fill">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <tabView:SfTabView
                    x:Name="tabView"
                    Grid.Row="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    SelectionChanged="tabView_SelectionChanged">

                    <!--  Information Tab  -->
                    <tabView:SfTabItem x:Name="tabUsefulInfo"
                                       Header="{Binding TextOnFirstTabInformationOnDetailPage}"
                                       Style="{StaticResource TabItemStyle}">
                        <tabView:SfTabItem.Content>
                            <!--  Main container with proper row definitions  -->
                            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Margin="{OnIdiom Phone='10,8,10,5',
                                                     Tablet='15,12,15,8',
                                                     Desktop='15,12,15,8',
                                                     Default='10,8,10,5'}"
                                    Padding="{OnIdiom Phone='10,8',
                                                      Tablet='20,12',
                                                      Desktop='20,12',
                                                      Default='10,8'}"
                                    Background="{DynamicResource BorderTopBackgroundGradientBrush}"
                                    HorizontalOptions="Fill"
                                    Stroke="{DynamicResource BorderTopGradientBrush}"
                                    StrokeShape="RoundRectangle 12,12,12,12"
                                    StrokeThickness="1"
                                    VerticalOptions="Start">

                                    <Grid
                                        ColumnDefinitions="*,*,*"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center">

                                        <!--  Favourite  -->
                                        <Label
                                            x:Name="lblFavouriteIcon"
                                            Grid.Column="0"
                                            FontFamily="FontAwesome"
                                            FontSize="{OnIdiom Phone=22, Tablet=32, Default=32}"
                                            Text="&#xf004;"
                                            TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="FavouriteButton_Tapped" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <!--  Share  -->
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="FontAwesome"
                                            FontSize="{OnIdiom Phone=22, Tablet=32, Default=32}"
                                            Text="&#xf1e0;"
                                            TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="ShareButton_Tapped" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <!--  Mark as Read  -->
                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Spacing="2">
                                            <buttons:SfSwitch
                                                x:Name="swtReadItem"
                                                HorizontalOptions="Center"
                                                IsOn="{Binding Persona.ItemReadStatus}"
                                                StateChanged="swtReadItem_StateChanged"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="{OnIdiom Phone=10, Tablet=15, Default=15}"
                                                Text="Mark Read"
                                                TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}"
                                                HorizontalOptions="Center"
                                                Opacity="0.6" />
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                                <!--  List content container that fills remaining space  -->
                                <Border
                                    Grid.Row="1"
                                    Margin="{OnIdiom Phone='10,4,10,8', Tablet='15,6,15,12', Default='10,4,10,8'}"
                                    BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                                    HorizontalOptions="Fill"
                                    Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    VerticalOptions="Fill">
                                    <sfList:SfListView
                                        AutoFitMode="DynamicHeight"
                                        BackgroundColor="Transparent"
                                        ItemsSource="{Binding Persona.Metadatas}"
                                        SelectionMode="None"
                                        VerticalOptions="Fill">
                                        <sfList:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    HorizontalOptions="Fill"
                                                    RowDefinitions="Auto,1"
                                                    VerticalOptions="Fill">

                                                    <Grid
                                                        Grid.Row="0"
                                                        Padding="{OnIdiom Phone='14,10', Tablet='20,14', Default='14,10'}"
                                                        ColumnDefinitions="{OnIdiom Phone='0.38*,0.62*', Tablet='0.32*,0.68*', Default='0.38*,0.62*'}"
                                                        ColumnSpacing="12"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Fill">

                                                        <Label
                                                            Grid.Column="0"
                                                            FontAttributes="Bold"
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{OnIdiom Phone=13, Tablet=19, Default=19}"
                                                            HorizontalOptions="Start"
                                                            LineBreakMode="WordWrap"
                                                            Text="{Binding Key}"
                                                            TextColor="{DynamicResource WikiAppPersonaDetailMetadataKeyTextColor}"
                                                            VerticalOptions="Center" />

                                                        <Label
                                                            Grid.Column="1"
                                                            CharacterSpacing="0.2"
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{OnIdiom Phone=13, Tablet=19, Default=19}"
                                                            HorizontalOptions="Fill"
                                                            HorizontalTextAlignment="Start"
                                                            LineBreakMode="WordWrap"
                                                            LineHeight="1.2"
                                                            Text="{Binding Description}"
                                                            TextColor="{DynamicResource WikiAppPersonaDetailMetadataValueTextColor}"
                                                            VerticalOptions="Center" />
                                                    </Grid>

                                                    <BoxView
                                                        Grid.Row="1"
                                                        Margin="{OnIdiom Phone='14,0', Tablet='20,0', Default='14,0'}"
                                                        BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                                        HeightRequest="0.5"
                                                        HorizontalOptions="Fill"
                                                        Opacity="0.4" />
                                                </Grid>
                                            </DataTemplate>
                                        </sfList:SfListView.ItemTemplate>
                                    </sfList:SfListView>
                                </Border>
                            </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>

                    <!--  Details Tab  -->
                    <tabView:SfTabItem x:Name="tabDetailContent"
                                       Header="Details"
                                       Style="{StaticResource TabItemStyle}">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Font size controls toolbar  -->
                                <Grid
                                    Grid.Row="0"
                                    Margin="{OnIdiom Phone='10,6,10,2', Tablet='15,8,15,4', Default='10,6,10,2'}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Decrease font  -->
                                    <Label
                                        Grid.Column="0"
                                        Margin="0,0,6,0"
                                        FontAttributes="Bold"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=18, Tablet=26, Default=26}"
                                        HorizontalOptions="Center"
                                        Opacity="0.55"
                                        Text="&#x2212;"
                                        TextColor="{DynamicResource WikiAppListItemHeaderTextColor}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding CanDecreaseFontSize}" TargetType="Label" Value="False">
                                                <Setter Property="Opacity" Value="0.2" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding DecreaseFontSize}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!--  Current font size indicator  -->
                                    <Label
                                        Grid.Column="1"
                                        Margin="0,0,6,0"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=12, Tablet=17, Default=17}"
                                        HorizontalOptions="Center"
                                        Opacity="0.45"
                                        Text="{Binding ContentFontSize, StringFormat='{0:0}'}"
                                        TextColor="{DynamicResource WikiAppListItemHeaderTextColor}"
                                        VerticalOptions="Center"
                                        WidthRequest="{OnIdiom Phone=24, Tablet=30, Default=24}" />

                                    <!--  Increase font  -->
                                    <Label
                                        Grid.Column="2"
                                        FontAttributes="Bold"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=18, Tablet=26, Default=26}"
                                        HorizontalOptions="Center"
                                        Opacity="0.55"
                                        Text="&#x002B;"
                                        TextColor="{DynamicResource WikiAppListItemHeaderTextColor}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding CanIncreaseFontSize}" TargetType="Label" Value="False">
                                                <Setter Property="Opacity" Value="0.2" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding IncreaseFontSize}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    Margin="{OnIdiom Phone='10,4,10,8', Tablet='15,6,15,12', Default='10,4,10,8'}"
                                    BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                                    HorizontalOptions="Fill"
                                    Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    VerticalOptions="Fill">
                                    <CollectionView
                                        HorizontalOptions="Fill"
                                        ItemSizingStrategy="MeasureAllItems"
                                        ItemTemplate="{StaticResource ItemDetailListTemplateSelector}"
                                        ItemsSource="{Binding ItemDetailItems}"
                                        Margin="{OnIdiom Phone='0,6', Tablet='0,8', Default='0,6'}"
                                        SelectionMode="None"
                                        VerticalOptions="Fill">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                                        </CollectionView.ItemsLayout>
                                    </CollectionView>
                                </Border>
                            </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>

                    <!--  Pictures Tab  -->
                    <tabView:SfTabItem x:Name="tabPictures"
                                       Header="{Binding PictureTitle}"
                                       Style="{StaticResource TabItemStyle}">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <CollectionView
                                    x:Name="lstImages"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    ItemsSource="{Binding Persona.Pictures}"
                                    Margin="{OnIdiom Phone='10,10', Tablet='14,14', Default='10,10'}"
                                    VerticalOptions="Fill">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout
                                            HorizontalItemSpacing="{OnIdiom Phone=10, Tablet=14, Desktop=16, Default=10}"
                                            Orientation="Vertical"
                                            Span="{OnIdiom Phone=2, Tablet=3, Desktop=4, Default=2}"
                                            VerticalItemSpacing="{OnIdiom Phone=10, Tablet=14, Desktop=16, Default=10}" />
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="2"
                                                BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                                                HeightRequest="{OnIdiom Phone=155, Tablet=220, Desktop=260, Default=155}"
                                                HorizontalOptions="Fill"
                                                Stroke="{DynamicResource WikiAppPersonaDetailPictureItemBorder}"
                                                StrokeShape="RoundRectangle 16"
                                                StrokeThickness="1">

                                                <Border.Shadow>
                                                    <Shadow
                                                        Brush="{DynamicResource WikiAppPersonaDetailPictureItemShadow}"
                                                        Opacity="0.4"
                                                        Radius="10"
                                                        Offset="0,3" />
                                                </Border.Shadow>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="lstImageEffectsLayer_Tapped" />
                                                </Border.GestureRecognizers>

                                                <!--  Full-height image with caption overlay  -->
                                                <Grid HorizontalOptions="Fill" VerticalOptions="Fill">

                                                    <!--  Image fills entire card  -->
                                                    <local:ExtendedImage
                                                        Aspect="AspectFill"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Fill"
                                                        CustomSource="{Binding PicturePath}"
                                                        PageCancellationTokenSource="{Binding BindingContext.PageCancellationTokenSource, Source={x:Reference DetailViewPage}}" />

                                                    <!--  Bottom gradient scrim  -->
                                                    <BoxView
                                                        HeightRequest="{OnIdiom Phone=70, Tablet=90, Default=70}"
                                                        InputTransparent="True"
                                                        VerticalOptions="End">
                                                        <BoxView.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Offset="0.0" Color="Transparent" />
                                                                <GradientStop Offset="1.0" Color="#CC000000" />
                                                            </LinearGradientBrush>
                                                        </BoxView.Background>
                                                    </BoxView>

                                                    <!--  Caption overlaid on gradient  -->
                                                    <Label
                                                        Padding="{OnIdiom Phone='10,6', Tablet='14,8', Default='10,6'}"
                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                        FontSize="{OnIdiom Phone=11, Tablet=16, Default=16}"
                                                        HorizontalOptions="Fill"
                                                        HorizontalTextAlignment="Center"
                                                        InputTransparent="True"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="2"
                                                        Text="{Binding PictureCaption}"
                                                        TextColor="White"
                                                        VerticalOptions="End"
                                                        VerticalTextAlignment="End" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
                </tabView:SfTabView>
            </Grid>

            <ads:BannerAdView
                Grid.Row="2"
                AdSize="Banner"
                AdUnitId="{Binding BannerAdsUnitId}"
                BannerType="Regular"
                HeightRequest="50"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!--  Offline indicator row — sits between content and ads  -->
            <Border
                Grid.Row="1"
                Margin="{OnIdiom Phone='10,2,10,4', Tablet='14,2,14,6', Default='10,2,10,4'}"
                Padding="{OnIdiom Phone='12,7', Tablet='16,9', Default='12,7'}"
                BackgroundColor="#1AFF5252"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsOffline}"
                Stroke="#FF5252"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Label
                        Grid.Column="0"
                        FontFamily="FontAwesome"
                        FontSize="{OnIdiom Phone=14, Tablet=20, Default=20}"
                        Text="&#xf1eb;"
                        TextColor="#FF5252"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontFamily="{DynamicResource DefaultFontFamily}"
                        FontSize="{OnIdiom Phone=13, Tablet=19, Default=19}"
                        FontAttributes="Bold"
                        Text="No internet connection"
                        TextColor="#FF5252"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  Loading overlay — covers the full page while data is being fetched  -->
            <Grid
                Grid.RowSpan="3"
                BackgroundColor="{DynamicResource WikiAppDefaultBackgroundColor}"
                HorizontalOptions="Fill"
                InputTransparent="{Binding IsPageEnabled}"
                IsVisible="{Binding IsDataLoading}"
                VerticalOptions="Fill"
                ZIndex="100">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="16"
                    VerticalOptions="Center">
                    <ActivityIndicator
                        Color="{DynamicResource WikiAppPrimaryAccentColor}"
                        HeightRequest="40"
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsDataLoading}"
                        WidthRequest="40" />
                    <Label
                        FontFamily="{DynamicResource DefaultFontFamily}"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Opacity="0.7"
                        Text="{Binding LoadingMessage}"
                        TextColor="{DynamicResource WikiAppListItemDescriptionTextColor}" />
                </VerticalStackLayout>
            </Grid>

            <!--  Loading Facts Control — disabled, kept for re-enable if needed
            <localControls:LoadingFactsControl
                x:Name="loadingFactsControl"
                Grid.RowSpan="2"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                ZIndex="1000" />
            -->

        </Grid>

    </ContentPage.Content>

</ContentPage>