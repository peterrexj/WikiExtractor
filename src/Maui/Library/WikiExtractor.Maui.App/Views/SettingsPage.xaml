<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:viewmodels="clr-namespace:Maui.Wiki.ViewModels"
    x:Name="thisPage"
    Title="Settings"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{DynamicResource WikiAppDefaultBackgroundColor}">

    <Grid Style="{DynamicResource WikiAppPageBackgroundGridStyle}">
        <ScrollView>
            <VerticalStackLayout
                Padding="{OnIdiom Phone='16,16', Tablet='24,20', Default='16,16'}"
                Spacing="{OnIdiom Phone=20, Tablet=28, Default=20}">

                <!-- ═══ APPEARANCE ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FontAwesome"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"                        Text="&#xf53f;  APPEARANCE"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- Theme row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FontAwesome"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xf042;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Application Theme"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Picker
                                    Title="Select"
                                    Grid.Column="2"
                                    HorizontalTextAlignment="End"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding Themes}"
                                    SelectedItem="{Binding SelectedTheme}"
                                    Style="{DynamicResource WikiAppPickerStyle}"
                                    WidthRequest="{OnIdiom Phone=120, Tablet=150, Default=120}" />
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Font row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FontAwesome"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xf031;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Font Family"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Picker
                                    Title="Select"
                                    Grid.Column="2"
                                    HorizontalTextAlignment="End"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding FontFamilies}"
                                    SelectedItem="{Binding SelectedFontFamily}"
                                    Style="{DynamicResource WikiAppPickerStyle}"
                                    WidthRequest="{OnIdiom Phone=140, Tablet=170, Default=140}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ PREFERENCES ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FontAwesome"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"                        Text="&#xf0ad;  PREFERENCES"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- Hide Viewed row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FontAwesome"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xf070;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Hide Viewed Items"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <sfButtons:SfSwitch
                                    x:Name="hideViewedSwitch"
                                    Grid.Column="2"
                                    IsEnabled="{Binding IsNotBusy}"
                                    IsOn="{Binding HideViewedItems}"
                                    StateChanged="HideViewedSwitch_StateChanged" />
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Sort Order row -->
                            <VerticalStackLayout
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                Spacing="12">
                                <Grid
                                    ColumnDefinitions="32,*"
                                    ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="FontAwesome"
                                        FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                        HorizontalOptions="Center"
                                        Text="&#xf15d;"
                                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                        Text="Sort Order"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <sfButtons:SfSegmentedControl
                                    x:Name="sfSegmentSortOrder"
                                    BackgroundColor="Transparent"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding SortByCollection}"
                                    SegmentHeight="{OnIdiom Phone=36, Tablet=42, Default=36}"
                                    SelectedIndex="{Binding SortBySelectedIndex}"
                                    SelectionChanged="SfSegmentSortOrder_SelectionChanged"
                                    VisibleSegmentsCount="6">
                                    <sfButtons:SfSegmentedControl.TextStyle>
                                        <sfButtons:SegmentTextStyle
                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                            FontSize="{OnIdiom Phone=10, Tablet=12, Default=10}"
                                            TextColor="{DynamicResource WikiAppSettingsSegmentTextColor}" />
                                    </sfButtons:SfSegmentedControl.TextStyle>
                                    <sfButtons:SfSegmentedControl.SelectionIndicatorSettings>
                                        <sfButtons:SelectionIndicatorSettings
                                            Background="{DynamicResource WikiAppPrimaryAccentColor}"
                                            TextColor="{DynamicResource WikiAppSettingsSegmentSelectedTextColor}" />
                                    </sfButtons:SfSegmentedControl.SelectionIndicatorSettings>
                                </sfButtons:SfSegmentedControl>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ AUDIO ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FontAwesome"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"                        Text="&#xf028;  AUDIO"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- Speech Pitch row -->
                            <VerticalStackLayout
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                Spacing="8">
                                <Grid
                                    ColumnDefinitions="32,*,Auto"
                                    ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="FontAwesome"
                                        FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                        HorizontalOptions="Center"
                                        Text="&#xf130;"
                                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                        Text="Voice Pitch"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="lblSpeechPitch"
                                        Grid.Column="2"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=13, Tablet=15, Default=13}"
                                        Opacity="0.75"                                        Text="{Binding SpeechPitch, StringFormat='{0:F1}'}"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                        VerticalOptions="Center" />
                                </Grid>
                                <Slider
                                    x:Name="sliderSpeechPitch"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Maximum="2.0"
                                    Minimum="0.5"
                                    ThumbColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    MinimumTrackColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    MaximumTrackColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                    Value="{Binding SpeechPitch}"
                                    ValueChanged="SliderSpeechPitch_ValueChanged" />
                                <Grid ColumnDefinitions="*,*,*">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="Start"
                                        Opacity="0.4"
                                        Text="Low"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.4"
                                        Text="Normal"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="End"
                                        Opacity="0.4"
                                        Text="High"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                </Grid>
                            </VerticalStackLayout>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Voice picker row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FontAwesome"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xf2b9;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Voice"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Picker
                                    Title="Select"
                                    Grid.Column="2"
                                    HorizontalTextAlignment="End"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding AvailableVoices}"
                                    SelectedItem="{Binding SelectedVoice}"
                                    Style="{DynamicResource WikiAppPickerStyle}"
                                    WidthRequest="{OnIdiom Phone=160, Tablet=200, Default=160}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ PREMIUM ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FontAwesome"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"
                        Text="&#xf521;  PREMIUM"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- No Ads status / purchase row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FontAwesome"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xf05e;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                        Text="Remove Ads"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                    <Label
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=12, Tablet=13, Default=12}"
                                        IsVisible="{Binding NoAdsEnabled}"
                                        Opacity="0.65"
                                        Text="Purchased — Ads are off"
                                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />
                                </VerticalStackLayout>
                                <StackLayout
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalOptions="Center">
                                    <ActivityIndicator
                                        HeightRequest="22"
                                        IsRunning="{Binding NoAdsBusy}"
                                        IsVisible="{Binding NoAdsBusy}"
                                        WidthRequest="22"
                                        Color="{DynamicResource WikiAppPrimaryAccentColor}" />
                                    <Button
                                        Command="{Binding RemoveAdsCommand}"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=13, Tablet=15, Default=13}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        IsVisible="{Binding ShowRemoveAdsButton}"
                                        Padding="14,8"
                                        Text="Buy"
                                        BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                        TextColor="White"
                                        CornerRadius="8" />
                                </StackLayout>
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Restore purchases row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FontAwesome"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xf0e2;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Restore Purchases"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding RestoreAdsCommand}"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=13, Tablet=15, Default=13}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Padding="14,8"
                                    Text="Restore"
                                    BackgroundColor="Transparent"
                                    BorderColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    CornerRadius="8" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Version footer -->
                <Label
                    x:Name="lblVersion"
                    Margin="0,8,0,16"
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{OnIdiom Phone=12, Tablet=14, Default=12}"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Border
            IsVisible="{Binding IsPageBusy}"
            BackgroundColor="#80000000"
            InputTransparent="False"
            StrokeThickness="0">
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="15"
                VerticalOptions="Center">
                <ActivityIndicator
                    HeightRequest="50"
                    IsRunning="{Binding IsPageBusy}"
                    WidthRequest="50"
                    Color="{DynamicResource WikiAppSettingsActivityIndicatorColor}" />
                <Label
                    FontAttributes="Bold"
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    Text="Applying Changes..."
                    TextColor="{DynamicResource WikiAppSettingsBusyTextColor}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
