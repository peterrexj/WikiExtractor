<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:viewmodels="clr-namespace:Maui.Wiki.ViewModels"
    x:Name="thisPage"
    Title="Settings"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    Shell.NavBarIsVisible="True">

    <ContentPage.BindingContext>
        <viewmodels:SettingsViewModel />
    </ContentPage.BindingContext>

    <Grid Style="{DynamicResource WikiAppPageBackgroundGridStyle}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="25">

                <VerticalStackLayout Style="{StaticResource SettingsSectionContainerStyle}">
                    <Label
                        Style="{StaticResource SettingsSectionHeaderStyle}"
                        Text="APPEARANCE" />

                    <Border
                        Padding="0"
                        Style="{StaticResource SettingsCardBorderStyle}">
                        <VerticalStackLayout>
                            <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                                <Label
                                    Style="{StaticResource SettingsIconLabelStyle}"
                                    Text="🎨" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource SettingsLabelStyle}"
                                    Text="Application Theme" />
                                <Picker
                                    Title="Select"
                                    Grid.Column="2"
                                    HorizontalTextAlignment="End"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding Themes}"
                                    SelectedItem="{Binding SelectedTheme}"
                                    Style="{DynamicResource WikiAppPickerStyle}"
                                    WidthRequest="120" />
                            </Grid>

                            <BoxView Style="{StaticResource SettingsDividerStyle}" />

                            <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                                <Label
                                    Style="{StaticResource SettingsIconLabelStyle}"
                                    Text="🔤" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource SettingsLabelStyle}"
                                    Text="Font Family" />
                                <Picker
                                    Title="Select"
                                    Grid.Column="2"
                                    HorizontalTextAlignment="End"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding FontFamilies}"
                                    SelectedItem="{Binding SelectedFontFamily}"
                                    Style="{DynamicResource WikiAppPickerStyle}"
                                    WidthRequest="140" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Style="{StaticResource SettingsSectionContainerStyle}">
                    <Label
                        Style="{StaticResource SettingsSectionHeaderStyle}"
                        Text="PREFERENCES" />

                    <Border
                        Padding="0"
                        Style="{StaticResource SettingsCardBorderStyle}">
                        <VerticalStackLayout>
                            <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                                <Label
                                    Style="{StaticResource SettingsIconLabelStyle}"
                                    Text="👁️" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource SettingsLabelStyle}"
                                    Text="Hide Viewed Items" />
                                <sfButtons:SfSwitch
                                    x:Name="hideViewedSwitch"
                                    Grid.Column="2"
                                    IsEnabled="{Binding IsNotBusy}"
                                    IsOn="{Binding HideViewedItems}"
                                    StateChanged="HideViewedSwitch_StateChanged" />
                            </Grid>

                            <BoxView Style="{StaticResource SettingsDividerStyle}" />

                            <VerticalStackLayout Padding="15" Spacing="10">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label
                                        Style="{StaticResource SettingsIconLabelStyle}"
                                        Text="🔃" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource SettingsLabelStyle}"
                                        Text="Sort Order" />
                                </Grid>

                                <sfButtons:SfSegmentedControl
                                    x:Name="sfSegmentSortOrder"
                                    Margin="0,5,0,0"
                                    BackgroundColor="Transparent"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding SortByCollection}"
                                    SegmentHeight="40"
                                    SelectedIndex="{Binding SortBySelectedIndex}"
                                    SelectionChanged="SfSegmentSortOrder_SelectionChanged"
                                    VisibleSegmentsCount="6">
                                    <sfButtons:SfSegmentedControl.TextStyle>
                                        <sfButtons:SegmentTextStyle FontSize="10" TextColor="{DynamicResource WikiAppSettingsSegmentTextColor}" />
                                    </sfButtons:SfSegmentedControl.TextStyle>
                                    <sfButtons:SfSegmentedControl.SelectionIndicatorSettings>
                                        <sfButtons:SelectionIndicatorSettings Background="{DynamicResource PrimaryColor}" TextColor="{DynamicResource WikiAppSettingsSegmentSelectedTextColor}" />
                                    </sfButtons:SfSegmentedControl.SelectionIndicatorSettings>
                                </sfButtons:SfSegmentedControl>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource SettingsVersionLabelStyle}"
                    Text="WikiExtractor v2.0" />

            </VerticalStackLayout>
        </ScrollView>

        <Border
            IsVisible="{Binding IsPageBusy}"
            Style="{StaticResource SettingsLoadingOverlayStyle}">
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="15"
                VerticalOptions="Center">
                <ActivityIndicator
                    HeightRequest="50"
                    IsRunning="{Binding IsPageBusy}"
                    WidthRequest="50"
                    Color="{DynamicResource WikiAppSettingsActivityIndicatorColor}" />
                <Label
                    Style="{StaticResource SettingsLoadingLabelStyle}"
                    Text="Applying Changes..." />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>