<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:viewmodels="clr-namespace:Maui.Wiki.ViewModels"
    x:Name="thisPage"
    Title="Settings"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{DynamicResource WikiAppDefaultBackgroundColor}">

    <Grid Style="{DynamicResource WikiAppPageBackgroundGridStyle}">
        <ScrollView>
            <VerticalStackLayout
                Padding="{OnIdiom Phone='16,16', Tablet='24,20', Default='16,16'}"
                Spacing="{OnIdiom Phone=20, Tablet=28, Default=20}">

                <!-- ═══ APPEARANCE ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FluentIcons"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"                        Text="&#xF2F5;  APPEARANCE"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- Theme row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xF2BD;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Application Theme"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <editors:SfComboBox
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    DropDownBackground="{DynamicResource WikiAppComboDropDownBackgroundColor}"
                                    DropDownItemTextColor="{DynamicResource WikiAppComboDropDownTextColor}"
                                    HighlightedTextColor="{DynamicResource WikiAppComboHighlightedTextColor}"
                                    IsClearButtonVisible="False"
                                    IsEditable="False"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding Themes}"
                                    SelectedDropDownItemBackground="{DynamicResource WikiAppPrimaryAccentColor}"
                                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                    Style="{DynamicResource SfComboBoxStyle}"
                                    TextColor="{DynamicResource WikiAppComboTextColor}"
                                    WidthRequest="{OnIdiom Phone=130, Tablet=160, Default=130}">
                                    <editors:SfComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="14,*" ColumnSpacing="8" Padding="8,0" VerticalOptions="Center">
                                                <BoxView
                                                    Grid.Column="0"
                                                    WidthRequest="14"
                                                    HeightRequest="14"
                                                    CornerRadius="3"
                                                    VerticalOptions="Center">
                                                    <BoxView.Triggers>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding .}" Value="Dark">
                                                            <Setter Property="Color" Value="#1A1A2E" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding .}" Value="Light">
                                                            <Setter Property="Color" Value="#F5F5F5" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding .}" Value="Forest">
                                                            <Setter Property="Color" Value="#2D5A27" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding .}" Value="Candy">
                                                            <Setter Property="Color" Value="#FF6B9D" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding .}" Value="Sunset">
                                                            <Setter Property="Color" Value="#FF6B35" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding .}" Value="Ocean">
                                                            <Setter Property="Color" Value="#006994" />
                                                        </DataTrigger>
                                                    </BoxView.Triggers>
                                                </BoxView>
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding .}"
                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                    FontSize="{OnIdiom Phone=14, Tablet=16, Default=14}"
                                                    TextColor="{DynamicResource WikiAppComboDropDownTextColor}"
                                                    VerticalOptions="Center"
                                                    VerticalTextAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </editors:SfComboBox.ItemTemplate>
                                </editors:SfComboBox>
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Font row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xF2F5;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Font Family"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <editors:SfComboBox
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    DropDownBackground="{DynamicResource WikiAppComboDropDownBackgroundColor}"
                                    DropDownItemTextColor="{DynamicResource WikiAppComboDropDownTextColor}"
                                    HighlightedTextColor="{DynamicResource WikiAppComboHighlightedTextColor}"
                                    IsClearButtonVisible="False"
                                    IsEnabled="{Binding IsNotBusy}"
                                    IsEditable="False"
                                    ItemsSource="{Binding FontFamilies}"
                                    SelectedDropDownItemBackground="{DynamicResource WikiAppPrimaryAccentColor}"
                                    SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"
                                    Style="{DynamicResource SfComboBoxStyle}"
                                    TextColor="{DynamicResource WikiAppComboTextColor}"
                                    WidthRequest="{OnIdiom Phone=160, Tablet=190, Default=160}">
                                    <editors:SfComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Label
                                                Text="{Binding .}"
                                                FontFamily="{Binding .}"
                                                FontSize="{OnIdiom Phone=14, Tablet=16, Default=14}"
                                                TextColor="{DynamicResource WikiAppComboDropDownTextColor}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center"
                                                HorizontalOptions="Fill"
                                                Padding="8,0" />
                                        </DataTemplate>
                                    </editors:SfComboBox.ItemTemplate>
                                </editors:SfComboBox>
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Font Size row -->
                            <VerticalStackLayout
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                Spacing="8">
                                <Grid
                                    ColumnDefinitions="32,*,Auto"
                                    ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="FluentIcons"
                                        FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                        HorizontalOptions="Center"
                                        Text="&#xF18A;"
                                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                        Text="Content Font Size"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=13, Tablet=15, Default=13}"
                                        Opacity="0.75"
                                        Text="{Binding ParagraphFontSize, StringFormat='{0:F0}'}"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                        VerticalOptions="Center" />
                                </Grid>
                                <Slider
                                    x:Name="sliderFontSize"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Maximum="{Binding MaxParagraphFontSize}"
                                    Minimum="{Binding MinParagraphFontSize}"
                                    ThumbColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    MinimumTrackColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    MaximumTrackColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                    Value="{Binding ParagraphFontSize}"
                                    ValueChanged="SliderFontSize_ValueChanged" />
                                <Grid ColumnDefinitions="*,*,*">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="Start"
                                        Opacity="0.4"
                                        Text="Small"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.4"
                                        Text="Normal"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="End"
                                        Opacity="0.4"
                                        Text="Large"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ PREFERENCES ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FluentIcons"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"                        Text="&#xEE86;  PREFERENCES"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- Hide Viewed row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xE5F5;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Hide Viewed Items"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <sfButtons:SfSwitch
                                    x:Name="hideViewedSwitch"
                                    Grid.Column="2"
                                    IsEnabled="{Binding IsNotBusy}"
                                    IsOn="{Binding HideViewedItems}"
                                    StateChanged="HideViewedSwitch_StateChanged" />
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Sort Order row -->
                            <VerticalStackLayout
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                Spacing="12">
                                <Grid
                                    ColumnDefinitions="32,*"
                                    ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="FluentIcons"
                                        FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                        HorizontalOptions="Center"
                                        Text="&#xF18A;"
                                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                        Text="Sort Order"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <sfButtons:SfSegmentedControl
                                    x:Name="sfSegmentSortOrder"
                                    BackgroundColor="Transparent"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding SortByCollection}"
                                    SegmentHeight="{OnIdiom Phone=36, Tablet=42, Default=36}"
                                    SelectedIndex="{Binding SortBySelectedIndex}"
                                    SelectionChanged="SfSegmentSortOrder_SelectionChanged"
                                    VisibleSegmentsCount="6">
                                    <sfButtons:SfSegmentedControl.TextStyle>
                                        <sfButtons:SegmentTextStyle
                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                            FontSize="{OnIdiom Phone=10, Tablet=12, Default=10}"
                                            TextColor="{DynamicResource WikiAppSettingsSegmentTextColor}" />
                                    </sfButtons:SfSegmentedControl.TextStyle>
                                    <sfButtons:SfSegmentedControl.SelectionIndicatorSettings>
                                        <sfButtons:SelectionIndicatorSettings
                                            Background="{DynamicResource WikiAppPrimaryAccentColor}"
                                            TextColor="{DynamicResource WikiAppSettingsSegmentSelectedTextColor}" />
                                    </sfButtons:SfSegmentedControl.SelectionIndicatorSettings>
                                </sfButtons:SfSegmentedControl>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ AUDIO ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FluentIcons"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"                        Text="&#xEB42;  AUDIO"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- Speech Pitch row -->
                            <VerticalStackLayout
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                Spacing="8">
                                <Grid
                                    ColumnDefinitions="32,*,Auto"
                                    ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="FluentIcons"
                                        FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                        HorizontalOptions="Center"
                                        Text="&#xE7F9;"
                                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                        Text="Voice Pitch"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="lblSpeechPitch"
                                        Grid.Column="2"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=13, Tablet=15, Default=13}"
                                        Opacity="0.75"                                        Text="{Binding SpeechPitch, StringFormat='{0:F1}'}"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                        VerticalOptions="Center" />
                                </Grid>
                                <Slider
                                    x:Name="sliderSpeechPitch"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Maximum="2.0"
                                    Minimum="0.5"
                                    ThumbColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    MinimumTrackColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    MaximumTrackColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                    Value="{Binding SpeechPitch}"
                                    ValueChanged="SliderSpeechPitch_ValueChanged" />
                                <Grid ColumnDefinitions="*,*,*">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="Start"
                                        Opacity="0.4"
                                        Text="Low"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.4"
                                        Text="Normal"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="11"
                                        HorizontalTextAlignment="End"
                                        Opacity="0.4"
                                        Text="High"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                </Grid>
                            </VerticalStackLayout>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Voice picker row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xF31F;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Voice"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Picker
                                    Title="Select"
                                    Grid.Column="2"
                                    HorizontalTextAlignment="End"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ItemsSource="{Binding AvailableVoices}"
                                    SelectedItem="{Binding SelectedVoice}"
                                    Style="{DynamicResource WikiAppPickerStyle}"
                                    WidthRequest="{OnIdiom Phone=160, Tablet=200, Default=160}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ PREMIUM ═══ -->
                <!-- ═══ TURNED OFF ═══ -->
                <VerticalStackLayout Spacing="10" IsVisible="False">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FluentIcons"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"
                        Text="&#xF18A;  PREMIUM"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- No Ads status / purchase row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xF62D;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                        Text="Remove Ads"
                                        TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />
                                    <Label
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=12, Tablet=13, Default=12}"
                                        IsVisible="{Binding NoAdsEnabled}"
                                        Opacity="0.65"
                                        Text="Purchased — Ads are off"
                                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />
                                </VerticalStackLayout>
                                <StackLayout
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalOptions="Center">
                                    <ActivityIndicator
                                        HeightRequest="22"
                                        IsRunning="{Binding NoAdsBusy}"
                                        IsVisible="{Binding NoAdsBusy}"
                                        WidthRequest="22"
                                        Color="{DynamicResource WikiAppPrimaryAccentColor}" />
                                    <Button
                                        Command="{Binding RemoveAdsCommand}"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=13, Tablet=15, Default=13}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        IsVisible="{Binding ShowRemoveAdsButton}"
                                        Padding="14,8"
                                        Text="Buy"
                                        BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                        TextColor="White"
                                        CornerRadius="8" />
                                </StackLayout>
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Restore purchases row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xF199;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Restore Purchases"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding RestoreAdsCommand}"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=13, Tablet=15, Default=13}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Padding="14,8"
                                    Text="Restore"
                                    BackgroundColor="Transparent"
                                    BorderColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    CornerRadius="8" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ ACTIVITY ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FluentIcons"
                        FontSize="{OnIdiom Phone=11, Tablet=13, Default=11}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"
                        Text="&#xF2DD;  ACTIVITY"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- Current streak row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xF836;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Current Streak"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    FontAttributes="Bold"
                                    Text="{Binding CurrentStreak, StringFormat='{0} days'}"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Best streak row -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=16}"
                                    HorizontalOptions="Center"
                                    Text="&#xF836;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    Text="Best Streak"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Default=15}"
                                    FontAttributes="Bold"
                                    Text="{Binding BestStreak, StringFormat='{0} days'}"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ ABOUT ═══ -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Margin="4,0"
                        FontAttributes="Bold"
                        FontFamily="FluentIcons"
                        FontSize="{OnIdiom Phone=11, Tablet=16, Default=16}"
                        CharacterSpacing="1.2"
                        Opacity="0.75"
                        Text="&#xF4A3;  ABOUT"
                        TextColor="{DynamicResource WikiAppPrimaryAccentColor}" />

                    <Border
                        BackgroundColor="{DynamicResource WikiAppListItemBoxBackgroundColor}"
                        Stroke="{DynamicResource WikiAppListItemBoxBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">
                        <VerticalStackLayout>

                            <!-- Share the app -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShareAppCommand}" />
                                </Grid.GestureRecognizers>
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=20}"
                                    HorizontalOptions="Center"
                                    Text="&#xF6AF;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=19, Default=19}"
                                    Text="Share the App"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=13, Tablet=17, Default=17}"
                                    Opacity="0.4"
                                    Text="&#xF2B0;"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Rate the app -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RateAppCommand}" />
                                </Grid.GestureRecognizers>
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=20}"
                                    HorizontalOptions="Center"
                                    Text="&#xF70F;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=19, Default=19}"
                                    Text="Rate the App"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=13, Tablet=17, Default=17}"
                                    Opacity="0.4"
                                    Text="&#xF2B0;"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <BoxView
                                Margin="16,0"
                                BackgroundColor="{DynamicResource WikiAppListItemBoxBorderColor}"
                                HeightRequest="0.5"
                                Opacity="0.4" />

                            <!-- Send feedback -->
                            <Grid
                                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Default='16,14'}"
                                ColumnDefinitions="32,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SendFeedbackCommand}" />
                                </Grid.GestureRecognizers>
                                <Label
                                    Grid.Column="0"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=16, Tablet=20, Default=20}"
                                    HorizontalOptions="Center"
                                    Text="&#xF506;"
                                    TextColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=19, Default=19}"
                                    Text="Send Feedback"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontFamily="FluentIcons"
                                    FontSize="{OnIdiom Phone=13, Tablet=17, Default=17}"
                                    Opacity="0.4"
                                    Text="&#xF2B0;"
                                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}"
                                    VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Version footer -->
                <Label
                    x:Name="lblVersion"
                    Margin="0,8,0,16"
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{OnIdiom Phone=12, Tablet=14, Default=12}"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource WikiAppSettingsLabelTextColor}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Border
            IsVisible="{Binding IsPageBusy}"
            BackgroundColor="#80000000"
            InputTransparent="False"
            StrokeThickness="0">
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="15"
                VerticalOptions="Center">
                <ActivityIndicator
                    HeightRequest="50"
                    IsRunning="{Binding IsPageBusy}"
                    WidthRequest="50"
                    Color="{DynamicResource WikiAppSettingsActivityIndicatorColor}" />
                <Label
                    FontAttributes="Bold"
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    Text="Applying Changes..."
                    TextColor="{DynamicResource WikiAppSettingsBusyTextColor}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
