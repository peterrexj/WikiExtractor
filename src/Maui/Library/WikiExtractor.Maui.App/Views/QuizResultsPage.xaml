<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.QuizResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:conv="clr-namespace:WikiExtractor.Maui.App.Converters"
    xmlns:effects="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="Quiz Results"
    Shell.NavBarIsVisible="False">

    <Grid Background="{DynamicResource WikiAppQuizPageBackgroundGradientBrush}"
          IgnoreSafeArea="{OnPlatform iOS=True, Default=False}">

        <!--  Main layout — content + close button + ad  -->
        <Grid
            InputTransparent="{Binding IsPageBusy}"
            Opacity="{Binding IsPageBusy, Converter={StaticResource BusyToOpacity}}"
            RowDefinitions="Auto,*,Auto,Auto">

            <!--  Header bar  -->
            <Grid
                Grid.Row="0"
                BackgroundColor="{DynamicResource WikiAppTopPanelBackgroundColor}"
                ColumnDefinitions="*,Auto"
                Padding="16,14,16,14">
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border
                        BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                        HeightRequest="30"
                        Padding="0"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent"
                        VerticalOptions="Center"
                        WidthRequest="30">
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="&#xf091;"
                            TextColor="White"
                            VerticalTextAlignment="Center" />
                    </Border>
                    <Label
                        CharacterSpacing="1.2"
                        FontAttributes="Bold"
                        FontFamily="{DynamicResource DefaultFontFamily}"
                        FontSize="17"
                        Text="QUIZ RESULTS"
                        TextColor="{DynamicResource WikiAppTitleTextColor}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!--  Scrollable content  -->
            <syncfusion:SfListView
                Grid.Row="1"
                AutoFitMode="Height"
                BackgroundColor="Transparent"
                ItemsSource="{Binding Questions}"
                SelectionMode="None">

                <syncfusion:SfListView.HeaderTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="0,6,0,0">

                            <!--  Score chart card  -->
                            <Border
                                Margin="{OnIdiom Phone='14,8,14,0', Tablet='18,10,18,0', Default='14,8,14,0'}"
                                BackgroundColor="{DynamicResource WikiAppQuizCardBackgroundColor}"
                                HeightRequest="{OnIdiom Phone=280, Tablet=340, Default=280}"
                                Stroke="{DynamicResource WikiAppQuizCardBackgroundColor}"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow
                                        Brush="{DynamicResource WikiAppCardShadowColor}"
                                        Offset="0,3"
                                        Radius="10"
                                        Opacity="0.4" />
                                </Border.Shadow>

                                <chart:SfCircularChart BackgroundColor="Transparent">
                                    <chart:SfCircularChart.Legend>
                                        <chart:ChartLegend Placement="Bottom">
                                            <chart:ChartLegend.LabelStyle>
                                                <chart:ChartLegendLabelStyle
                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                    TextColor="{DynamicResource WikiAppQuizResultsScoreLabelTextColor}" />
                                            </chart:ChartLegend.LabelStyle>
                                        </chart:ChartLegend>
                                    </chart:SfCircularChart.Legend>
                                    <chart:SfCircularChart.Series>
                                        <chart:DoughnutSeries
                                            EnableAnimation="True"
                                            InnerRadius="0.62"
                                            ItemsSource="{Binding BindingContext.ChartPassFailData, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            PaletteBrushes="{Binding BindingContext.CustomChartColors, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            XBindingPath="Category"
                                            YBindingPath="Value">
                                            <chart:DoughnutSeries.CenterView>
                                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2" VerticalOptions="Center">
                                                    <Label
                                                        CharacterSpacing="1.5"
                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                        FontSize="{OnIdiom Phone=10, Tablet=13, Default=10}"
                                                        HorizontalTextAlignment="Center"
                                                        Opacity="0.6"
                                                        Text="SCORE"
                                                        TextColor="{DynamicResource WikiAppQuizResultsScoreLabelTextColor}" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                        FontSize="{OnIdiom Phone=26, Tablet=32, Default=26}"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding BindingContext.CorrectCountText, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        TextColor="{DynamicResource WikiAppQuizResultsScoreTextColor}" />
                                                </VerticalStackLayout>
                                            </chart:DoughnutSeries.CenterView>
                                        </chart:DoughnutSeries>
                                    </chart:SfCircularChart.Series>
                                </chart:SfCircularChart>
                            </Border>

                            <!--  Section label  -->
                            <HorizontalStackLayout
                                Margin="{OnIdiom Phone='16,14,16,4', Tablet='20,16,20,6', Default='16,14,16,4'}"
                                Spacing="8"
                                VerticalOptions="Center">
                                <BoxView
                                    BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                                    CornerRadius="2"
                                    HeightRequest="18"
                                    VerticalOptions="Center"
                                    WidthRequest="4" />
                                <Label
                                    CharacterSpacing="0.5"
                                    FontAttributes="Bold"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{OnIdiom Phone=15, Tablet=18, Default=15}"
                                    Text="Review Answers"
                                    TextColor="{DynamicResource WikiAppListItemHeaderTextColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </syncfusion:SfListView.HeaderTemplate>

                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="{OnIdiom Phone='14,0,14,8', Tablet='18,0,18,10', Default='14,0,14,8'}"
                            BackgroundColor="{DynamicResource WikiAppQuizCardBackgroundColor}"
                            Stroke="{Binding ResultAccentColor}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow
                                    Brush="{DynamicResource WikiAppCardShadowColor}"
                                    Offset="0,2"
                                    Radius="6"
                                    Opacity="0.25" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="5,36,*" ColumnSpacing="0">

                                <!--  Colored left accent bar  -->
                                <BoxView
                                    Grid.Column="0"
                                    BackgroundColor="{Binding ResultAccentColor}"
                                    CornerRadius="12,0,0,12"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />

                                <!--  Correct/incorrect icon  -->
                                <Label
                                    Grid.Column="1"
                                    FontFamily="FontAwesome"
                                    FontSize="{OnIdiom Phone=18, Tablet=22, Default=18}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding HasUserAnswered}" TargetType="Label" Value="False">
                                            <Setter Property="Text" Value="&#xf059;" />
                                            <Setter Property="TextColor" Value="{DynamicResource WikiAppQuizResultsAnswerTextColor}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCorrect}" TargetType="Label" Value="True">
                                            <Setter Property="Text" Value="&#xf058;" />
                                            <Setter Property="TextColor" Value="{DynamicResource WikiAppQuizResultsCorrectIconColor}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCorrect}" TargetType="Label" Value="False">
                                            <Setter Property="Text" Value="&#xf057;" />
                                            <Setter Property="TextColor" Value="{DynamicResource WikiAppQuizResultsIncorrectIconColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Padding="{OnIdiom Phone='0,12,14,12', Tablet='0,14,18,14', Default='0,12,14,12'}"
                                    Spacing="5">
                                    <Label
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=14, Tablet=16, Default=14}"
                                        LineBreakMode="WordWrap"
                                        LineHeight="1.35"
                                        TextColor="{DynamicResource WikiAppQuizResultsQuestionTextColor}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontAttributes="Bold" FontFamily="{DynamicResource DefaultFontFamily}" TextColor="{DynamicResource WikiAppQuizResultsQuestionTextColor}" Text="Q" />
                                                <Span FontAttributes="Bold" FontFamily="{DynamicResource DefaultFontFamily}" TextColor="{DynamicResource WikiAppQuizResultsQuestionTextColor}" Text="{Binding Id}" />
                                                <Span FontAttributes="Bold" FontFamily="{DynamicResource DefaultFontFamily}" TextColor="{DynamicResource WikiAppQuizResultsQuestionTextColor}" Text=".  " />
                                                <Span FontFamily="{DynamicResource DefaultFontFamily}" TextColor="{DynamicResource WikiAppQuizResultsQuestionTextColor}" Text="{Binding Question}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=13, Tablet=15, Default=13}"
                                        IsVisible="{Binding IsCorrect, Converter={StaticResource InvertedBoolConverter}}"
                                        LineBreakMode="WordWrap"
                                        Opacity="0.85"
                                        TextColor="{DynamicResource WikiAppQuizResultsAnswerTextColor}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontAttributes="Bold" FontFamily="{DynamicResource DefaultFontFamily}" TextColor="{DynamicResource WikiAppQuizResultsAnswerTextColor}" Text="Answer: " />
                                                <Span FontFamily="{DynamicResource DefaultFontFamily}" TextColor="{DynamicResource WikiAppQuizResultsAnswerTextColor}" Text="{Binding CorrectAnswer}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{OnIdiom Phone=12, Tablet=14, Default=12}"
                                        IsVisible="{Binding HasUserAnswered, Converter={StaticResource InvertedBoolConverter}}"
                                        Opacity="0.6"
                                        Text="Skipped"
                                        TextColor="{DynamicResource WikiAppQuizResultsAnswerTextColor}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>

            <!--  Return to menu button  -->
            <Border
                Grid.Row="2"
                Margin="14,6,14,8"
                BackgroundColor="{DynamicResource WikiAppPrimaryAccentColor}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0">
                <effects:SfEffectsView RippleAnimationDuration="250" TouchDownEffects="Ripple">
                    <effects:SfEffectsView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseQuizCommand}" />
                    </effects:SfEffectsView.GestureRecognizers>
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Padding="0,14"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="16"
                            Text="&#xf015;"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="16"
                            Text="Return to Menu"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </effects:SfEffectsView>
            </Border>

            <!--  Banner ad  -->
            <ads:BannerAdView
                Grid.Row="3"
                AdSize="Banner"
                AdUnitId="{Binding BannerAdsUnitId}"
                BannerType="Regular"
                HeightRequest="50"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />
        </Grid>

        <!--  Loading overlay  -->
        <VerticalStackLayout
            HorizontalOptions="Center"
            IsVisible="{Binding IsPageBusy}"
            Spacing="16"
            VerticalOptions="Center">
            <ActivityIndicator
                HeightRequest="52"
                IsRunning="{Binding IsPageBusy}"
                WidthRequest="52"
                Color="{DynamicResource WikiAppPrimaryAccentColor}" />
            <Label
                FontAttributes="Italic"
                FontFamily="{DynamicResource DefaultFontFamily}"
                FontSize="14"
                HorizontalTextAlignment="Center"
                Text="Analyzing Results..."
                TextColor="{DynamicResource WikiAppQuizResultsLoadingTextColor}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
