<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WikiExtractor.Maui.App.Views.QuizResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ads="clr-namespace:PjAds.Maui.Controls;assembly=PjAds.Maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:conv="clr-namespace:WikiExtractor.Maui.App.Converters"
    xmlns:effects="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="Quiz Results"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTrigger
                x:Key="IconTrigger"
                Binding="{Binding IsCorrect}"
                TargetType="Label"
                Value="True">
                <Setter Property="Text" Value="✓" />
                <Setter Property="TextColor" Value="{DynamicResource WikiAppQuizResultsCorrectIconColor}" />
            </DataTrigger>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Style="{DynamicResource WikiAppPageBackgroundGridStyle}">
        <Grid
            InputTransparent="{Binding IsPageBusy}"
            Opacity="{Binding IsPageBusy, Converter={StaticResource BusyToOpacity}}"
            RowDefinitions="Auto, *, Auto, Auto">

            <Border
                Grid.Row="0"
                BackgroundColor="{DynamicResource PopupHeaderFooterBackColor}"
                StrokeThickness="0">
                <Label
                    Padding="20"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="Quiz Summary"
                    TextColor="{DynamicResource WikiAppQuizResultsTitleTextColor}" />
            </Border>

            <syncfusion:SfListView
                Grid.Row="1"
                AutoFitMode="Height"
                BackgroundColor="Transparent"
                ItemsSource="{Binding Questions}"
                SelectionMode="None">

                <syncfusion:SfListView.HeaderTemplate>
                    <DataTemplate>
                        <VerticalStackLayout BackgroundColor="{DynamicResource PopupContentBackColor}">
                            <Border
                                Margin="12,10,12,5"
                                BackgroundColor="{DynamicResource ChartBgColor}"
                                HeightRequest="320"
                                Stroke="{DynamicResource ChartBorderColor}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">

                                <chart:SfCircularChart BackgroundColor="Transparent">
                                    <chart:SfCircularChart.Legend>
                                        <chart:ChartLegend Placement="Bottom">
                                            <chart:ChartLegend.LabelStyle>
                                                <chart:ChartLegendLabelStyle FontFamily="{DynamicResource DefaultFontFamily}" />
                                            </chart:ChartLegend.LabelStyle>
                                        </chart:ChartLegend>
                                    </chart:SfCircularChart.Legend>

                                    <chart:SfCircularChart.Series>
                                        <chart:DoughnutSeries
                                            EnableAnimation="True"
                                            InnerRadius="0.6"
                                            ItemsSource="{Binding BindingContext.ChartPassFailData, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            PaletteBrushes="{Binding BindingContext.CustomChartColors, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            XBindingPath="Category"
                                            YBindingPath="Value">

                                            <chart:DoughnutSeries.CenterView>
                                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label
                                                        FontSize="12"
                                                        HorizontalTextAlignment="Center"
                                                        Opacity="0.7"
                                                        Text="SCORE"
                                                        TextColor="{DynamicResource WikiAppQuizResultsScoreLabelTextColor}" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="24"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding BindingContext.CorrectCountText, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        TextColor="{DynamicResource WikiAppQuizResultsScoreTextColor}" />
                                                </VerticalStackLayout>
                                            </chart:DoughnutSeries.CenterView>

                                        </chart:DoughnutSeries>
                                    </chart:SfCircularChart.Series>
                                </chart:SfCircularChart>
                            </Border>
                            <Label
                                Margin="20,10,0,5"
                                FontAttributes="Bold"
                                FontSize="16"
                                Opacity="0.8"
                                Text="Review Answers"
                                TextColor="{DynamicResource WikiAppQuizResultsButtonTextColor}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </syncfusion:SfListView.HeaderTemplate>

                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="12,4"
                            Padding="15"
                            BackgroundColor="{Binding QuizUserAnswerBasedBackgroundColor}"
                            Stroke="{DynamicResource ListItemBoxBorderColor}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">

                            <Grid ColumnDefinitions="30, *">
                                <Label
                                    Grid.Column="0"
                                    Margin="0,2,0,0"
                                    FontSize="20"
                                    VerticalOptions="Start">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsCorrect}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="Text" Value="✓" />
                                            <Setter Property="TextColor" Value="{DynamicResource WikiAppQuizResultsCorrectIconColor}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsCorrect}"
                                            TargetType="Label"
                                            Value="False">
                                            <Setter Property="Text" Value="✕" />
                                            <Setter Property="TextColor" Value="{DynamicResource WikiAppQuizResultsIncorrectIconColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label LineBreakMode="WordWrap" TextColor="{DynamicResource WikiAppQuizResultsQuestionTextColor}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontAttributes="Bold" Text="Q." />
                                                <Span FontAttributes="Bold" Text="{Binding Id}" />
                                                <Span Text="  " />
                                                <Span Text="{Binding Question}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label
                                        FontSize="13"
                                        IsVisible="{Binding IsCorrect, Converter={StaticResource InvertedBoolConverter}}"
                                        Opacity="0.9"
                                        TextColor="{DynamicResource WikiAppQuizResultsAnswerTextColor}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontAttributes="Bold" Text="Correct Answer: " />
                                                <Span Text="{Binding CorrectAnswer}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>

            <Border
                Grid.Row="2"
                BackgroundColor="{DynamicResource WikiAppQuizCloseButtonBackgroundColor}"
                StrokeThickness="0"
                VerticalOptions="End">
                <effects:SfEffectsView TouchDownEffects="Ripple">
                    <effects:SfEffectsView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseQuizCommand}" />
                    </effects:SfEffectsView.GestureRecognizers>

                    <Label
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="55"
                        HorizontalTextAlignment="Center"
                        Text="Return to Menu"
                        TextColor="{DynamicResource WikiAppQuizCloseButtonTextColor}"
                        VerticalTextAlignment="Center" />
                </effects:SfEffectsView>
            </Border>

            <StackLayout
                Grid.Row="3"
                Margin="5"
                HeightRequest="50"
                HorizontalOptions="Center">
                <ads:BannerAdView
                    AdSize="Banner"
                    AdUnitId="{Binding BannerAdsUnitId}"
                    BannerType="Regular" />
            </StackLayout>
        </Grid>

        <VerticalStackLayout
            HorizontalOptions="Center"
            IsVisible="{Binding IsPageBusy}"
            Spacing="15"
            VerticalOptions="Center">

            <ActivityIndicator
                HeightRequest="60"
                IsRunning="{Binding IsPageBusy}"
                WidthRequest="60"
                Color="{DynamicResource PrimaryColor}" />

            <Label
                FontAttributes="Italic"
                HorizontalTextAlignment="Center"
                Text="Analyzing Results..."
                TextColor="{DynamicResource WikiAppQuizResultsLoadingTextColor}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>