<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SampleAutoComplete.Views.AboutPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:syncAutoComplete="clr-namespace:Syncfusion.SfAutoComplete.XForms;assembly=Syncfusion.SfAutoComplete.XForms"
    xmlns:vm="clr-namespace:SampleAutoComplete.ViewModels"
    Title="{Binding Title}">

    <ContentPage.BindingContext>
        <vm:AboutViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Accent">#96d1ff</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackLayout
            BackgroundColor="{StaticResource Accent}"
            HorizontalOptions="Fill"
            VerticalOptions="FillAndExpand">
            <StackLayout
                HorizontalOptions="Center"
                Orientation="Horizontal"
                VerticalOptions="Center">
                <ContentView Padding="0,40,0,40" VerticalOptions="FillAndExpand">
                    <Image
                        HeightRequest="64"
                        Source="xamarin_logo.png"
                        VerticalOptions="Center" />
                </ContentView>
            </StackLayout>
        </StackLayout>
        <ScrollView Grid.Row="1">
            <StackLayout
                Padding="30,24,30,24"
                Orientation="Vertical"
                Spacing="10">
                <syncAutoComplete:SfAutoComplete
                    x:Name="autoComplete"
                    Grid.Column="0"
                    Margin="5,3,0,0"
                    AutoCompleteMode="Suggest"
                    BackgroundColor="Red"
                    ClearButtonColor="Wheat"
                    Completed="autoComplete_Completed"
                    DataSource="{Binding AutocompleteList}"
                    DisplayMemberPath="Name"
                    DropDownBackgroundColor="Pink"
                    DropDownBorderColor="Pink"
                    DropDownTextColor="Brown"
                    
                    HighlightedTextColor="Green"
                    HighlightedTextFontAttributes="Bold"
                    IgnoreDiacritic="False"
                    IsEnabled="True"
                    
                    NoResultsFoundText="No Results Found"
                    NoResultsFoundTextColor="Blue"
                    SelectionChanged="autoComplete_SelectionChanged"
                    ShowBorder="False"
                    ShowClearButton="True"
                    SuggestionMode="Contains"
                    TextColor="Black"
                    TextHighlightMode="MultipleOccurrence"
                    ValueChanged="autoComplete_ValueChanged"
                    Watermark="Enter here to search"
                    WatermarkColor="DarkCyan" />

                <Label FontSize="Body" Text="{Binding SelectedValue}" />
                <Label FontSize="Body" Text="{Binding SelectedName}" />
                <Label
                    Padding="0,0,0,0"
                    FontSize="16"
                    Text="Make changes to your XAML file and save to see your UI update in the running app with XAML Hot Reload. Give it a try!" />
                <Label Padding="0,24,0,0" FontSize="16">
                    <Label.FormattedText>
                        <FormattedString>
                            <FormattedString.Spans>
                                <Span Text="Learn more at " />
                                <Span FontAttributes="Bold" Text="https://aka.ms/xamarin-quickstart" />
                            </FormattedString.Spans>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Button
                    Margin="0,10,0,0"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding OpenWebCommand}"
                    Text="Learn more"
                    TextColor="White" />
            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

