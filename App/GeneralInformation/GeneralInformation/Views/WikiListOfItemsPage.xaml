<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.XForms.EffectsView;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusionList="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:syncAutoComplete="clr-namespace:Syncfusion.SfAutoComplete.XForms;assembly=Syncfusion.SfAutoComplete.XForms"
             x:Class="GeneralInformation.Views.WikiListOfItemsPage">
    <ContentPage.Content>
        <StackLayout Orientation="Vertical" Padding="5" Spacing="10">
            <syncAutoComplete:SfAutoComplete x:Name="autoComplete" DataSource="{Binding AutocompleteList}"  DisplayMemberPath="Name"
                                     HeightRequest="40"
                                     TextHighlightMode="MultipleOccurrence"
                                     IgnoreDiacritic="False"
                                     SuggestionMode="Contains"
                                     AutoCompleteMode="Suggest"
                                                 HighlightedTextColor="Red"
                                                 HighlightedTextFontAttributes="Bold"
                                                 MaximumSuggestion="10"
                                                 LoadMoreText="More Options"
                                                 NoResultsFoundText="No Results Found"
                                                 SelectionChanged="autoComplete_SelectionChanged"
                                                 />
            <syncfusionList:SfListView x:Name="lstSaints" 
                                           BackgroundColor="DarkSeaGreen"
                                ItemsSource="{Binding Personas}" 
                                       SelectionChanged="lstSaints_SelectionChanged"
                                AllowSwiping="True" AutoFitMode="DynamicHeight">
                <syncfusionList:SfListView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="Green" Padding="1" 
                                   Margin="2,2,2,2"
                                   HasShadow="{OnPlatform Android=true, iOS=false, UWP=true, WPF=true}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.35*, Tablet=0.25*}, iOS={OnIdiom Phone=0.35*, Tablet=0.15*}, UWP={OnIdiom Desktop=auto, Phone=auto, Tablet=0.55*}, macOS=0.15*, WPF=auto}" />
                                    <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.65*, Tablet=0.75*}, iOS={OnIdiom Phone=0.65*, Tablet=0.85*}, UWP={OnIdiom Desktop=*, Phone=*, Tablet=0.15*}, macOS=*, WPF=*}" />
                                </Grid.ColumnDefinitions>

                                <Image Source="{Binding PicturePrimaryPath}" HorizontalOptions="FillAndExpand" 
                                           VerticalOptions="FillAndExpand" HeightRequest="130" WidthRequest="120" Aspect="AspectFit"/>

                                <StackLayout Grid.Column="1" Padding="10,0,0,0">
                                    <StackLayout.VerticalOptions>
                                        <OnPlatform x:TypeArguments="LayoutOptions">
                                            <On Platform="macOS" Value="CenterAndExpand"/>
                                        </OnPlatform>
                                    </StackLayout.VerticalOptions>
                                    <Label Text="{Binding Name}" TextColor="Black" LineBreakMode="WordWrap" FontAttributes="Bold"
                                           FontSize="{OnPlatform Android={OnIdiom Phone=18, Tablet=22}, iOS={OnIdiom Phone=18, Tablet=22}, UWP={OnIdiom Phone=16, Tablet=26, Desktop=26}, macOS=22, WPF=26}" />
                                    <Label Grid.Row="1" TextColor="Black" LineBreakMode="WordWrap" MaxLines="3" Text="{Binding MainContent}"
                                           FontSize="{OnPlatform Android={OnIdiom Phone=11, Tablet=13}, iOS={OnIdiom Phone=11, Tablet=13}, UWP={OnIdiom Phone=10, Tablet=14, Desktop=16}, macOS=13, WPF=16}" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </syncfusionList:SfListView.ItemTemplate>
            </syncfusionList:SfListView>
            <syncEffectsView:SfEffectsView>
                <buttons:SfButton x:Name="btnTabDefinitionsHeader" 
                                              Text="Definitions"
                                              BackgroundColor="Orange">

                </buttons:SfButton>
            </syncEffectsView:SfEffectsView>
            <Label Text="Start developing now" FontSize="Title"/>
            <Label Text="Make changes to your XAML file and save to see your UI update in the running app with XAML Hot Reload. Give it a try!" FontSize="16" Padding="0,0,0,0"/>
            <Label FontSize="16" Padding="0,24,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <FormattedString.Spans>
                            <Span Text="Learn more at "/>
                            <Span Text="https://aka.ms/xamarin-quickstart" FontAttributes="Bold"/>
                        </FormattedString.Spans>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button Margin="0,10,0,0" Text="Learn more"
                        Command="{Binding OpenWebCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>