<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusionList="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:sfEffectsView="clr-namespace:Syncfusion.XForms.EffectsView;assembly=Syncfusion.Core.XForms"
             xmlns:sfBorder="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    	     xmlns:sfGradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
             xmlns:syncAutoComplete="clr-namespace:Syncfusion.SfAutoComplete.XForms;assembly=Syncfusion.SfAutoComplete.XForms"
             xmlns:sfBusyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:admob="clr-namespace:MarcTron.Plugin.Controls;assembly=Plugin.MtAdmob"
             x:Class="GeneralInformation.Views.WikiListOfItemsPage"
             Shell.NavBarIsVisible="True" Title="{Binding Title}">
    <ContentPage.Content>
        <StackLayout Orientation="Vertical" Padding="5" Spacing="10" BackgroundColor="{AppThemeBinding 
                                      Dark={StaticResource BackgroundDark}, Light={StaticResource BackgroundLight}}">
            <syncAutoComplete:SfAutoComplete x:Name="autoComplete" DataSource="{Binding AutocompleteList}"  
                                             DisplayMemberPath="Name"
                                             HeightRequest="40"
                                             TextHighlightMode="MultipleOccurrence"
                                             Watermark="Enter here to search"
                                             IgnoreDiacritic="False"
                                             SuggestionMode="Contains"
                                             AutoCompleteMode="Suggest"
                                             ShowBorder="False"
                                             WatermarkColor="{AppThemeBinding Dark={StaticResource SearchTextWatermarkTextForeDark}, Light={StaticResource SearchTextWatermarkTextForeLight}}"
                                             BackgroundColor="{AppThemeBinding Dark={StaticResource SearchTextDropBackDark}, Light={StaticResource SearchTextDropBackLight}}"
                                             DropDownBackgroundColor="{AppThemeBinding Dark={StaticResource SearchTextDropBackDark}, Light={StaticResource SearchTextDropBackLight}}"
                                             HighlightedTextColor="{AppThemeBinding Dark={StaticResource SearchTextDropHighlightBackDark}, Light={StaticResource SearchTextDropHighlightBackLight}}"
                                             TextColor="{AppThemeBinding Dark={StaticResource TextForeDark}, Light={StaticResource TextForeLight}}"
                                             DropDownTextColor="{AppThemeBinding Dark={StaticResource TextForeDark}, Light={StaticResource TextForeLight}}"
                                             HighlightedTextFontAttributes="Bold"
                                             ClearButtonColor="{AppThemeBinding Dark={StaticResource TextForeDark}, Light={StaticResource TextForeLight}}"
                                             NoResultsFoundTextColor="{AppThemeBinding Dark={StaticResource TextForeDark}, Light={StaticResource TextForeLight}}"
                                             
                                             NoResultsFoundText="No Results Found"
                                             SelectionChanged="autoComplete_SelectionChanged"
                                             Completed="autoComplete_Completed"
                                             ShowClearButton="True"
                                             />
            <!--MaximumSuggestion="10" LoadMoreText=" Tap to load"-->
            <syncfusionList:SfListView x:Name="lstSaints" 
                                       BackgroundColor="Transparent"
                                       SelectionMode="None"
                                       ItemsSource="{Binding Personas}" 
                                       AllowSwiping="True" AutoFitMode="DynamicHeight">
                <syncfusionList:SfListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <sfEffectsView:SfEffectsView x:Name="lstItemEffectsView" TouchDownEffects="Ripple" WidthRequest="344" 
												Margin="0,0,0,10" CornerRadius="5" RippleAnimationDuration="300"
                                                AutomationId="{Binding Id}"
                                                AnimationCompleted="lstItemEffectsView_AnimationCompleted">
                                <sfEffectsView:SfEffectsView.HeightRequest>
                                    <OnIdiom x:TypeArguments="x:Double" Desktop="128" Tablet="128" Phone="148"/>
                                </sfEffectsView:SfEffectsView.HeightRequest>

                                <Grid >
                                    <sfGradient:SfGradientView >
                                        <sfGradient:SfGradientView.BackgroundBrush>
                                            <sfGradient:SfLinearGradientBrush>
                                                <sfGradient:SfLinearGradientBrush.GradientStops>
                                                    <sfGradient:SfGradientStop Color="{AppThemeBinding Dark={StaticResource EachItemBackGradientStartDark}, Light={StaticResource EachItemBackGradientStartLight}}" Offset="0.0" />
                                                    <sfGradient:SfGradientStop Color="{AppThemeBinding Dark={StaticResource EachItemBackGradientEndDark}, Light={StaticResource EachItemBackGradientEndLight}}" Offset="1" />
                                                </sfGradient:SfLinearGradientBrush.GradientStops>
                                            </sfGradient:SfLinearGradientBrush>
                                        </sfGradient:SfGradientView.BackgroundBrush>
                                    </sfGradient:SfGradientView>
                                    <sfBorder:SfBorder BackgroundColor="Transparent" BorderColor="Transparent" 
											   BorderWidth="0" VerticalOptions="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.35*, Tablet=0.15*}, iOS={OnIdiom Phone=0.35*, Tablet=0.15*}, UWP={OnIdiom Desktop=auto, Phone=auto, Tablet=0.55*}, macOS=0.15*, WPF=auto}" />
                                                <ColumnDefinition Width="{OnPlatform Android={OnIdiom Phone=0.65*, Tablet=0.85*}, iOS={OnIdiom Phone=0.65*, Tablet=0.85*}, UWP={OnIdiom Desktop=*, Phone=*, Tablet=0.15*}, macOS=*, WPF=*}" />
                                            </Grid.ColumnDefinitions>


                                            <!--<StackLayout Grid.Column="0">-->
                                            <!--<sfBorder:SfBorder BorderColor="#909497" BorderThickness="1" CornerRadius="2">-->
                                            <!--<Frame BorderColor="Black" BackgroundColor="Transparent" >-->
                                            <Image x:Name="imgList" Source="{Binding PicturePrimaryPath}" Margin="5,0,0,0"
                                                   HorizontalOptions="FillAndExpand" 
                                                   VerticalOptions="FillAndExpand" 
                                                       HeightRequest="130" WidthRequest="120" Aspect="AspectFit"/>
                                            <!--</Frame>-->
                                            <ActivityIndicator BindingContext="{x:Reference imgList}" IsRunning="{Binding IsLoading}" />
                                            <!--<sfBusyindicator:SfBusyIndicator x:Name="busyindicator" AnimationType="Globe" 
                                                                                 ViewBoxWidth = "40" 
                                                                                 ViewBoxHeight="40" 
                                                                                 BindingContext="{x:Reference imgList}"
                                                                                 IsBusy="{Binding IsLoading}"/>-->
                                            <!--</sfBorder:SfBorder>-->
                                            <!--</StackLayout>-->

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="0.2*" />
                                                </Grid.RowDefinitions>

                                                <StackLayout Grid.Row="0" Padding="10,0,0,0">
                                                    <StackLayout.VerticalOptions>
                                                        <OnPlatform x:TypeArguments="LayoutOptions">
                                                            <On Platform="macOS" Value="CenterAndExpand"/>
                                                        </OnPlatform>
                                                    </StackLayout.VerticalOptions>
                                                    <Label Text="{Binding Name}" 
                                                       TextColor="{AppThemeBinding Dark={StaticResource TextForeDark}, Light={StaticResource TextForeLight}}" 
                                                       LineBreakMode="WordWrap" FontAttributes="Bold"
                                                       Padding="0,0,3,0"
                                                       FontFamily="OpenSans"
                                                       FontSize="{OnPlatform Android={OnIdiom Phone=18, Tablet=22}, iOS={OnIdiom Phone=18, Tablet=22}, UWP={OnIdiom Phone=16, Tablet=26, Desktop=26}, macOS=22, WPF=26}" />
                                                    <Label Grid.Row="1" TextColor="{AppThemeBinding Dark={StaticResource TextForeDark}, Light={StaticResource TextForeLight}}" 
                                                       LineBreakMode="WordWrap" MaxLines="4" 
                                                       Padding="0,0,3,0" 
                                                       Text="{Binding MainContent}" 
                                                       FontSize="{OnPlatform Android={OnIdiom Phone=12, Tablet=16}, iOS={OnIdiom Phone=11, Tablet=16}, UWP={OnIdiom Phone=10, Tablet=14, Desktop=16}, macOS=13, WPF=16}" />
                                                </StackLayout>
                                                <Label Grid.Row="1" IsVisible="false"
                                                       Margin="0,0,8,0"
                                                       TextDecorations="Underline"
                                                       FontSize="{OnPlatform Android={OnIdiom Phone=10, Tablet=12}, iOS={OnIdiom Phone=10, Tablet=16}, UWP={OnIdiom Phone=10, Tablet=14, Desktop=16}, macOS=13, WPF=16}"
                                                       VerticalOptions="CenterAndExpand"
                                                       HorizontalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="WikiLink">
                                                                <Span.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TapHyperLinkToWikiPage}" 
                                                                                          CommandParameter="{Binding WikiPath}"/>
                                                                    <!--Command="{Binding Path=BindingContext.TapHyperLinkToWikiPage, Source={x:Reference lstSaints}}" CommandParameter="{x:Reference WikiPath}" />-->
                                                                </Span.GestureRecognizers>
                                                            </Span>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Grid>

                                        </Grid>
                                    </sfBorder:SfBorder>
                                </Grid>
                            </sfEffectsView:SfEffectsView>
                        </ViewCell>
                    </DataTemplate>
                </syncfusionList:SfListView.ItemTemplate>
            </syncfusionList:SfListView>
            <admob:MTAdView AdsId="{Binding AdsBannerId}" HeightRequest="{OnPlatform Android={OnIdiom Phone=50, Tablet=90}, iOS={OnIdiom Phone=50, Tablet=90}, UWP={OnIdiom Phone=50, Tablet=90, Desktop=90}, macOS=90, WPF=90}" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>